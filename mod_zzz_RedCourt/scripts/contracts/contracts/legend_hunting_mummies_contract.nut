this.legend_hunting_mummies_contract <- this.inherit("scripts/contracts/contract", {
	m = {
		Target = null,
		Dude = null,
		IsPlayerAttacking = false
	},
	function create()
	{
		this.contract.create();
		this.m.Type = "contract.hunting_mummies";
        this.m.Name = "Древние мертвецы";
        this.m.TimeOut = this.Time.getVirtualTimeF() + this.World.getTime().SecondsPerDay * 7.0;
	}

	function onImportIntro()
	{
		this.importSettlementIntro();
	}

	function start()
	{
		this.m.Payment.Pool = 600 * this.getPaymentMult() * this.Math.pow(this.getDifficultyMult(), this.Const.World.Assets.ContractRewardPOW) * this.getReputationToPaymentMult();

		if (this.Math.rand(1, 100) <= 33)
		{
			this.m.Payment.Completion = 0.75;
			this.m.Payment.Advance = 0.25;
		}
		else
		{
			this.m.Payment.Completion = 1.0;
		}

		this.contract.start();
	}

	function createStates()
	{
		this.m.States.push({
			ID = "Offer",
			function start()
			{
				this.Contract.m.BulletpointsObjectives = [
					"Охота на мертвецов, что бродят по пустыне около города " + this.Contract.m.Home.getName()
				];
				this.Contract.setScreen("Task");
			}

			function end()
			{
				this.World.Assets.addMoney(this.Contract.m.Payment.getInAdvance());
				local r = this.Math.rand(1, 100);

				this.Flags.set("StartTime", this.Time.getVirtualTimeF());
				this.Contract.spawnEnemies();
				this.Contract.m.Home.setLastSpawnTimeToNow();
				this.Contract.setScreen("Overview");
				this.World.Contracts.setActiveContract(this.Contract);
			}

		});
		this.m.States.push({
			ID = "Running",
			function start()
			{
				if (this.Contract.m.Target != null && !this.Contract.m.Target.isNull())
				{
					this.Contract.m.Target.getSprite("selection").Visible = true;
					this.Contract.m.Target.setOnCombatWithPlayerCallback(this.onTargetAttacked.bindenv(this));
				}
			}

			function update()
			{
				if (this.Contract.m.Target == null || this.Contract.m.Target.isNull() || !this.Contract.m.Target.isAlive())
				{
					this.Contract.setScreen("Victory");
					this.World.Contracts.showActiveContract();
					this.Contract.setState("Return");
				}
				else if (!this.Flags.get("IsBanterShown") && this.Contract.m.Target.isHiddenToPlayer() && this.Math.rand(1, 1000) <= 1 && this.Flags.get("StartTime") + 10.0 <= this.Time.getVirtualTimeF())
				{
					local tileType = this.World.State.getPlayer().getTile().Type;

					if (tileType == this.Const.World.TerrainType.Desert)
					{
						this.Flags.set("IsBanterShown", true);
						this.Contract.setScreen("Banter");
						this.World.Contracts.showActiveContract();
					}
				}
			}

			function onTargetAttacked( _dest, _isPlayerAttacking )
			{

				if (!this.Flags.get("IsEncounterShown"))
				{
					this.Flags.set("IsEncounterShown", true);
					this.Contract.setScreen("Encounter");
					this.World.Contracts.showActiveContract();
				}
				else
				{
					this.World.Contracts.showCombatDialog(_isPlayerAttacking);
				}
			}

		});
		this.m.States.push({
			ID = "Return",
			function start()
			{
				this.Contract.m.BulletpointsObjectives = [
					"Вернитесь в " + this.Contract.m.Home.getName()
				];
				this.Contract.m.Home.getSprite("selection").Visible = true;
			}

			function update()
			{
				if (this.Contract.isPlayerAt(this.Contract.m.Home))
				{
					this.Contract.setScreen("Success");
					this.World.Contracts.showActiveContract();
				}
			}

		});
	}

	function createScreens()
	{
		this.importScreens(this.Const.Contracts.NegotiationDefault);
		this.importScreens(this.Const.Contracts.Overview);
		this.m.Screens.push({
			ID = "Task",
			Title = "Переговоры",
			Text = "[img]gfx/ui/events/event_162.png[/img]{%employer% восседает за новеньким столом - каждая грань искусно вырезана вручную, углы инкрустированы золотом и мелкими самоцветами. Однако на поверхности стола лежит нечто, совершенно не вписывающееся в эту роскошь - отрубленная рука, грубо отсечённая в локте, безжизненно свешивается с края роскошной столешницы.\n %employer% окружён зеваками, которые тыкают в конечность, словно дети палкой в мёртвую собаку. Один из слуг касается плеча визиря, и тот мгновенно приходит в себя, стараясь не подавать виду, что его тревожит гниющее мясо, уже растёкшееся сукровицей по всему столу.%SPEECH_ON%Ну что, алчущий крон, сегодня у меня для тебя кое-что особенное. В пустыне видели плотоядных мертвецов - они нападают на мои земли и моих слуг. В наших краях это редкость, и я считаю, что с этим нужно разобраться немедленно.%SPEECH_OFF%\n %employer% складывает пальцы домиком и откидывается на спинку кресла - возможно, чтобы оказаться как можно дальше от зловония стремительно разлагающейся руки. Он кашляет и подаёт знак слуге. Слуга прочищает горло и переводит дух.%SPEECH_ON%По поручению...%SPEECH_OFF% Он замолкает, надрывно кашляя, и отступает на пару шагов от руки, пока стражник осторожно накалывает её на копьё и уносит на вытянутых руках прочь.\n Слуга берёт себя в руки и решает опустить формальности.%SPEECH_ON%...вас ожидает награда в %reward% крон.%SPEECH_OFF% | %employer% стоит у распахнутого окна своих покоев, обмахиваясь веером из страусиных перьев, и старается не смотреть на серебряный поднос у его ног - на нём лежит рука, потемневшая и вздутая, ногти всё ещё украшены медными кольцами.\n Несколько купцов, приглашённых на утренний приём, столпились вокруг подноса, зажимая носы надушенными платками; один из них, побледнев, поспешно опускается на подушки, чтобы не упасть. %employer% наконец оборачивается к вам, стараясь выглядеть невозмутимым.%SPEECH_ON%А, вот и ты, алчущий крон. В пустыне завелись мертвецы - не обычная нежить, а нечто, что ест плоть живых. Они уже добрались до моих караванов - и, как видишь, теперь отравляют мне даже приём для гостей.%SPEECH_OFF%\n Он щёлкает пальцами, подзывая писца, который до этого пытался спрятаться за колонной. Писец подходит, разворачивает свиток и начинает читать срывающимся голосом.%SPEECH_ON%По велению досточтимого...%SPEECH_OFF% Он замолкает на полуслове, покосившись на поднос, где рука вдруг соскальзывает набок - должно быть, от сквозняка из окна, - и торопливо кивает стражнику, чтобы тот унёс её подальше.\n Не дожидаясь, пока писец найдёт в себе силы продолжить, %employer% сам заканчивает мысль.%SPEECH_ON%Довольно церемоний. Убей их всех, и получишь %reward% крон.%SPEECH_OFF% | %employer% восседает во главе длинного пиршественного стола, уставленного блюдами с финиками, жареной бараниной и пряным пловом. Между блюдами, на серебряном подносе, лежит рука - синюшная, с обрубленными по локоть костями, торчащими наружу.\n Гости за столом давно перестали притворяться, что едят: кто-то отставил тарелку, кто-то демонстративно закрыл лицо шёлковым платком. %employer% единственный, кто не двинулся с места, хотя костяшки его пальцев, сжимающих кубок, побелели.%SPEECH_ON%Полюбуйся, алчущий крон. Это принесли из пустыни мои слуги - то немногое, что осталось от гонца, отправленного на север. Мертвецы, что жрут живую плоть, бродят по моим землям, и я хочу, чтобы их больше не было.%SPEECH_OFF%\n Он делает знак глашатаю, стоящему у входа. Тот выходит вперёд, откашливается и начинает зачитывать указ громким, поставленным голосом.%SPEECH_ON%Настоящим повелевается...%SPEECH_OFF% Голос глашатая срывается на полуслове, когда один из гостей вскакивает и, зажав рот рукой, выбегает вон - судя по звукам из коридора, далеко он не убежал.\n Дождавшись, пока за беднягой захлопнется дверь, %employer% лишь качает головой и договаривает сам.%SPEECH_ON%Дюжина мертвецов, не больше. Приведи мне доказательство, что все они мертвы окончательно, и получишь %reward% крон.%SPEECH_OFF% | %employer% сидит один в полутёмном кабинете, наклонившись над низким столиком, на котором лежит рука - не столько отрубленная, сколько оторванная, с рваными краями плоти и торчащими наружу сухожилиями. Он тычет в неё концом трости, будто не до конца верит, что она настоящая.\n Заслышав ваши шаги, он резко выпрямляется, словно его застали за чем-то постыдным, и знаком велит слуге закрыть находку скатертью.%SPEECH_ON%Садись, алчущий крон, раз уж пришёл. В пустыне объявились мертвецы, которые едят живых - не просто бродят, а именно едят. Эту руку нашли мои погонщики верблюдов. От самих погонщиков не нашли уже ничего.%SPEECH_OFF%\n Он подзывает писца от двери - тот входит с явной неохотой, стараясь не смотреть в сторону стола, и начинает читать заранее заготовленный указ.%SPEECH_ON%По воле досточтимого визиря...%SPEECH_OFF% Писец умолкает, когда скатерть на столе шевелится - вероятно, от сквозняка, - и он отступает к двери, дальше от неё дочитывая по памяти, торопливо и невнятно.\n %employer% раздражённо машет рукой, отпуская его, и договаривает сам, без прикрас.%SPEECH_ON%Прекрати это безобразие в пустыне, и я заплачу тебе %reward% крон.%SPEECH_OFF%}",
			Image = "",
			List = [],
			ShowEmployer = true,
			ShowDifficulty = true,
			Options = [
				{
					Text = "{Я заинтересован, продолжай. | Охота на такого врага дёшево не обойдётся. | Это будет стоить тебе недешево. | Охотиться на мертвецов в пустыне. Что тут может не нравиться. | \'%companyname%\' может помочь, за достойную плату.}",
					function getResult()
					{
						return "Negotiation";
					}

				},
				{
					Text = "{Это не похоже на нашу работу. | Я не поведу людей в погоню за призраками по пустыне. | Вряд ли. | Я говорю нет. Наши люди предпочитают знакомых врагов из плоти и крови.}",
					function getResult()
					{
						this.World.Contracts.removeContract(this.Contract);
						return 0;
					}

				}
			],
			function start()
			{
			}

		});
		this.m.Screens.push({
			ID = "Banter",
			Title = "По пути..."
			Text = "[img]gfx/ui/events/event_161.png[/img]{Идя по следам в песках, вы наткнулись на другую цепочку следов - более хаотичную, чем прежняя, - и она привела вас к полудюжине древних зданий из сырцового кирпича и сухих деревянных балок.\n\n Эти постройки стояли здесь уже давно и явно были заброшены. Судя по обугленным фундаментам вокруг, когда-то здесь стояло небольшое поселение - теперь от него остались только следы старого пожара. Вдалеке вы услышали громкий вой - то ли призрачный, то ли похожий на плач дюжины детей.\n\n Приблизившись, вы заметили конскрипта, всего в крови, бормочущего что-то нечленораздельное. Он всё ещё носит рваный доспех и сжимает копьё так, будто оно одно удерживает его от падения с высокой стены. Заметив ваше присутствие, человек вскочил на ноги и ударился головой о крышу силосной башни. Вскрикнув от боли, он выкатился из проёма, умоляя оставить его в покое, но, не дождавшись ответа, тут же, охваченный паникой, бросился на вас с копьём - вы ловко увернулись от неуклюжего выпада и толкнули его. С громким хрустом он врезался головой в опору силосной башни - смерть наступила мгновенно.\n\n Время уходит впустую, а песок уже заметает более важные следы. Вы сооружаете над телом грубый курган у подножия древних хранилищ и двигаетесь дальше.\n\n Молчаливые монолиты из сырцового кирпича безучастно смотрят вам вслед - им, похоже, нет дела ни до смерти конскрипта, ни до вашего ухода. | Следуя за отпечатками на песке, вы замечаете, что часть следов внезапно сворачивает в сторону, уводя от общей цепочки к полуразрушенному караван-сараю, чьи стены давно превратились в оплывшие холмы глины.\n\n Ворота караван-сарая сорваны с петель, а внутренний двор завален обломками телег и рассыпавшимися тюками - судя по всему, здесь когда-то остановился караван, которому не суждено было двинуться дальше. Из-за одной из стен доносится приглушённое бормотание.\n\n Обогнув угол, вы находите караванного стражника - он сидит у воткнутого в землю факела, прислонившись спиной к стене, и методично водит ножом по камню, будто пытается что-то нацарапать, но давно потерял счёт попыткам. Завидев вас, он вскакивает так резко, что роняет нож себе на ногу, взвывает, хватает факел и начинает скакать на одной ноге, размахивая им.\n\n Не удержав равновесия, он опрокидывает бочку с ламповым маслом, поскальзывается на разлившейся луже и падает прямо на собственный факел. Пламя охватывает его почти мгновенно - вы едва успеваете отступить назад, чтобы не загореться вместе с ним.\n\n Дождавшись, пока огонь угаснет, вы наскоро закапываете обугленные останки среди руин, после чего долго кружите среди песчаных дюн, прежде чем находите первоначальный след - теперь едва различимый. | Пока вы идёте по следу, вы замечаете вторую цепочку отпечатков, петляющую в стороне от основной, - она ведёт к полузасыпанному песком колодцу и остаткам каменной ограды вокруг него.\n\n Судя по всему, здесь когда-то был небольшой оазис - сейчас от него осталась лишь сухая яма колодца и несколько почерневших пальмовых стволов. Ветер приносит слабый, но настойчивый звон - будто где-то неподалёку раскачивается пустой колокольчик.\n\n У края колодца вы находите торговца в некогда богатых одеждах - теперь изодранных и покрытых пятнами. Он что-то бормочет себе под нос, перебирая пустой кошелёк, будто пересчитывая монеты, которых там давно нет. Заметив вас, он вскрикивает и шарахается назад, к самому краю колодца.\n\n Осыпавшийся край не выдерживает его веса. Раздаётся крик, глухой удар о стенки колодца - и тишина. Заглянув вниз, вы понимаете, что помощь торговцу уже не нужна.\n\n Вы теряете время, разглядывая тёмный провал колодца, а след тем временем становится всё слабее. Быстро осмотрев то, что осталось от лагеря торговца, вы отправляетесь дальше.\n\n Обвалившиеся камни старой ограды и иссохшие стволы мёртвых пальм остаются позади - такие же безмолвные, как и всё, что когда-то пыталось здесь жить. | Идя по следу, вы натыкаетесь на другую цепочку следов, ведущую прочь от основного следа - она приводит вас к остову старой сторожевой башни, до половины занесённой песком.\n\n Верхний ярус башни давно обрушился, оставив после себя нагромождение битого кирпича и покосившиеся балки. Где-то среди обломков блеет одинокая коза - звук, совершенно неуместный в этой тишине.\n\n Внутри руин вы находите пастуха - исхудавшего, с обожжённой солнцем кожей, сжимающего в руках пастуший посох так, будто это последнее, что у него осталось. Завидев вас, он с криком бросается вверх по шаткой лестнице, ведущей на уцелевший балкон.\n\n Балкон не выдерживает его веса и с треском обрушивается вместе с ним и половиной стены. Пыль оседает не сразу - когда она наконец рассеивается, становится ясно, что подниматься наверх, чтобы проверить беглеца, уже незачем.\n\n Разбирать завал ради того, что осталось от пастуха, - только терять время, которого и так мало. След остывает с каждой минутой, и вы, оставив его под обломками, спешите дальше.\n\n Полуразрушенная башня безмолвно оседает у вас за спиной, роняя последние камни в песок.}",
			Image = "",
			List = [],
			Options = [
				{
					Text = "Проклятье, мы упускаем их! Шевелитесь!",
					function getResult()
					{
						return 0;
					}

				}
			]
		});
		this.m.Screens.push({
			ID = "Encounter",
			Title = "При приближении..."
			Text = "[img]gfx/ui/events/event_153.png[/img]{После долгого пути вы наконец добрались до группы нежити, за которой следовали по следам. Как ни странно, мертвецы, покрытые сияющим золотом и бронзой, бесцельно кружатся у подножия дюны. Они, похоже, отвлеклись на что-то поблизости или сбились с пути задолго до вашего появления.\n\n Тревожное чувство закрадывается в вашу душу, когда один за другим мертвецы выстраиваются в боевую линию. Теперь неподвижные и внимательные, они стоят наготове - их мантии, слишком просторные для иссохших тел, колышутся на ветру, а серьги и прочие украшения свободно болтаются на высохшей коже.\n\n Наиболее богато украшенный труп издаёт протяжный, полный скорби вой - и колонна из высушенной кожи и золота начинает наступление. | Вы много часов шли по следу и наконец настигли группу нежити на разломе пересохшего русла. Тела мертвецов с ног до головы увешаны драгоценностями - тяжёлые ожерелья из лазурита и меди, перстни на каждом пальце, а истлевшая кожа вокруг глазниц всё ещё хранит следы чёрной сурьмы.\n\n Некоторое время они просто бродят взад и вперёд без всякой цели, будто позабыв, зачем вообще восстали из мёртвых. То и дело останавливаясь у примятого песка, будто когда-то шли по чужому следу и давно его потеряли.\n\n Внезапно все звуки стихают. Мертвецы один за другим замирают и медленно поворачиваются в вашу сторону, а затем выстраиваются плотной шеренгой - молча, без единого звука, будто повинуясь приказу, которого не слышал никто, кроме них самих.\n\n Тишину разрывает пронзительный скрежещущий крик - и вся вереница расшитых золотом лохмотьев и натянутой кожи срывается в атаку. | После долгой погони вы наконец нагоняете мертвецов у подножия каменистого гребня. Каждое тело плотно обёрнуто позолоченными погребальными пеленами, а поверх - маски из полированной бронзы, скрывающие то, что осталось от лиц.\n\n Мертвецы бестолково толкутся на месте, натыкаясь друг на друга, словно потерявшие дорогу слепцы. Судя по всему, они преследовали что-то ещё до встречи с вами - но давно потеряли след и не нашли ему замены.\n\n Порыв ветра проносится между ними, и вдруг всё меняется: тела замирают разом, будто по команде, и медленно разворачиваются к вам, выстраиваясь в ровный полукруг.\n\n Один из мертвецов запрокидывает голову назад настолько, что маска соскальзывает с лица, - и в тот же миг вся шеренга золочёных пелен и полированной бронзы бросается вперёд. | Вы выслеживаете нежить не один час и наконец находите её у россыпи камней на краю пустыни. Издалека тела выглядят почти нарядно - многослойные шёлковые ткани, давно выцветшие и рваные, всё ещё держатся на костях, а на руках и щиколотках позвякивают десятки медных браслетов.\n\n Некоторое время вы просто наблюдаете: мертвецы бродят без всякого порядка, то и дело останавливаясь и снова начиная движение, будто разучились ходить по прямой. Что-то явно сбило их с изначального пути задолго до вашего прибытия.\n\n Стоит вам подойти ближе, как беспорядочное блуждание обрывается. Все разом поднимают руки - и так же слаженно опускают их, разворачиваясь в вашу сторону единым строем.\n\n Тишину разрывает нестройный, многоголосый стон - и шеренга шёлка, меди и золота с шелестом приходит в движение, надвигаясь на вас.}",
			Image = "",
			List = [],
			Options = [
				{
					Text = "К оружию!",
					function getResult()
					{
						this.Contract.getActiveState().onTargetAttacked(this.Contract.m.Target, this.Contract.m.IsPlayerAttacking);
						return 0;
					}

				}
			]
		});
		this.m.Screens.push({
			ID = "Victory",
			Title = "После битвы...",
			Text = "[img]gfx/ui/events/event_160.png[/img]{Когда пал последний из забальзамированных мумий, его украшения со звоном посыпались в песок. Вас охватило тошнотворное чувство - словно вы не спали месяцами или не пили воды несколько дней. Кожа стала тоньше, а кости, казалось, скрипели и расходились одна от другой. Спустя несколько мгновений это ощущение прошло, и силы вернулись к вам.\n\n Теперь ваша забота - дюжина с лишним тел, усеявших поле битвы. Визирь требовал доказательств, и вы предоставите нечто большее, чем просто отрубленная рука: несколькими точными ударами вы отсекаете голову самого богато украшенного мертвеца вместе с головным убором.\n Прикрепив её к поясу, вы готовы отправиться в долгий путь - но не раньше, чем прихватите часть украшений, мёртвым они больше не нужны. | Когда рассыпалась в пыль последняя мумия, по полю боя пробежал порыв ледяного холода, хотя воздух вокруг оставался неподвижным и раскалённым от солнца. На мгновение вам показалось, что кровь в жилах превращается в лёд, а суставы деревенеют, будто вы простояли на морозе всю ночь. Ощущение отступает так же внезапно, как и появилось.\n\n Вокруг вас - не один десяток забальзамированных тел, усыпавших песок. Визирю понадобится доказательство повесомее, чем какая-то оторванная рука. Вы находите труп в самом богатом убранстве - с золотым венцом, усаженным помутневшими от времени камнями, - и одним точным ударом отсекаете ему голову.\n\nЗа неимением мешка вы скручиваете жгут из истлевших погребальных пелен и крепите его к спутанным волосам мертвеца - и тащите жуткий трофей волоком по песку, пока не подвернётся что-то, во что можно её переложить. | Когда последняя мумия обратилась в прах, тело вдруг охватила нестерпимая жажда - будто вы не пили несколько дней под палящим солнцем, а горло сдавило сухим жаром. Спустя несколько ударов сердца всё проходит, оставляя после себя лишь неприятный привкус на языке.\n\n Перед вами - дюжина с лишним забальзамированных тел, устилающих песок. Вы находите мертвеца, увешанного тяжёлым золотым убором, и одним точным ударом отсекаете голову.\n Среди рассыпавшихся погребальных даров вы подбираете бронзовый крюк, некогда служивший частью чьего-то ритуального облачения, - насадив на крюк голову, вы вешаете свой трофей на древко копья и закидываете за спину. | Когда последний из мертвецов рассыпался в пыль, по вашему телу разлилась внезапная тяжесть - суставы налились свинцом, а в висках застучало так, будто вам разом прибавили десяток лет. Через несколько долгих мгновений тяжесть отступает, оставляя лёгкое головокружение.\n\n Перед вами лежит дюжина забальзамированных тел, богато убранных золотом и потускневшими самоцветами. Вы отыскиваете мертвеца в самом богатом убранстве и одним мощным ударом сносите ему голову с плеч.\n Оторвав широкую полосу от истлевших погребальных пелен, вы сооружаете из неё грубый мешок, укладываете внутрь голову и перекидываете свёрток через плечо, отправляясь в обратный путь.}",
			Image = "",
			List = [],
			Options = [
				{
					Text = "С этим покончено.",
					function getResult()
					{
						return 0;
					}

				}
			]
		});
		this.m.Screens.push({
			ID = "Success",
			Title = "На обратном пути..."
			Text = "[img]gfx/ui/events/event_162.png[/img]{Вы входите в главный зал, где вас уже ждёт визирь и аккуратно кладёте голову на стол, туда, где раньше лежала рука. Слуга в дальнем углу, сжимающий грязную тряпку, издаёт унылый вздох и покидает комнату. %employer% пристально разглядывает голову, не вставая с места.%SPEECH_ON%Дело сделано?%SPEECH_OFF%Вы киваете в ответ.\n В другом углу зала стража и слуги на мгновение сбиваются в кучу, обмениваясь как монетами, так и проклятиями.%SPEECH_ON%Я никогда не видел ничего подобного - но раз угроза устранена, ты можешь уйти со своей наградой.%SPEECH_OFF%Он жестом указывает вам на выход, и слуга поспешно вкладывает в ваши руки мешочек с кронами. Вам приходит в голову, что золото с головного убора, вероятно, стоило вдвое больше, чем вам заплатили.\n Тем временем стражник приближается к голове и пронзает её копьём прямо через глазницу, унося в соседнюю комнату.\n Уже собираясь уходить, вы слышите громкое проклятие и глухой стук плоти о каменный пол, а следом - визгливые крики наложниц. Вы не спеша пересчитываете монеты, прислушиваясь к драматическим событиям в соседней комнате, а затем покидаете зал, удовлетворённые и тем и другим. | Вы входите в зал для приёмов и кладёте голову на низкий столик - туда, где ещё утром лежала отрубленная рука, а теперь остался лишь бурый след на дереве. Придворный слуга, до этого забавлявший гостей, замолкает на полуслове и тихо отступает за колонну.\n Визирь долго молчит, разглядывая голову, а затем произносит одно короткое слово.%SPEECH_ON%Наконец-то.%SPEECH_OFF%Вы коротко киваете.\n По залу пробегает шёпот - придворные оживлённо перешёптываются, косясь на трофей и на вас по очереди.%SPEECH_ON%Ты долго возился, алчущий крон. Но раз с мертвецами покончено, забирай свою плату и можешь идти.%SPEECH_OFF%Слуга подходит и вкладывает вам в руки увесистый мешочек.\n Стражник у двери, не церемонясь, подцепляет голову концом копья - и почти сразу спотыкается на ровном полу, будто что-то толкает его под ноги. Выругавшись, он всё же уносит трофей прочь, оставляя на полу влажную дорожку.\n Уже у самого выхода вы слышите звон упавшего металла и приглушённую перебранку из соседней комнаты - словно неудача, вцепившаяся в стражника у самой двери, последовала за ним и туда. Пряча улыбку, вы взвешиваете мешочек в руке и покидаете зал, довольные исходом дня. | Вы входите в зал и кладёте голову туда же, где раньше лежала рука, - на всё тот же многострадальный стол. Двое слуг, до этого о чём-то спорившие в углу, торопливо прячут за спину горсть монет: похоже, кто-то из них проспорил, ставя на ваше возвращение.\n Визирь склоняется над трофеем, разглядывая его с нескрываемым любопытством.%SPEECH_ON%Значит, всё кончено?%SPEECH_OFF%Вы молча киваете.\n Придворные за его спиной обмениваются взглядами, кто-то тихо присвистывает.%SPEECH_ON%Что ж, ты отработал свою плату, алчущий крон. Забирай награду и не попадайся мне на глаза до следующего раза.%SPEECH_OFF%Слуга суёт вам в руки мешочек с монетами, стараясь не смотреть на стол. Вам приходит в голову, что золото с головного убора, вероятно, стоило вдвое больше, чем вам заплатили.\n Едва стражник, которому было поручено убрать голову, берётся за трофей, как нога сама подворачивается на ровном ковре: голова с глухим стуком катится по полу, прежде чем он успевает её подхватить.\n Вы слышите за спиной сдавленные проклятия и звук поспешной уборки, пока идёте к выходу - будто неудача преследует того, кто несёт голову. Пересчитывая монеты на ходу, вы покидаете дворец, вполне довольные тем, как обернулось дело, - хотя во дворце, судя по звукам, всё интересное только начинается. | Вы входите в главный зал и опускаете голову на стол рядом с тем самым пятном, что осталось от руки. Старый советник визиря, стоявший неподалёку, брезгливо морщится и отходит подальше, бормоча что-то о недостойных зрелищах в приличном доме.\n Визирь поднимает взгляд от бумаг и коротко спрашивает.%SPEECH_ON%Все мертвы?%SPEECH_OFF%Вы киваете в ответ.\n Советник за его спиной что-то возмущённо шепчет, но визирь лишь отмахивается от него, не оборачиваясь.%SPEECH_ON%Вот видишь, я говорил, что дело того стоит. Забирай свою награду, алчущий крон, и избавь меня от своего общества.%SPEECH_OFF%Слуга вкладывает вам в руки мешочек с монетами.\n Стражник хватает голову за волосы и уносит её, брезгливо отвернувшись, - и почти сразу спотыкается в дверном проёме, чудом удержавшись на ногах.\n Уже у дверей вы слышите звон упавшей посуды и возмущённые женские голоса из соседней комнаты - похоже, невезение, увязавшееся за стражником, не отпускает его и там. Не спеша пересчитав монеты, вы покидаете зал, довольные наградой - и невольно гадая, надолго ли задержится во дворце то несчастье, что вы принесли с собой.}",
			Image = "",
			Characters = [],
			List = [],
			ShowEmployer = true,
			Options = [
				{
					Text = "Удачная охота.",
					function getResult()
					{
						this.World.Assets.addBusinessReputation(this.Const.World.Assets.ReputationOnContractSuccess);
						this.World.Assets.addMoney(this.Contract.m.Payment.getOnCompletion());
						this.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation(this.Const.World.Assets.RelationNobleContractSuccess, "Очистили окрестности города от мертвецов");
						this.World.Contracts.finishActiveContract();
						return 0;
					}

				}
			],
			function start()
			{
				this.List.push({
					id = 10,
					icon = "ui/icons/asset_money.png",
					text = "Вы получаете [color=" + this.Const.UI.Color.PositiveEventValue + "]" + this.Contract.m.Payment.getOnCompletion() + "[/color] крон"
				});
				this.Contract.m.SituationID = this.Contract.resolveSituation(this.Contract.m.SituationID, this.Contract.m.Home, this.List);
			}

		});
	}

	function onPrepareVariables( _vars )
	{
		_vars.push([
			"direction",
			this.m.Target == null || this.m.Target.isNull() ? "" : this.Const.Strings.Direction8[this.m.Home.getTile().getDirection8To(this.m.Target.getTile())]
		]);
	}

	function onHomeSet()
	{
		if (this.m.SituationID == 0)
		{
			this.m.SituationID = this.m.Home.addSituation(this.new("scripts/entity/world/settlements/situations/terrified_villagers_situation"));
		}
	}

	function spawnEnemies() {
		local disallowedTerrain = [];
		for( local i = 0; i < this.Const.World.TerrainType.COUNT; i = ++i ) {
			if (i == this.Const.World.TerrainType.Desert)
				continue;
			disallowedTerrain.push(i);
		}

		local playerTile = this.World.State.getPlayer().getTile();
		local mapSize = this.World.getMapSize();
		local tile = this.getTileToSpawnLocation(playerTile, 8, 12, disallowedTerrain);
		local party;
		party = this.World.FactionManager.getFactionOfType(this.Const.FactionType.Zombies).spawnEntity(tile, "Мумии", false, this.Const.World.Spawn.MummiesPatrol, 110 * this.getDifficultyMult() * this.getScaledDifficultyMult(), this.getMinibossModifier());
		party.setDescription("Отблеск золота и тяжёлая поступь служат предупреждением для всех.");
		party.setFootprintType(this.Const.World.FootprintsType.Undead);
		party.setAttackableByAI(false);
		party.setFootprintSizeOverride(0.75);

		for( local i = 0; i < 1; i = ++i ) {
			local nearTile = this.getTileToSpawnLocation(playerTile, 5, 10, disallowedTerrain);
			if (nearTile != null)
				this.Const.World.Common.addFootprintsFromTo(nearTile, party.getTile(), this.Const.UndeadFootprints, this.Const.World.FootprintsType.Undead, 0.75);
		}

		this.m.Target = this.WeakTableRef(party);
		local nearestUndead = this.getNearestLocationTo(this.m.Home, this.World.FactionManager.getFactionOfType(this.Const.FactionType.Undead).getSettlements());
		party.getSprite("banner").setBrush(nearestUndead.getBanner());
		local c = party.getController();
		c.getBehavior(this.Const.World.AI.Behavior.ID.Flee).setEnabled(false);
		local roam = this.new("scripts/ai/world/orders/roam_order");
		roam.setPivot(this.m.Home);
		roam.setMinRange(8);
		roam.setMaxRange(12);
		roam.setNoTerrainAvailable();
		roam.setTerrain(this.Const.World.TerrainType.Desert, true);
		c.addOrder(roam);
		return party;
	}

	function onClear()
	{
		if (this.m.IsActive)
		{
			if (this.m.Target != null && !this.m.Target.isNull())
			{
				this.m.Target.setAttackableByAI(true);
				this.m.Target.getSprite("selection").Visible = false;
				this.m.Target.setOnCombatWithPlayerCallback(null);
			}

			this.m.Home.getSprite("selection").Visible = false;
		}

		if (this.m.Home != null && !this.m.Home.isNull() && this.m.SituationID != 0)
		{
			local s = this.m.Home.getSituationByInstance(this.m.SituationID);

			if (s != null)
			{
				s.setValidForDays(3);
			}
		}
	}

	function onIsValid()
	{
		return true;
	}

	function onSerialize( _out )
	{
		if (this.m.Target != null && !this.m.Target.isNull())
		{
			_out.writeU32(this.m.Target.getID());
		}
		else
		{
			_out.writeU32(0);
		}

		this.contract.onSerialize(_out);
	}

	function onDeserialize( _in )
	{
		local target = _in.readU32();

		if (target != 0)
		{
			this.m.Target = this.WeakTableRef(this.World.getEntityByID(target));
		}

		this.contract.onDeserialize(_in);
	}

});

