this.vampire_intro_event <- this.inherit("scripts/events/event", {
	m = {},
	function create()
	{
		this.m.ID = "event.vampire_scenario_intro";
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
        	Text = "[img]gfx/ui/events/event_115.png[/img]Ожидание было мучительным, но ближе к вечеру старая карга наконец выходит из своей лачуги, попутно пряча в складках пояса массивный кинжал. Другие ведьмы обычно держат при себе отару очарованных слуг для защиты и густо размазывают по коже приворотные мази, пытаясь вернуть увядшую молодость.\n\nЭта старуха - исключение. Она даже не пытается казаться молодой, а за ней по пятам нет ни одного очарованного раба. Лишь дряхлая одинокая карга посреди глухой чащи. Наверняка за этим кроется целая история, но у вас складывается стойкое ощущение, что вам не суждено её услышать.\n\n%SPEECH_ON%Всё готово?%SPEECH_OFF%Ведьма кивает, и её иссохшая ладонь ложится на рукоять кинжала.\n\nПоначалу вы раздумываете, насколько опасной может быть одна дряхлая старуха. Однако взгляд быстро переключается на необычное оружие у неё на поясе - такой клинок явно создавался для того, чтобы творить неописуемые мерзости с существами вашего... положения. Впрочем, рука ведьмы проходит мимо оружия и ныряет в дорожную сумку. Она достаёт небольшую чашу - а точнее, верхнюю часть человеческого черепа, доверху наполненную грубым серым порошком.%SPEECH_ON%Разотри это под глазами. Капли размером с дождинку будет достаточно.%SPEECH_OFF%Она повторяет жест у своего лица, ни на секунду не разрывая с вами зрительный контакт.\n\nВы указываете на костяную чашу:%SPEECH_ON%Как часто прибегать к этому?%SPEECH_OFF%Старуха снова кивает:%SPEECH_ON%Одного раза хватит. Если встретишь на тракте других из своего... выводка, пускай сделают то же самое. А теперь касательно моей платы...%SPEECH_OFF%Вы зеркально киваете в ответ:%SPEECH_ON%Всё уже устроено и запущено. Я не знаю, когда именно они явятся, но ваши пути скоро пересекутся.%SPEECH_OFF%Ведьма несколько раз дёргает головой и ковыляет прочь. Какая-то часть вашего существа искушает вас прирезать её прямо здесь, но внезапное гнетущее чувство оцепенения сковывает вас прежде, чем инстинкт берёт верх. В этот самый миг карга оборачивается, уже стоя у безопасного порога своей хижины.%SPEECH_ON%Скоро ко мне нагрянут гости... из тех, кто не настроен на дружеские беседы. На вашем месте я бы убралась отсюда до их прихода. А когда вотрешь эту мазь под глаза - даже я не смогу почуять, что ты за тварь.%SPEECH_OFF%Из-за деревьев бесзвучно выступает %randombrother% и провожает старую ведьму взглядом. Он подходит ближе:%SPEECH_ON%Оно у тебя?%SPEECH_OFF%Вы поворачиваетесь к нему, и на вашем лице играет зловещий, хищный оскал, пока пальцы крепче сжимают заветный череп:%SPEECH_ON%О да, брат, оно у меня. И даже гораздо большее!%SPEECH_OFF%",
			Image = "",
			Banner = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Начинается новый рассвет!",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}
		});
	}

	function onUpdateScore()
	{
		return;
	}

	function onPrepare()
	{
		this.m.Title = "Ненадёжные союзники";
	}

	function onPrepareVariables( _vars )
	{
		_vars.push([
			"home",
			this.World.Flags.get("HomeVillage")
		]);
	}

	function onClear()
	{
	}

});