this.vampire_avatar_intro_event <- this.inherit("scripts/events/event", {
	m = {},
	function create()
	{
		this.m.ID = "event.vampire_avatar_scenario_intro"; // -
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
        	Text = "[img]gfx/ui/events/event_101.png[/img]Всё под контролем.\n\nМир велик, но не бесконечен. Существует столько холмов, рек и лесов, рек и лесов, где они могут прятаться, прежде чем вы их настигнете. Вы были таким же, как они, но быстро поняли, каков правильный путь.\n\nЕстественный порядок вещей должен быть сохранён, а это значит, что при необходимости нужно идти на жертвы.\n\nНаёмник судорожно дёргает ногами в воздухе и испускает дикий крик, пока его соратники в ужасе наблюдают за происходящим.\n\nНо сначала нужно закончить то, что начали, и сосредоточиться на текущем деле.\n\nПриглушённый вопль пронзает воздух, и наёмник падает на землю. Когда вы отнимаете руку от его рта, челюсть полностью отделена, а внутренности растекаются по вашей ладони. На короткое мгновение в глубине вашего разума вспыхивает далёкое воспоминание из прошлой жизни, но гаснет так же быстро, как и появилось. В том, что осталось от черепа несчастного, безумно дёргается и бьётся в судорогах язык. Остальной наёмничий сброд спешно смыкает ряды, выстраивая плотную стену щитов. Некоторые заметно дрожат от страха, и лишь один упрямо держит позицию. Человек без челюсти снова булькает - этот звук, напоминает одновременно мольбы и проклятия.\n\nВы делаете короткий, издевательский поклон и причудливо раскидываете руки в стороны. Какая-то часть вашего существа искренне надеется, что их ждёт та же участь, но ваш слуга тихо шепчет вам на ухо, зарождая зерно другой, ещё более восхитительной идеи.\n\nСхватив ближайшего смертного, вы впиваетесь в него взглядом - мир, возможно, слишком велик, чтобы искать в одиночку, но идея смешаться с другими существами кажется чертовски заманчивой...",
			Image = "",
			Banner = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Снова на охоту!",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}
		});
	}

	function onUpdateScore()
	{
		return;
	}

	function onPrepare()
	{
		this.m.Title = "Первородная кровь";
	}

	function onPrepareVariables( _vars )
	{
		_vars.push([
			"home",
			this.World.Flags.get("HomeVillage")
		]);
	}

	function onClear()
	{
	}

});
