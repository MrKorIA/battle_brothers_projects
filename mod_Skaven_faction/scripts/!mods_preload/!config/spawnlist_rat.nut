local function onCostCompare( _t1, _t2 )
{
    if (_t1.Cost < _t2.Cost)
    {
        return -1;
    }
    else if (_t1.Cost > _t2.Cost)
    {
        return 1;
    }

    return 0;
}

local function calculateCosts( _p )
{
    foreach( p in _p )
    {
        p.Cost <- 0;

        foreach( t in p.Troops )
        {
            p.Cost += t.Type.Cost * t.Num;
        }

        if (!("MovementSpeedMult" in p))
        {
            p.MovementSpeedMult <- 1.0;
        }

        if (!("VisibilityMult" in p))
        {
            p.VisibilityMult <- 1.0;
        }

        if (!("VisionMult" in p))
        {
            p.VisionMult <- 1.0;
        }
    }

    _p.sort(onCostCompare);
}

calculateCosts(::Const.World.Spawn.RatRoamers);
calculateCosts(::Const.World.Spawn.RatScouts);
calculateCosts(::Const.World.Spawn.RatRaiders);
calculateCosts(::Const.World.Spawn.RatDefenders);
calculateCosts(::Const.World.Spawn.RatLord);
calculateCosts(::Const.World.Spawn.RatChef);