this.nggh_mod_hexe_intro_event <- ::inherit("scripts/events/event", {
	m = {
		Hexe = null
	},
	function create()
	{
		this.m.ID = "event.hexe_intro_event";
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_33.png[/img]Нет ничего нечестивее людской жадности. Вам никогда не удовлетворить её, ведь чем больше вы получаете, тем больше вам хочется. Деньги, похоть, власть - вот чего хочет обычный человек, но некоторые... некоторые алчут иного - власти. %witch% - пример такой жадности, она хочет красоты, она хочет власти. Посему она стала изучать колдовство, отказавшись от собственной человечности, дабы получить эту власть. Она могущественна, она знает, что ни одна другая ведьма не может обладать такой силой, как она. Но её последнее желание никогда не было исполнено, и поэтому ради его выполнения был подготовлен этот грандиозный ритуал. Красота, способная покорить любую женщину или мужчину, - вот что будет наградой.\n\nВсё идет так, как она планировала, как и должно быть. Но когда взгляд %witch% обращается вправо, виден дождь стрел, летящих в ночном небе. %witch% отбивает их своей магией, она больше не может сохранять спокойствие, на неё напали. Кто они? Наёмники? Эти уроды из благородных домов? Ритуал не должен быть прерван. Но реальность далека от желаний, и причитания о пошедших прахом планах её не изменят. %SPEECH_ON%Никакой пощады! Пусть их кровь послужит платой за глупость. Убить всех до единого, мои рабы!%SPEECH_OFF%Услышав приказ своего хозяина, бесчисленные звери и люди бросаются прямо на вражеский строй. Кровавая битва грядёт.",
			Image = "",
			Banner = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Глупцы! Как смеете вы недооценивать мою силу!",
					function getResult( _event )
					{
						return "B";
					}

				}
			],
			function start( _event )
			{
				this.Banner = "ui/banners/" + ::World.Assets.getBanner() + "s.png";
			}

		});
		
		this.m.Screens.push({
			ID = "B",
			Text = "[img]gfx/ui/events/event_132.png[/img]Битва вскоре закончилась морем крови, но из-за неё ритуал не был завершён. И хотя %witch% обрела столь желанную красоту, но также и была наказана за провал ритуала. Она была проклята, её красота несовершенна, а незримый голос тихо шепчет ей. %SPEECH_ON%Семь дней, приготовь подношения, или твоя жизнь закончится в муках!%SPEECH_OFF%Перед глазами %witch% лишь залитое кровью поле битвы, а в будущем - лишь проклятие. Большинство рабов пало в бою, а её сила ослабла после проклятия. %SPEECH_ON%Нет! Нет! Нет! Как это могло произойти? Я потеряла всё. Как я смогу подготовить ещё один ритуал? %SPEECH_OFF%Ей ведомо - невозможно собрать подношения, не подняв шума в какой-нибудь деревушке. Но проходит несколько часов, и %witch% находит решение. Создав отряд наёмников, она уменьшит подозрения со стороны посторонних и, тщательно спланировав свои действия, сможет собрать подношения.", 
			Image = "",
			Banner = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Время пошло.",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
				this.Characters.push(_event.m.Hexe.getImagePath());
			}

		});
	}

	function onUpdateScore()
	{
		return;
	}

	function onPrepare()
	{
		this.m.Title = "Ведьма";
		
		foreach (b in ::World.getPlayerRoster().getAll())
		{
			if (b.getBackground().getID() == "background.hexe" || b.getFlags().has("Hexe"))
			{
				this.m.Hexe = b;
				break;
			}
		}
	}

	function onPrepareVariables( _vars )
	{
		local hexe;
		
		foreach (b in ::World.getPlayerRoster().getAll())
		{
			if (b.getBackground().getID() == "background.hexe_commander" || b.getFlags().has("Hexe"))
			{
				hexe= b;
				break;
			}
		}
		
		if (hexe == null)
		{
			_vars.push([
				"witch",
				"Ariel"
			]);
		}
		else
		{
			_vars.push([
				"witch",
				hexe.getNameOnly()
			]);
		}
	}

	function onClear()
	{
	}

});

