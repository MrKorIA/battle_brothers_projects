this.nggh_mod_suicide_event <- ::inherit("scripts/events/event", {
	m = {
		Suicider = null,
		Other = null
	},
	function setSuicider( _d )
	{
		this.m.Suicider = _d;
		this.m.Other = null;
		local brothers = ::World.getPlayerRoster().getAll();

		if (brothers.len() <= 2) {
			this.m.Other = this.m.Suicider;
			return;
		}
		
		do
		{
			this.m.Other = ::MSU.Array.rand(brothers);
		}
		while (this.m.Other.getID() == this.m.Suicider.getID());
	}

	function create()
	{
		this.m.ID = "event.suicide";
		this.m.Title = "По пути...";
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_64.png[/img]{%suicidedbrother% покончил с собой. Когда дни кажутся бесконечными, а дороги длинными, в людях просыпаются разные качества. Вы понимаете, что даже те, кто бесстрашен в бою, иногда не имеют сил для трудностей наёмной жизни. Кроме того, есть люди, что представляют собой одновременно и трусов и бездельников. Вы можете только надеяться, что вы не потратите слишком много золота на подобных, прежде чем понять кто они такие.\n\n\n%otherbrother% подходит к вам.%SPEECH_ON%Не обращай внимания на %suicidedbrother%, командир. Никогда не нравился его вид. Без %companyname%, который о нем заботился, через пару недель он раскачивался бы на виселице.%SPEECH_OFF%| Ворчание - давняя и почитаемая традиция среди наёмников, да и среди прочих людей в целом, но %suicidedbrother% превзошёл всех своими бесконечными жалобами.\n\n\nЕсли хлеб зачерствел, пиво горчит, а мясо слишком жилистое, он непременно пожалуется вам об этом. Первым. И непременно повторит. Вы узнавали о натруженных ногах, плохой погоде, хрупких щитах, натирающих доспехах, слишком медленно тащащихся караванах, слишком быстро мчащихся караванах, затупившихся мечах, несправедливом распределении дозоров и платы, протухшей еде, постоянной скуке и совах, не дающих спасть после наступления ночи. Это далеко не полный список жалоб, лишь то, что вы могли вспомнить сразу же.\n\n\nВсе жалобы, которые %suicidedbrother% постоянно издавал, к сожалению, являются неотъемлемой частью жизни странствующего отряда наёмников. И трудностей этих нельзя ни предотвратить, ни избежать. Так что вы вовсе не удивлены тому, что %suicidedbrother% решил покончить с жизнью. | В недавнем времени ваш отряд, к сожалению, столкнулся с рядом неудач. И %suicidedbrother% воспринял это куда тяжелее остальных. Он стал подолгу дрыхнуть в постели, затевать драки, осмелился даже не подчиниться вашим приказам. И всё это в случае, если он вообще был в лагере. Подобное поведение даровало ему всеобщую нелюбовь: как вашу, так и всех его братьев по оружию. Последней каплей, пожалуй, стал случай, когда %otherbrother% выбросил спальный мешок, в котором спал %suicidedbrother%, в канаву, куда отряд справлял нужду.\n\nОбычно лучше не мешать людям выражать своё недовольство, и раз уж в последнее время отряд преследовали неудачи, вы были довольно терпимы к подобным вещам. Когда ранним утром вы обнаружили, что одного из ваших соратников нет, это не стало большой неожиданностью. %suicidedbrother% покинул %companyname%. | Утро встретило вас вестью, что %suicidedbrother%, пропал в ночи. Поговорив с остальными братьями и удостоверившись, что он не спрятался за ближайшим валуном, желая справить нужду, вы отправляете людей на поиски. Полагая, что %suicidedbrother% мог быть взят в плен, похищен ради выкупа или же пал жертвой неведомого чудища, вы, вместе со всем отрядом, проводите несколько часов, исследуя окрестности и выкрикивая его имя.\n\nВ конце концов, %otherbrother% наконец предположил, что %suicidedbrother% вовсе не пропал, а сбежал из отряда.%SPEECH_ON%В последнее время он постоянно ныл о своей несчастной судьбе, погубленной службой в нашем отряде. Полагаю, он скрывал это от тебя, командир, чтобы не лишиться возможности ускользнуть незамеченным.%SPEECH_OFF% Сдерживая желание отвесить носителю дурных вестей солидную оплеуху, вы спрашиваете, почему же он не рассказал об этом раньше? %otherbrother% лишь молча хлопает глазами. | Вам и в голову не приходило, что %suicidedbrother% из тех людей, что способны сбежать из отряда, но наступивший рассвет, осветивший его отсутствие, показал, что вы слишком легковерны. Каждый день пути он отставал от отряда всё дальше и дальше, всякий раз, как вы приказывали свернуть лагерь, он был последним, кто успевал собрать свои вещи и присоединиться к походу. Да и за снаряжением своим он тоже ухаживать перестал. И хотя он держал все свои мысли при себе, оглядываясь назад, вы понимаете, что его хмурый вид и и пренебрежение к своим братьям по оружию ясно показывали, что он не был доволен тем, куда двигался отряд последнее время.\n\nПоговорив с остальными братьями, вы подмечаете, что все они разочарованы. Стоит убедиться в том, что ваши наёмники сыты, не испытывают жажды, а плата выдаётся вовремя, и надеяться, что %suicidedbrother% был последним, кто сбежал из отряда в ночи. | Вы не знаете, было ли дело в низкой плате, угрозах четвертования, долгих походах под ледяным дождём, постоянной брани, чёрствой пище, постоянных подначках со стороны прочих братьев, швыряющих камни детишках, холодных ветрах или бессонных ночах, но %suicidedbrother% явно становился всё более и более несчастлив, пока окончательно не разочаровался в жизни наёмника.%SPEECH_ON%Не понимаю, на что тут жаловаться? Меня вот всё устраивает.%SPEECH_OFF%Говорит %otherbrother%, услышав о случившемся. %suicidedbrother% выбрал иную дорогу вместо отряда '%companyname%'. По крайней мере, у него хватило совести самому сказать вам, что он решил уйти - хотя, если подумать, это скорее было сделано для того, чтобы самому же получить оставшееся жалованье. | В последнее время %suicidedbrother% начал совершать долгие прогулки по вечерам, когда работа была закончена. Хотя его привычка бродить в одиночестве была не совсем безопасной, нельзя было придумать никакой причины, чтобы остановить его, когда он не нужен в лагере. Однако чем больше трудностей выпадало на долю отряда, тем дольше становились эти прогулки, пока однажды утром %suicidedbrother% вообще не вернулся.\n\n%suicidedbrother% покинул %companyname%. Возможно, это к лучшему. | %suicidedbrother% последнее время становился всё мрачнее, проводя своё свободное время со старым метательным ножом, лезвие которого больше походило на кусок ржавой тёрки, нежели на оружие. Весь предыдущий вечер он потратил, метая нож в ствол засохшего дерева, вновь и вновь поднимаясь со стоном, чтобы выдернуть его, возвращаясь на несколько шагов назад, приседая и вновь отправляя нож в полёт среди сгустившихся сумерек.\n\nОчевидно, он был недоволен недавними неудачами, с которыми столкнулся отряд. Сегодня утром он набрался смелости войти в вашу палатку и сказать, что покидает вас, дабы искать своё счастье в другом месте.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "{Плохие новости, действительно. | Я не могу допустить, чтобы что-то подобное случилось снова.}",
					function getResult( _event )
					{
						_event.m.Suicider.getItems().transferToStash(::World.Assets.getStash());
						::World.Statistics.addFallen(_event.m.Suicider.finalizeFallen({
							Name = _event.m.Suicider.getName(),
							Time = ::World.getTime().Days,
							TimeWithCompany = ::Math.max(1, _event.m.Suicider.getDaysWithCompany()),
							Kills = _event.m.Suicider.m.LifetimeStats.Kills,
							Battles = _event.m.Suicider.m.LifetimeStats.Battles + 1,
							KilledBy = "Самоубийство",
							Expendable = _event.m.Suicider.getBackground().getID() == "background.slave"
						}));
						::World.getPlayerRoster().remove(_event.m.Suicider);
						_event.m.Suicider = null;
						_event.m.Other = null;
						return 0;
					}

				}
			],
			function start( _event )
			{
				this.Characters.push(_event.m.Suicider.getImagePath());
				this.List.push({
					id = 13,
					icon = "ui/icons/kills.png",
					text = _event.m.Suicider.getName() + " заканчивает свою жизнь"
				});
			}

		});
	}

	function onUpdateScore()
	{
		return;
	}

	function onPrepareVariables( _vars )
	{
		_vars.push([
			"suicidedbrother",
			this.m.Suicider.getName()
		]);
		_vars.push([
			"otherbrother",
			this.m.Other.getName()
		]);
	}

	function onClear()
	{
		this.m.Suicider = null;
	}

});

