::Nggh_MagicConcept.HooksMod.hook("scripts/events/events/dlc2/location/kraken_cult_enter_event", function (q) 
{
	q.onDetermineStartScreen = @(__original) function()
	{
		return ::World.Flags.get("IsKrakenOrigin") ? "H" : __original();
	}

	q.create = @(__original) function()
	{
		__original();

		// add new screen
		m.Screens.push({
			ID = "H",
			Text = "[img]gfx/ui/events/event_103.png[/img]{Вы намереваетесь силой напомнить женщине о том, что обманывать наёмников - не самая лучшая затея, как вдруг громкое хлюпанье приглушает все прочие звуки. За спиной женщины развернулась страшная картина: огоньки, доселе мирно дремавшие в воде, вылезают на поверхность. Как оказалось, эти огоньки были лишь маленькими фонариками, на теле огромных щупалец. Щупалец, которые сейчас оплетали молчаливых приспешников и тянули их к центру болота. Сам же центр болота вдруг резко сдвинулся, заставив упасть некоторых из ваших людей от этого внезапного толчка. Там, где минуту назад были лишь мох да земля, начали появляться разломы, в которые утягивалось всё: земля, книги, одежда, грибы и мутная болотная вода. Вдруг посреди всей этой мешанины вы замечаете клыки. Огромные, длиною с полуторный меч, они кромсали всё, что попадало в возникшую воронку. Вскоре там оказались и безумцы, схваченные щупальцами. Один за другим они отправлялись в зубастую мясорубку, сохраняя леденящее кровь спокойствие и молчание. Их мучения были недолгими: клыки быстро перемалывают безумцев на мелкие кусочки. Некоторые 'везунчики' не попадали на клыки и исчезали в глотке твари целиком. Наблюдающая за всем этим женщина довольно откусывает кусок очередного гриба и с безумной улыбкой смотрит на ваш отряд, к которому стягивается всё больше и больше болотных огоньков.%SPEECH_ON%Присоединяйся к нам, наёмник! Пусть кракен насладится своим пиром!%SPEECH_OFF%Вместо ответа вы бьёте её кулаком в лицо и, достав меч, перерубаете щупальце, что медленно оплетало вашу ногу. Быть может вам и предстоит погибнуть в бою, но вы точно не умрете в этом, богами забытом, месте. На бегу отдавая приказы и обрубая слишком ретивые щупальца, вы готовитесь дать чудовищу достойный бой.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Давайте сразимся!",
					function getResult( _event )
					{
						::World.State.getLastLocation().setFaction(::World.FactionManager.getFactionOfType(::Const.FactionType.Beasts).getID());
						::World.Events.showCombatDialog(false, true, true);
						return 0;
					}

				}
			],
			function start( _event )
			{
			}

		});
	}
	
});
