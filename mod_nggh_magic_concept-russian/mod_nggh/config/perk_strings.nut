//-------------
// description
// hexe charm specialized
::Const.Strings.PerkDescription.NggHCharmEnemySpider <- "'Жуткие чудища из тёмных чащоб, что могут стать вашими слугами и воинами.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет вам навсегда очаровать сетеплёта."
		+ "\n• Выполняет одно из двух условий, необходимых для постоянного очарования красноспинного паука."
		+ "\n• Дает [color=" + ::Const.UI.Color.PositiveValue + "]невосприимчивость[/color] к обездвиживанию сетями, паутиной или ловчими корнями.";

::Const.Strings.PerkDescription.NggHCharmEnemyDirewolf <- "'Каждый хотел бы иметь домашнего питомца ростом 5 футов. Ничто не может быть лучше, чем наблюдать за тем, как они разделываются с глупцами, посмевшими нажить себе врага в вашем лице.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]\n• Позволяет вам навсегда очаровывать лютоволка, гиену или медведя."
		+ "\n• Выполняет одно из двух условий, необходимых для постоянного очарования белого лютоволка."
		+ "\n• Инициатива увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]8%[/color], получает на [color=" + ::Const.UI.Color.PositiveValue + "]2[/color] меньше усталости за каждую пройденную клетку.";

::Const.Strings.PerkDescription.NggHCharmEnemyAlp <- "'Пожиратель снов, призыватель кошмаров - подобным созданиям суждено стать слугами для такой красавицы, как вы.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет вам навсегда очаровать альпа."
		+ "\n• Выполняет одно из двух условий, необходимых для постоянного очарования демонического альпа."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+15[/color] к решимости при проверке боевого духа против страха, паники или контроля разума."
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]сон[/color] получает [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color] к шансу усыпить цель.";

::Const.Strings.PerkDescription.NggHCharmEnemyGhoul <- "'Оголодавшие приматы или большие голодные гориллы наверное станут прекрасными необычными питомцами.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет вам навсегда очаровать нахцерера."
		+ "\n• Выполняет одно из двух условий, необходимых для постоянного очарования бледного упыря."
		+ "\n• ОЗ увеличены на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color]."
		+ "\n• Инициатива увеличена на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color].";

::Const.Strings.PerkDescription.NggHCharmEnemyUnhold <- "'Гиганты, способные затмить даже самого высокого орка. Вы бы хотели, чтобы такие могучие существа, как они, были вашими телохранителями.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет вам навсегда зачаровывать тролль, ледяного тролля, болотного тролля, бронированного тролля."
		+ "\n• Удовлетворяет одному из двух условий, чтобы навсегда очаровать каменного тролля."
		+ "\n• Максимальная выносливость увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color]."
		+ "\n• ОЗ увеличиваются на [color=" + ::Const.UI.Color.PositiveValue + "]15%[/color].";

::Const.Strings.PerkDescription.NggHCharmEnemySchrat <- "'Разумные древние деревья, которые считаются хранителями леса. Иметь их в качестве своих хранителей было бы более уместно!'" 
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет вам навсегда очаровать лешего."
		+ "\n• Выполните одно из двух условий, чтобы навсегда очаровать могучего лешего."
		+ "\n• Защита ближнего боя и защита дальнего боя увеличиваются на [color=" + ::Const.UI.Color.PositiveValue + "]5[/color] единиц."
		+ "\n• Наносимый урон уменьшается на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color]. Не влияет на урон от ментальных атак или эффектов состояния.";

::Const.Strings.PerkDescription.NggHCharmEnemyLindwurm <- "'Некоторые говорят, что это гигантские змеи, другие называют их драконами. Все это для того, чтобы описать страшных зверей с кислой кровью и огромным телом. Представьте себе, что у вас в подчинении такой зверь.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет вам навсегда очаровать линдвурма."
		+ "\n• Выполните одно из двух условий, чтобы навсегда очаровать штольвурма."
		+ "\n• Уменьшает решимость любого противника, участвующего в ближнем бою, на сумму, равную [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color] вашей текущей решимости.";

::Const.Strings.PerkDescription.NggHCharmEnemyOrk <- "'Воины, с силой которых не может сравниться ни один человек. Если бы столь могучая сила была применена на благое дело...'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]" 
		+ "\n• Позволяет вам навсегда очаровать орка-вождя, чудовищного орка и элитного орка." 
		+ "\n• Выполняет одно из двух условий, необходимых для постоянного очарования  орка-вождя и чудовищного орка." 
		+ "\n• Ваша инициатива снижается только на [color=" + ::Const.UI.Color.PositiveValue + "]50%[/color] накопленной усталости.";

::Const.Strings.PerkDescription.NggHCharmEnemyGoblin <- "'Гоблины могут быть маленькими и слабыми, но в их рукавах есть множество хитростей. Такие хитрые существа хороши для некоторых дел.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет вам навсегда очаровать гоблина-надсмотрщика и гоблина-шамана."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]невосприимчивость[/color] к ошеломлению."
		+ "\n• Защита в дальнем бою увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]10[/color].";
// hexe charm base
::Const.Strings.PerkDescription.NggHCharmBasic <- "'Изучите основы кражи чужих сердец. Первый урок: завидев пару ваших наливных яблочек, мужчины сами падут к вашим ногам.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Обаяние[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пленительное очарование[/color] получают дополнительные [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color] к очарованию."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color] навык бартера, увеличивая цены продажи, уменьшая цены покупки и увеличивая оплату контрактов на поставку.";

::Const.Strings.PerkDescription.NggHCharmWords <- "'Волшебные слова, способные пробудить любую спящую змею.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• [color=" + ::Const.UI.Color.PositiveValue + "]Расширяет[/color] вашу способность очаровывать, воздействуя на более сильных людей, таких как рыцарь, сержант, офицер, вожак кочевников, вожак разбойников, варвар-избранный и т.д."
		+ "\n• Решимость увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color]."
		+ "\n• Максимальная выносливость увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color].";

::Const.Strings.PerkDescription.NggHCharmAppearance <- "'Великолепная внешность, перед которой не может устоять ни один мужчина. Как может существовать такая красота?'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет очаровать мастера меча, танцора клинка, мастера-лучника, пустынного преследователя, межевого рыцаря, кочевника-палача, короля варваров и вожака разбойников."
		+ "\n• Увеличивает длительность эффекта [color=" + ::Const.UI.Color.NegativeValue + "]Очарование[/color] на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] ход. Продолжительность бонуса не может быть уменьшена навыком [color=" + ::Const.UI.Color.NegativeValue + "]Стойкость[/color].";

::Const.Strings.PerkDescription.NggHCharmSpec <- "'Овладейте искусством покорять чужие сердца. Разве ты не хочешь мамочку-домохозяйку? Давай! Позволь мамочке утешить тебя!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]Очарование[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пленительное очарование[/color] навыки получают дополнительные [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color] к очарованию."
		+ "\n• Позволяет навсегда очаровать врагов-чемпионов.\n• Удовлетворяет последнему условию, чтобы навсегда очаровать орка-вождя, чудовищного орка и легендарных чудовищ.";

::Const.Strings.PerkDescription.NggHCharmNudist <- "'Настоящей шлюхе не нужна одежда.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\n Даёт следующие эффекты, когда не носит броню и шлем:\n"
		+ "\n• Даёт еще один уровень проворства."
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Обаяние[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пленительное очарование[/color] получают дополнительные [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color] к обаянию.";
// hexe hex
::Const.Strings.PerkDescription.NggHHexHexer <- "'Вы даже не представляете, насколько велика власть ведьм над своими проклятиями.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nПри атаке цели, пораженной эффектом [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color], применяются следующие эффекты:\n"
		+ "\n• Наносимый урон увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]33%[/color]."
		+ "\n• Шанс попадания увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color].";

::Const.Strings.PerkDescription.NggHHexMastery <- "'Овладейте искусством очарования, ваша способность проклясть кого-то еще никогда не была так хороша.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Уменьшает затраты ОД на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color], если у персонажа есть эффект [color=" + ::Const.UI.Color.NegativeValue + "]Защищён порчей[/color]."
		+ "\n• Прирост опыта увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color].";

::Const.Strings.PerkDescription.NggHHexSharePain <- "'Никто не должен страдать в одиночку!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Накладывает дополнительный эффект [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color] на другого случайного врага в пределах вашей видимости."
		+ "\n• Раз в ход урон от всех источников (кроме эффекта [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color]), нанесенный одной из целей, на которую наложено проклятие, будет нанесен и другим целям, на которые наложено проклятие, за исключением вас.";

::Const.Strings.PerkDescription.NggHHexSuffering <- "'Проклятие, которое приносит большее страдание! Пусть они возьмут на себя твое бремя.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Активное умение [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color] повышается до [color=" + ::Const.UI.Color.NegativeValue + "]Проклятие страдания[/color]."
		+ "\n• ОЗ увеличиваются на [color=" + ::Const.UI.Color.PositiveValue + "]18%[/color]."
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Эффекты 'Проклятия страдания':[/u][/color]"
		+ "\n• Передает определенные типы негативных статусных эффектов ([color=" + ::Const.UI.Color.NegativeValue + "]Кровотечение[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Отравление[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Оцепенение[/color] и т.д.) на жертву ведьмы"
	+ "\n\n[color=" + ::Const.UI.Color.NegativeValue + "]Вы можете изучить один навык из этой группы навыков и только один, не больше[/color]";

::Const.Strings.PerkDescription.NggHHexWeakening <- "'Проклятие, которое может привести к слабости и старости.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Активные умение [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color] повышается до [color=" + ::Const.UI.Color.NegativeValue + "]Проклятие ослабления[/color]."
		+ "\n• Восстановление выносливости за ход увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]14%[/color]."
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Эффекты 'Проклятия ослабления':[/u][/color]"
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]-40%[/color] к урону от атак"
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]-33%[/color] к максимальной выносливости."
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]-5[/color] к восстановлению выносливости за ход"
	+ "\n\n[color=" + ::Const.UI.Color.NegativeValue + "]Вы можете изучить один навык из этой группы навыков и только один, не больше[/color]";

::Const.Strings.PerkDescription.NggHHexVulnerability <- "'Проклятие, которое заставляет новые раны становиться более тяжелыми, чем обычно.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Активное умение [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color] повышается до [color=" + ::Const.UI.Color.NegativeValue + "]Проклятие уязвимости[/color]."
		+ "\n• Урон, наносимый по ОЗ, уменьшается на [color=" + ::Const.UI.Color.PositiveValue + "]5[/color] единиц."
		+ "\n• Урон, наносимый по броне, уменьшается на [color=" + ::Const.UI.Color.PositiveValue + "]15[/color] единиц."
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Эффекты 'Проклятия уязвимости':[/u][/color]"
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]+15%[/color] к получаемому урону"
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]-25%[/color] к инициативе"
	+ "\n\n[color=" + ::Const.UI.Color.NegativeValue + "]Вы можете изучить один навык из этой группы навыков и только один, не больше[/color]";

::Const.Strings.PerkDescription.NggHHexMisfortune <- "'Проклятие, приносящее несчастье.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Активное умение [color=" + ::Const.UI.Color.NegativeValue + "]Порча[/color] повышается до [color=" + ::Const.UI.Color.NegativeValue + "]Проклятие неудачи[/color]."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color] шанс, что любой атакующий потребует два успешных броска атаки, чтобы ударить."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color] шанс, что любая отрицательная проверка боевого духа потребует два успешных броска, чтобы повлиять на вас."
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Эффекты 'Проклятия неудачи':[/u][/color]"
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]-12%[/color] от общего шанса на попадание"
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]-10%[/color] от общего шанса на уклонение"
	+ "\n\n[color=" + ::Const.UI.Color.NegativeValue + "]Вы можете изучить один навык из этой группы навыков и только один, не больше[/color].";
// hexe bdsm
::Const.Strings.PerkDescription.NggH_BDSM_WhipLash <- "'Это так быстро, что треск можно услышать издалека. Как от этого можно увернуться?'" 
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]" 
	+ "\nДаёт следующие эффекты при использовании кнута:" 
		+ "\n\n• Даёт навык ближнего боя, равный [color=" + ::Const.UI.Color.PositiveValue + "]20%[/color] от текущей инициативы персонажа."
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Удар кнутом[/color] получает [color=" + ::Const.UI.Color.PositiveValue + "]+15%[/color] к урону от атак и [color=" + ::Const.UI.Color.PositiveValue + "]+6%[/color] к пробиванию брони за каждую клетку между персонажем и целью.";

::Const.Strings.PerkDescription.NggH_BDSM_WhipMastery <- "'Мастерски владейте кнутом, чтобы бить туда, где больнее всего'." 
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]" 
		+ "\n• Этот навык рассматривается как [color=" + ::Const.UI.Color.NegativeValue + "]Мастерство тесака[/color]." 
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Удар кнутом[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пытка[/color] получают [color=" + ::Const.UI.Color.PositiveValue + "]+5%[/color] урона атаки за каждый уровень эффекта [color=" + ::Const.UI.Color.NegativeValue + "]Кровотечение[/color] на цели." 
		+ "\n• У умений кнута затраты ОД уменьшаются на [color=" + ::Const.UI.Color.NegativeValue + "]1[/color].";

::Const.Strings.PerkDescription.NggH_BDSM_MaskOn <- "'Дорогая! Разве это извращение - надевать маску?'" 
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nПри сочетании со шлемом, дающим хотя бы [color=" + ::Const.UI.Color.NegativeValue + "]-1[/color] к обзору:" 
		+ "\n\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+3%[/color] к решимости за каждый изученный навык из этой группы (включая текущий)." 
		+ "\n• Уменьшает затраты выносливости на использование оружейных умений кнута на величину, равную количеству изученных навыков из этой группы (включая текущий).";

::Const.Strings.PerkDescription.NggH_BDSM_Bondage <- "'Доверься мне, дорогая! Мы весело проведём время.'" 
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nПрименяет следующие эффекты при использовании действующего умения на врага, попавшего в сеть, лозу или паутину:" 
		+ "\n\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Очарование[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пленительное очарование[/color] получают [color=" + ::Const.UI.Color.PositiveValue + "]+7%[/color] шанс успеха." 
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Удар кнутом[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пытка[/color] получают [color=" + ::Const.UI.Color.PositiveValue + "]+25%[/color] к урону и [color=" + ::Const.UI.Color.PositiveValue + "]+25%[/color] пробития брони." 
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Обезоруживание[/color] получает [color=" + ::Const.UI.Color.PositiveValue + "]+12%[/color] к шансу попадания.";

::Const.Strings.PerkDescription.NggH_BDSM_WhipPunish <- "'Делай, как сказала мама, или будешь выпорот.'" 
	+"\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]" 
		+ "\n• Даёт умение [color=" + ::Const.UI.Color.NegativeValue + "]Подстегнуть[/color], если персонаж держит кнут в руке." 
		+ "\n• Тратит 4 ОД и 15 выносливости.\n• Имеет дальность в [color=" + ::Const.UI.Color.PositiveValue + "]3[/color] клетки." 
		+ "\n• Наносит [color=" + ::Const.UI.Color.DamageValue + "]2[/color] - [color=" + ::Const.UI.Color.DamageValue + "]5[/color] урона, игнорирующего броню цели." 
		+ "\n• Накладывает на выбранного простака эффект [color=" + ::Const.UI.Color.NegativeValue + "]Подстегнут[/color], увеличивающий многие его показатели на 2 хода." 
		+ "\n• Восстанавливает боевой дух выбранного простака до 'уверенного', если он ниже.";

::Const.Strings.PerkDescription.NggH_BDSM_WhipLove <- "'Это не жестокость, если им это нравится.'" 
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]" 
		+ "\n• Каждый раз, когда умение [color=" + ::Const.UI.Color.NegativeValue + "]Удар кнутом[/color] или [color=" + ::Const.UI.Color.NegativeValue + "]Пытка[/color] успешно попадает, на цель накладывается уровень эффекта 'Подстёгнут'." 
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Очарование[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пленительное очарование[/color] получают [color=" + ::Const.UI.Color.PositiveValue + "]+4%[/color] к шансу очаровать за каждый уровень эффекта 'Подстегнут' на цели [b](максимум: 20%)[/b]."
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Удар кнутом[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пытка[/color] получают дополнительный урон от атаки, равный [color=" + ::Const.UI.Color.PositiveValue + "]12%[/color] текущей решимости[b](макс: 30)[/b].";

::Const.Strings.PerkDescription.NggH_BDSM_DommyMommy <- "'Я разве сказала тебе остановиться? Не останавливайся, пока я не скажу. Теперь помой мне ноги как следует.'" 
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]" 
		+ "\n• Даёт навык [color=" + ::Const.UI.Color.NegativeValue + "]Устрашающий[/color]." 
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Подстегнуть[/color] теперь повышает боевой дух." 
		+ "\n• Бонусы эффекта [color=" + ::Const.UI.Color.NegativeValue + "]Подстегнут[/color] от умения [color=" + ::Const.UI.Color.NegativeValue + "]Подстегнуть[/color] увеличиваются на [color=" + ::Const.UI.Color.PositiveValue + "]3[/color] единицы.";
// luft
::Const.Strings.PerkDescription.NggHLuftPattingSpec <- "'Овладейте искусством гладить голову. Ни одна голова не может остаться без поглаживания.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Ласки[/color] потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Ласки[/color] наносит [color=" + ::Const.UI.Color.PositiveValue + "]50%[/color] больше урона."
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Ласки[/color] имеет [color=" + ::Const.UI.Color.PositiveValue + "]50%[/color] шанс отвлечь цель.";

::Const.Strings.PerkDescription.NggHLuftUnholyFruits <- "'Люфт познала, как использовать её нечестивые наливные яблочки для достижения своих целей.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Очарование[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Пленительное очарование[/color] получают дополнительные [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color] к очарованию."
		+ "\n• Дает [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color] умение торговаться, увеличивая цены продажи, уменьшая цены покупки и увеличивая оплату контрактов на поставку.";

::Const.Strings.PerkDescription.NggHLuftInnocentLook <- "'Используя свою невинную внешность, он заставляет людей думать, что он милый, чтобы он мог погладить их, когда они ослабят бдительность.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n•[color=" + ::Const.UI.Color.PositiveValue + "]Расширяет[/color] вашу способность очаровывать, чтобы воздействовать на более сильных людей, таких как рыцарь, сержант, офицер, лидер кочевников, лидер бандитов, избранный варвар и т.д."
		+ "\n• Решимость увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color]."
		+ "\n• Максимальная выносливость увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color].";

::Const.Strings.PerkDescription.NggHLuftGhoulBeauty <- "'Очаровательное упыриное тело, способное заставить любого извращенца влюбиться в Люфта. Я им нравлюсь! Они любят меня! Они позволяют мне гладить их!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Позволяет очаровать Мастера меча, Танцора клинка, Мастера лучника, Преследователя пустыни, Межевого рыцаря, Палача кочевников, Короля варваров и Военачальника разбойников."
		+ "\n• Увеличивает длительность эффекта [color=" + ::Const.UI.Color.NegativeValue + "]Зачарование[/color] на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] ход. Продолжительность бонуса не может быть уменьшена навыком [color=" + ::Const.UI.Color.NegativeValue + "]Стойкость[/color].";
// egg
::Const.Strings.PerkDescription.NggHEggBreedingMachine <- "'Осваивайте то, что у вас хорошо получается. Производить яйца, а не есть их!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Высиживание яйца[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Высиживание всех яиц[/color] потребляют на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• В начале каждого хода, есть [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color] шанс получить бесплатное яйцо.";

::Const.Strings.PerkDescription.NggHEggInherit <- "'Как отец, так и сын.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Вылупившиеся паучата наследуют большинство навыков персонажа.";

::Const.Strings.PerkDescription.NggHEggNaturalSelection <- "'Пусть природа делает свое дело.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Паучата, вылупившиеся позже, имеют более высокие показатели, чем у тех, что вылупились ранее.";

::Const.Strings.PerkDescription.NggHEggAttachSpider <- "'Грустно, когда у тебя нет ног. Иметь пару ног было бы здорово. По крайней мере, вы можете попросить своих друзей-пауков подвезти вас на себе.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Даёт способность садиться на пауков или на некоторых других существ, таких как боевые псы, волкодавы, волки.";
// spider
::Const.Strings.PerkDescription.NggH_Spider_Bite <- "'Сильный укус паука, способный пробить самую крепкую и прочную броню.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Укус паука[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Укус красного паука[/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Даёт [color=" + ::Const.UI.Color.DamageValue + "]1[/color]-[color=" + ::Const.UI.Color.DamageValue + "]5[/color] к урону от атак."
		+ "\n• Цель получает на [color=" + ::Const.UI.Color.PositiveValue + "]+15%[/color] больше любого урона, игнорирующего броню."
		+ "\n• Имеет [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] шанс стать пробивающей атакой, которая полностью игнорирует броню.";

::Const.Strings.PerkDescription.NggH_Spider_Venom <- "'Ещё более смертоносный яд, ваша бедная жертва наверняка умрет быстрее.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Эффект [color=" + ::Const.UI.Color.NegativeValue + "]Отравлен[/color], наложенный укусом персонажа, продлится на 1 ход дольше."
		+ "\n• Эффект [color=" + ::Const.UI.Color.NegativeValue + "]Отравлен красным пауком[/color], наложенный укусом персонажа, наносит увеличенный на [color=" + ::Const.UI.Color.PositiveValue + "]20%[/color] урон [b](минимум 1)[/b]."
		+ "\n• Каждый уровень эффектов [color=" + ::Const.UI.Color.NegativeValue + "]Отравлен[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Отравлен красным пауком[/color] увеличивает расход выносливости поражённого противника на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color]."
		+ "\n• Увеличивает урон от умений [color=" + ::Const.UI.Color.NegativeValue + "]Укус сетеплёта[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Укус красного паука[/color] на [color=" + ::Const.UI.Color.PositiveValue + "]2%[/color] за каждый уровень эффектов [color=" + ::Const.UI.Color.NegativeValue + "]Отравлен[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Отравлен красным пауком[/color] поражённого противника."
		+ "\n• Наносит на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color] больше урона нежити."; //, но если они обездвижены с помощью сети, лозы или паутины, то бонус увеличивается до [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] вместо этого.";

::Const.Strings.PerkDescription.NggH_Spider_Web <- "'Овладейте умением плести и создавать паутину, и вы сможете создавать самую прочную паутину без особых усилий.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Плетение паутины[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Чем больше у персонажа выносливости, тем труднее врагу вырваться из паутины."
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Снижает время ожидания до [color=" + ::Const.UI.Color.NegativeValue + "]1[/color] хода.";

::Const.Strings.PerkDescription.NggH_Spider_ToughCarapace <- "'Лучше любой пластинчатой брони.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Броня получает на [color=" + ::Const.UI.Color.PositiveValue + "]50%[/color] меньше урона."
		+ "\n• Уменьшает входящий урон, игнорирующий броню, на [color=" + ::Const.UI.Color.PositiveValue + "]33%[/color].";
// serpent
::Const.Strings.PerkDescription.NggHSerpentBite <- "'Молниеносная атака, которая может нанести более мощный укус.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Змеиный укус[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Затрачивает только [color=" + ::Const.UI.Color.PositiveValue + "]4[/color] ОД."
		+ "\n• Урон от атак увеличивается на [color=" + ::Const.UI.Color.DamageValue + "]8[/color]-[color=" + ::Const.UI.Color.DamageValue + "]15[/color] единиц."
		+ "\n• Эффективность против брони увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]15%[/color].";

::Const.Strings.PerkDescription.NggHSerpentDrag <- "'С сильными мышцами любая добыча может быть легко обезврежена в этом нерушимом захвате.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Змеиное волочение[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Увеличивает максимальную дальность на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] клеток."
		+ "\n• Также наносит до [color=" + ::Const.UI.Color.DamageValue + "]15[/color] проникающего урона.";

::Const.Strings.PerkDescription.NggHSerpentVenom <- "'Эволюционируйте, чтобы получить ядовитую железу для отравления добычи. Смертельно, но действует недолго.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Укус аспида[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Наносит дополнительно [color=" + ::Const.UI.Color.DamageValue + "]20[/color] урона ядом за ход."
		+ "\n• Эффект [color=" + ::Const.UI.Color.NegativeValue + "]отравления[/color], накладываемый этим навыком, длится только 1 ход.";

::Const.Strings.PerkDescription.NggHSerpentGiant <- "'Что может быть страшнее большой змеи? Гигантская змея!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Змеиное волочение[/color] имеет шанс [color=" + ::Const.UI.Color.PositiveValue + "]обезоружить[/color] перетаскиваемую цель, основанный на показателе навыка ближнего боя."
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Змеиное волочение[/color] позволяет перетаскивать союзников с невосприимчивостью к отталкиванию и захвату."
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Укус аспида[/color] имеет увеличенную на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] дальность атаки.";
// hyena
::Const.Strings.PerkDescription.NggHHyenaBite <- "'Бритвенно-острые клыки, способные создавать ужасные кровоточащие раны.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Укус Гиены[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Урон от атаки увеличивается на [color=" + ::Const.UI.Color.DamageValue + "]30[/color] единиц."
		+ "\n• Эффективность против брони увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color]."
		+ "\n• Урон от кровотечения, наносимый укусами, увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5[/color] единиц.";
// wolf
::Const.Strings.PerkDescription.NggHWolfBite <- "'Мощные челюстные мышцы и крепкие клыки, пробивающие броню и разрывающие плоть на части.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Укус лютоволка[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Урон от атак увеличивается на [color=" + ::Const.UI.Color.DamageValue + "]10[/color] единиц."
		+ "\n• Эффективность против брони увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]35%[/color].";

::Const.Strings.PerkDescription.NggHWolfThickHide <- "'Густой и прочный мех, который может остановить атаки и не получить серьезных повреждений.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Даёт на [color=" + ::Const.UI.Color.PositiveValue + "]15%[/color] меньше урона по броне."
		+ "\n• Даёт по [color=" + ::Const.UI.Color.PositiveValue + "]75[/color] очков естественной брони к показателям брони головы и тела.";

::Const.Strings.PerkDescription.NggHWolfEnrage <- "'Быстрые и яростные атаки, которые не оставляют ошеломленной жертве возможности убежать или дать отпор.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nДаёт следующие бонусы за каждый уровень эффекта [color=" + ::Const.UI.Color.NegativeValue + "]Ошеломление[/color]:\n"
		+ "\n• Шанс попадания увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color]."
		+ "\n• Урон от атак увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color]."
		+ "\n• Цель получает на [color=" + ::Const.UI.Color.PositiveValue + "]+2%[/color] больше любого урона, игнорирующего броню.";

::Const.Strings.PerkDescription.NggHWolfRabies <- "'У вашего щенка бешенство. Это нехорошо, верно? Не надо гладить его!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Урон от атак увеличен на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color]."
		+ "\n• Навык ближнего боя увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5[/color] единиц."
		+ "\n• ОЗ увеличиваются на [color=" + ::Const.UI.Color.PositiveValue + "]20[/color] единиц."
		+ "\n• Решимость увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]20[/color] единиц.";
// alp
::Const.Strings.PerkDescription.NggHAlpNightmareSpec <- "'Питайся страхом и ужасом своей жертвы, чтобы восстановить собственную жизненную силу.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Кошмар[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Даёт прибавку к урону, равную [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color] текущей решимости персонажа."
		+ "\n• Восстанавливает ОЗ до [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] от нанесённого урона.";

::Const.Strings.PerkDescription.NggHAlpSleepSpec <- "'Овладейте способностью усыплять свою добычу.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Сон[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Увеличивает шанс усыпить цель на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color] от текущей решимости."
		+ "\n• Уменьшает затраты ОД на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color].";

::Const.Strings.PerkDescription.NggHAlpAfterWake <- "'Жертву, разбуженную кошмаром, легко сломить.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Кошмар[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Игнорирует до [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color] решимости цели."
		+ "\n• Имеет [color=" + ::Const.UI.Color.PositiveValue + "]33%[/color] шанс не разбудить цель."
		+ "\n• Когда эффект [color=" + ::Const.UI.Color.NegativeValue + "]Сон[/color] снимается от атаки, происходит отрицательная проверка боевого духа для спящей цели.";

::Const.Strings.PerkDescription.NggHAlpAfterimage <- "'Стань более раздражающим, чем когда-либо.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nПосле телепортации любым способом, накладывает следующий эффект:\n"
		+ "\n• Накладывает эффект [color=" + ::Const.UI.Color.NegativeValue + "]Послесловие[/color], который дает [color=" + ::Const.UI.Color.PositiveValue + "]+15[/color] к навыкам ближнего и дальнего боя и длится до начала следующего хода."
		+ "\n• Каждый дополнительный уровень эффекта [color=" + ::Const.UI.Color.NegativeValue + "]Послесловие[/color] даёт только [color=" + ::Const.UI.Color.PositiveValue + "]+5[/color] к навыкам ближнего и дальнего боя."; 

::Const.Strings.PerkDescription.NggHAlpLivingNightmare <- "'Что может быть страшнее кошмара? Кошмар вне сна.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Кошмар[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Имеет шанс породить живой кошмар при убийстве врага."
		+ "\n• Шанс зависит от того, сколько раз персонаж использовал умение [color=" + ::Const.UI.Color.NegativeValue + "]Кошмар[/color] на одной и той же цели.";

::Const.Strings.PerkDescription.NggHAlpMindBreak <- "'Определенно не какая-то грязная хрень из хентая.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 4 ОД и 8 выносливости."
		+ "\n• Наносит [color=" + ::Const.UI.Color.DamageValue + "]5[/color] - [color=" + ::Const.UI.Color.DamageValue + "]10[/color] урона, игнорируя броню."
		+ "\n• Накладывает эффект [color=" + ::Const.UI.Color.NegativeValue + "]Сломанный разум[/color], который снижает решимость цели на [color=" + ::Const.UI.Color.PositiveValue + "]5[/color] единиц."
		+ "\n• Эффект [color=" + ::Const.UI.Color.NegativeValue + "]Сломанный разум[/color] длится до 3-х ходов и может быть усилен.";
// demon alp
::Const.Strings.PerkDescription.NggHAlpControlFlame <- "'Лучший контроль над огнем, лучшая безопасность для вас. Будьте осторожны, если у вас больше двух демонов-альпов, их огонь может перекрыть друг друга.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Царство пылающих кошмаров[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Пламя не причиняет вреда заклинателю.";

::Const.Strings.PerkDescription.NggHAlpFieceFlame <- "'Бушующее пламя, способное сжечь все. Ад здесь!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Царство пылающих кошмаров[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Увеличивает урон от огня на [color=" + ::Const.UI.Color.DamageValue + "]5[/color]-[color=" + ::Const.UI.Color.DamageValue + "]20[/color] единиц."
		+ "\n• Урон от огня может вызвать ужасные ожоговые раны."
		+ "\n• Продолжительность пламени уменьшена [color=" + ::Const.UI.Color.NegativeValue + "]вдвое[/color].";

::Const.Strings.PerkDescription.NggHAlpHellishFlame <- "'Вам может понравиться 'Адская кухня', но я сомневаюсь, что вам понравится 'Адский огонь'."
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Царство пылающих кошмаров[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Наносит урон огнем, как только используется умение."
		+ "\n• Увеличивает урон от огня на [color=" + ::Const.UI.Color.DamageValue + "]5[/color]-[color=" + ::Const.UI.Color.DamageValue + "]12[/color] единиц.";

::Const.Strings.PerkDescription.NggHAlpShadowCopy <- "'Два лучше, чем один.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 7 ОД и 45 выносливости."
		+ "\n• Позволяет охватить огромную область ([color=" + ::Const.UI.Color.PositiveValue + "]7[/color] клеток) тьмой, которая длится [color=" + ::Const.UI.Color.PositiveValue + "]3[/color] хода."
		+ "\n• Порождает монстра из кошмаров в пределах тьмы, если его ещё нет на поле боя."
		+ "\n• В начале следующего хода на одной из клеток, поглощённых тьмой, возродится монстр из кошмаров, если его убили в текущем ходу.";
// nacho
::Const.Strings.PerkDescription.NggHNacho <- "'Овладей своими упыриными способностями.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Максимальная выносливость увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color]."
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Бешенство[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Когти бледного упыря[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Когти вурдалака[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Жуткий пир[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Сожрать заживо[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Подбросить[/color] потребляют на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости.";

::Const.Strings.PerkDescription.NggHNachoEat <- "'Ешь и будь сильным! О, да!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nПрименяет нижеприведенные эффекты при каждом использовании умения [color=" + ::Const.UI.Color.NegativeValue + "]Жуткий пир[/color]:\n"
		+ "\n• Урон от атак увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color]."
		+ "\n• Восстановление выносливости за ход увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]5[/color] единиц."
		+ "\n• Решимость увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]10[/color] единиц."
		+ "\n• Эффект длится [color=" + ::Const.UI.Color.PositiveValue + "]2[/color] хода.";

::Const.Strings.PerkDescription.NggHNachoFrenzy <- "'Жажда крови.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 3 ОД и 25 выносливости."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+15%[/color] к урону от атак."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+15%[/color] к навыку ближнего боя."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+50%[/color] к инициативе."
		+ "\n• Снижает на [color=" + ::Const.UI.Color.NegativeValue + "]-50%[/color] защиту в ближнем бою."
		+ "\n• Даёт невосприимчивость к [color=" + ::Const.UI.Color.PositiveValue + "]Оглушению[/color]."
		+ "\n• Даёт невосприимчивость к [color=" + ::Const.UI.Color.PositiveValue + "]отталкиванию[/color] или [color=" + ::Const.UI.Color.PositiveValue + "]захвату[/color]."
		+ "\n• Все активные умения затрачивают на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] меньше ОД."
		+ "\n• Накладывает эффект [color=" + ::Const.UI.Color.NegativeValue + "]Подавлен[/color] (даже если персонаж не изучил навык [color=" + ::Const.UI.Color.NegativeValue + "]Подавление[/color])."
		+ "\n• Эффект длится [color=" + ::Const.UI.Color.PositiveValue + "]2[/color] хода.";

::Const.Strings.PerkDescription.NggHNachoVomit <- "'У-у-у-у-у-о-о-о-о-о!'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 6 ОД и 15 выносливости."
		+ "\n• Позволяет 'последней трапезе' выбраться из желудка."
		+ "\n• Нельзя использовать умение [color=" + ::Const.UI.Color.NegativeValue + "]Сожрать заживо[/color] до следующего хода после использования этого умения.";

::Const.Strings.PerkDescription.NggHNachoBigTummy <- "'Больший живот означает больший бонус к защите.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nДаёт следующие эффекты, пока у персонажа есть эффект [color=" + ::Const.UI.Color.NegativeValue + "]Пожрал[/color]:\n"
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+25%[/color] к решимости."
		+ "\n• Получаемый урон уменьшается на [color=" + ::Const.UI.Color.PositiveValue + "]15%[/color]. Не влияет на урон от ментальных атак или статусных эффектов.";

::Const.Strings.PerkDescription.NggHNachoScavenger <- "'Пир после работы! Не возражайте, если я это сделаю.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Питается остатками трупов после окончания боя и при этом получает эффект [color=" + ::Const.UI.Color.NegativeValue + "]Сытый[/color]."
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Эффект сытости:[/u][/color]"
		+ "\n• [color=" + ::Const.UI.Color.NegativeValue + "]+25%[/color] к одному из этих показателей: максимум ОД, максимум выносливости, решимость, инициатива, навык ближнего боя, защита в ближнем бою, урон в ближнем бою, прирост опыта."
		+ "\n• [color=" + ::Const.UI.Color.PositiveValue + "]-25%[/color] к ежедневному потреблению пищи."
		+ "\n• Действует до конца текущей битвы.";
// unhold
::Const.Strings.PerkDescription.NggH_Unhold_Grapple <- "'Схвати противника и брось его на землю.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 5 ОД и 35 выносливости."
		+ "\n• Если противник [color=" + ::Const.UI.Color.NegativeValue + "]невосприимчив к захвату и отталкиванию[/color], то он теряет выносливость и удерживается в течение 2-х ходов с шансом на обезоруживание."
		+ "\n• Если противник не имеет [color=" + ::Const.UI.Color.NegativeValue + "]невосприимчивости к захвату и отталкиванию[/color], то он три раза подряд будет ударена об землю, получая урон в зависимости от тяжести брони."
		+ "\n• Может также использоваться для выкорчевывания деревьев или поднятия валунов.";

::Const.Strings.PerkDescription.NggH_Unhold_UnarmedAttack <- "'Изучите основы рукопашного боя.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 6 ОД и 18 выносливости."
		+ "\n• Простое атакующее умение, направленое на одну цель."
		+ "\n• Имеет [color=" + ::Const.UI.Color.NegativeValue + "]100%[/color] шанс ошеломить цель при попадании.";

::Const.Strings.PerkDescription.NggH_Unhold_UnarmedTraining <- "'Сосредоточившись на технике, порядке и стойке, вы стали лучше контролировать свои удары без оружия.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Увеличивает урон [b](максимум 75)[/b] от умений [color=" + ::Const.UI.Color.NegativeValue + "]Рукопашная[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Размашистый удар[/color] на [color=" + ::Const.UI.Color.PositiveValue + "]3%[/color] от текущих ОЗ персонажа."
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Схватить[/color] имеет [color=" + ::Const.UI.Color.NegativeValue + "]25%[/color] шанс отвлечь цель при попадании."

::Const.Strings.PerkDescription.NggH_Unhold_SpecFists <- "'Овладейте искусством безоружного боя'."
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Рукопашная[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Схватить[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Размашистый удар[/color] потребляют на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Увеличивает шанс попадания для умения [color=" + ::Const.UI.Color.NegativeValue + "]Рукопашная[/color] на [color=" + ::Const.UI.Color.PositiveValue + "]5%[/color]."
		+ "\n• Увеличивает урон по выносливости для умения [color=" + ::Const.UI.Color.NegativeValue + "]Рукопашная[/color]."
		+ "\n• Увеличивает шанс попадания и шанс обезоруживания для умения [color=" + ::Const.UI.Color.NegativeValue + "]Схватить[/color]."

::Const.Strings.PerkDescription.NggH_Unhold_Fling <- "'Когда от броска можно долететь до луны.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Отбрасывание[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Затрачивает только [color=" + ::Const.UI.Color.PositiveValue + "]3[/color] ОД при использовании."
		+ "\n• Накладывает на цель эффект [color=" + ::Const.UI.Color.NegativeValue + "]Выбит дух[/color] при попадании.";
// schrat
::Const.Strings.PerkDescription.NggHSchratShield <- "'Опыт и инстинкт дали вам лучшее понимание того, как выращивать и использовать щит более эффективно.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Вырастить щит[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Вырастить могучий щит[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Накладывает эффект [color=" + ::Const.UI.Color.NegativeValue + "]Стена щитов[/color] при использовании.";

::Const.Strings.PerkDescription.NggHSchratSapling <- "'Наполненная жизнью сломанная часть тела может легко возродиться в разумного саженца.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Увеличивает шанс породить саженца после получения удара на [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color]."
		+ "\n• Саженцы могут управляться непосредственно игроком.";

::Const.Strings.PerkDescription.NggHSchratUproot <- "'Сильнее корень, чтобы сделать более серьезную рану.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Оплетение[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Расколоть землю[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Урон от атак увеличивается на [color=" + ::Const.UI.Color.DamageValue + "]5[/color]-[color=" + ::Const.UI.Color.DamageValue + "]15[/color] единиц."
		+ "\n• Эффективность против брони увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color].";

::Const.Strings.PerkDescription.NggHSchratUprootAoE <- "'Атака извержением земли, посылающая каменные осколки повсюду.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 6 ОД и 25 выносливости."
		+ "\n• Может поразить до 6-ти целей."
		+ "\n• [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color] к шансу на попадание."
		+ "\n• Снимает эффекты [color=" + ::Const.UI.Color.NegativeValue + "]Стена копий[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Стена щитов[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Контратака[/color] со всех рядом стоящих персонажей.";
// lindwurm
::Const.Strings.PerkDescription.NggHLindwurmAcid <- "'Хм, да! Дракон, плюющийся кислотой.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 5 ОД, 60 ОЗ и 30 выносливости."
		+ "\n• Имеет радиус действия в [color=" + ::Const.UI.Color.PositiveValue + "]3[/color] клетки."
		+ "\n• Покрывает цель и всех, кто находится рядом, кислотной кровью, создавая тяжёлые ожоговые раны, расплавляя любую броню."
		+ "\n• Может наложить эффект [color=" + ::Const.UI.Color.NegativeValue + "]Ослеплён[/color], если атака попадает в голову.";

::Const.Strings.PerkDescription.NggHLindwurmIntimidate <- "'Напугай их своей огромной шн... в смысле змеёй.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 7 ОД и 36 выносливости."
		+ "\n• При использовании, вызывает проверку боевого духа у любого врага в радиусе 3-х клеток."
		+ "\n• Снижает до [color=" + ::Const.UI.Color.PositiveValue + "]20%[/color] навыки ближнего и дальнего боя, защиту ближнего и дальнего боя и решимость любого врага в радиусе 3-х клеток."
		+ "\n• Этот эффект длится только [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] ход.";

::Const.Strings.PerkDescription.NggHLindwurmBody <- "'Сильнее - значит лучше.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Пожирание[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Хвостовой порог[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Взмах хвостом[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Выпад хвостом[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости."
		+ "\n• Урон от атак увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]10%[/color].";
// kraken
::Const.Strings.PerkDescription.NggHKrakenBite <- "'Ваш укус становится более опасным с острыми зубами, которые могут легко нанести тяжелое кровотечение.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Укус[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Урон от атак увеличивается на [color=" + ::Const.UI.Color.PositiveValue + "]8[/color]-[color=" + ::Const.UI.Color.PositiveValue + "]18[/color] единиц."
		+ "\n• Наносит дополнительно [color=" + ::Const.UI.Color.PositiveValue + "]5[/color] урона от кровотечения.";

::Const.Strings.PerkDescription.NggHKrakenDevour <- "'Голоднее, чем когда-либо.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые умения:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Пожирать[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Полностью отменяет время ожидания."
		+ "\n• При использовании восстанавливает [color=" + ::Const.UI.Color.PositiveValue + "]25[/color]-[color=" + ::Const.UI.Color.PositiveValue + "]40[/color] ОЗ всем щупальцам.";

::Const.Strings.PerkDescription.NggHKrakenEnsnare <- "'Когда вы думаете, что быть притащенным в большую щелкающую пасть достаточно плохо, теперь представьте, что вас выжимают до мякоти, прежде чем съесть.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Умение [color=" + ::Const.UI.Color.NegativeValue + "]Сдавить добычу[/color] наносит на [color=" + ::Const.UI.Color.PositiveValue + "]35%[/color] больше урона, это также применяется к урону с течением времени, пока персонаж удерживается щупальцем.";

::Const.Strings.PerkDescription.NggHKrakenMove <- "'С помощью природной слизи ваши щупальца смогут двигаться лучше, чем когда-либо. И тут определённо нет ничего странного.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Щупальца потребляют на [color=" + ::Const.UI.Color.PositiveValue + "]2[/color] меньше выносливости за каждую пройденную клетку."
		+ "\n• У умения [color=" + ::Const.UI.Color.NegativeValue + "]Переместить щупальце[/color] на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] клетку увеличивается максимальный радиус действия.";

::Const.Strings.PerkDescription.NggHKrakenSwing <- "'Существует ли лучшее применение щупальцам, чем просто размахивать ими?.. Стоп! Мы не говорим об этом.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 5 ОД и 36 выносливости."
		+ "\n• Может поразить до 3-х целей одновременно."
		+ "\n• Только для ваших щупалец.";

::Const.Strings.PerkDescription.NggHKrakenTentacle <- "'Ваша кожа похожа на резину или, может быть, на латекс?! Она способна отражать атаки и её труднее порезать.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Уменьшает весь получаемый урон на [color=" + ::Const.UI.Color.PositiveValue + "]15[/color] единиц."
		+ "\n• Даёт невосприимчивость к кровотечению.";
// mounting
::Const.Strings.PerkDescription.NggHGoblinMountTraining <- "'Научись ездить верхом.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Даёт способность садиться верхом на боевого пса, волкодава и волка.";

::Const.Strings.PerkDescription.NggHGoblinMountedArchery <- "'Узнайте, как правильно использовать стрелковое оружие, сидя верхом на скакуне.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nДаёт следующие эффекты, пока персонаж сидит верхом на скакуне:\n"
		+ "\n• Снимает штраф к урону в дальнем бою."
		+ "\n• Снижает штраф к навыку дальнего боя с [color=" + ::Const.UI.Color.NegativeValue + "]-35%[/color] до [color=" + ::Const.UI.Color.PositiveValue + "]-15%[/color]."
		+ "\n• Метательное оружие получает дополнительный урон, если у персонажа есть эффект [color=" + ::Const.UI.Color.NegativeValue + "]Верховой натиск[/color].";

::Const.Strings.PerkDescription.LegendHorseLiberty = "'Благодаря длительным тренировкам по круговой тренировке, скакун доверяет движениям всадника.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nДаёт следующие эффекты, пока персонаж сидит верхом на скакуне:\n"
		+ "\n• Увеличивает решимость на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color]."
		+ "\n• Потребляет на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше выносливости за каждую пройденную клетку."; 

::Const.Strings.PerkDescription.NggHGoblinMountedCharge <- "'Прорывайте строй врага весом и скоростью скакуна.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Уменьшает количество клеток, которые нужно пройти, чтобы накопить полную мощность натиска."
		+ "\n• Увеличивает бонус от эффекта [color=" + ::Const.UI.Color.NegativeValue + "]Верховой натиск[/color] на [color=" + ::Const.UI.Color.PositiveValue + "]+25%[/color] от первоначального бонуса.";
// ghost
::Const.Strings.PerkDescription.NggHGhostGhastlyTouch <- "'Моё прикосновение одновременно быстрое и смертоносное!!!'" 
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Затрагиваемые навыки:[/u][/color] [color=" + ::Const.UI.Color.NegativeValue + "]Прикосновение ужаса[/color]"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Затрачивает на [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] меньше ОД."
		+ "\n• Даёт [color=" + ::Const.UI.Color.DamageValue + "]0[/color] - [color=" + ::Const.UI.Color.DamageValue + "]5[/color] к урону от атак."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+5%[/color] у шансу на попадание.";

::Const.Strings.PerkDescription.NggHGhostSpectralBody <- "'Вы как бесформенная движущаяся тень - вряд ли кто-то сможет попасть по вам.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Все входящие атаки ближнего боя имеют [color=" + ::Const.UI.Color.PositiveValue + "]-10%[/color] к шансу на попадание."
		+ "\n• Даёт полную неуязвимость ко всем атакам дальнего боя.";

::Const.Strings.PerkDescription.NggHGhostVanish <- "'Я был там несколько секунд назад, а теперь я здесь.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• При получении урона персонаж автоматически телепортируется в другое место, которое в большинстве случаев находится на расстоянии 2-3 клеток от врагов.";

::Const.Strings.PerkDescription.NggHGhostPhase <- "'Что вы думаете, когда встречаете призрака и видите, как он проходит сквозь ваше тело?'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 6 ОД и 0 выносливости."
		+ "\n• Позволяет атаковать до 2-х целей, одновременно перемещаясь сквозь эти цели."
		+ "\n• Наносит урон, игнорирующий броню.";

::Const.Strings.PerkDescription.NggHGhostSoulEater <- "'Призрак питается душой живого существа? Звучит пугающе.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Умения [color=" + ::Const.UI.Color.NegativeValue + "]Прикосновение ужаса[/color], [color=" + ::Const.UI.Color.NegativeValue + "]Полёт сквозь[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]Крик баньши[/color] имеют [color=" + ::Const.UI.Color.PositiveValue + "]33%[/color] шанс восстановить жизнь для навыка [color=" + ::Const.UI.Color.NegativeValue + "]Девять жизней[/color] после убийства врага.";
// misc
::Const.Strings.PerkDescription.NggHMiscLineBreaker <- "'Мясная стена не остановит тебя, просто прорвись сквозь неё грубой силой.'"
	+ "\n\n[color=" + ::Const.UI.Color.Active + "][u]Активные эффекты:[/u][/color]"
		+ "\n• Затрачивает 4 ОД и 30 выносливости."
		+ "\n• Позволяет прорваться сквозь оборону противника и добраться до тех, кто находится на задней линии.";

::Const.Strings.PerkDescription.NggHMiscChampion <- "'Самые сильные из сильнейших в своем роде.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Дарует [color=" + ::Const.UI.Color.NegativeValue + "]чемпиону[/color] расовое умение.";

::Const.Strings.PerkDescription.NggHMiscDaytime <- "'Нечего бояться света. Прими его!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Значительно уменьшает штраф от эффекта [color=" + ::Const.UI.Color.NegativeValue + "]дневного времени[/color]."
		+ "\n• Увеличивает решимость на [color=" + ::Const.UI.Color.PositiveValue + "]10[/color] единиц.";

::Const.Strings.PerkDescription.NggHMiscNighttime <- "'Ночь - твоё время.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nДаёт эффект [color=" + ::Const.UI.Color.NegativeValue + "]Ночной[/color], который имеет следующие эффекты:\n"
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+5%[/color] к урону от атак."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color] к защите в ближнем бою."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+10%[/color] к защите в дальнем бою."
		+ "\n• Не подвержен эффекту [color=" + ::Const.UI.Color.NegativeValue + "]Ночное время[/color].";

::Const.Strings.PerkDescription.NggHMiscFairGame <- "'Справедливый обмен.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+25[/color] к навыку ближнего боя."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]+25[/color] к навыку дальнего боя."
		+ "\n• Атаки персонажа наносят либо [color=" + ::Const.UI.Color.PositiveValue + "]на 50%[/color] больше урона, либо [color=" + ::Const.UI.Color.NegativeValue + "]на 50%[/color] меньше урона.";
// simp
::Const.Strings.PerkDescription.NggH_Simp_NoFoodOnlyLove <- "'Мне никогда не будет достаточно.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nПрименяет следующие эффекты, пока имеет хотя бы [color=" + ::Const.UI.Color.NegativeValue + "]1-й уровень простака[/color]:\n"
		+ "\n• Уменьшает опыт, получаемый в бою, на [color=" + ::Const.UI.Color.NegativeValue + "]50%[/color]."
		+ "\n• Уменьшает потребление пищи до [color=" + ::Const.UI.Color.PositiveValue + "]0[/color]."
		+ "\n• Возвращает потраченное очко навыка, когда персонаж достигает [color=" + ::Const.UI.Color.NegativeValue + "]10-го уровня простака[/color].";

::Const.Strings.PerkDescription.NggH_Simp_Bodyguard <- "'Горжусь, что защищаю мою истинную любовь!'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\nПрименяет следующие эффекты, находясь на расстоянии до 3-х клеток от [color=" + ::Const.UI.Color.NegativeValue + "]ведьмы[/color] или [color=" + ::Const.UI.Color.NegativeValue + "]верховной ведьмы[/color]:\n"
		+ "\n• Увеличивает на [color=" + ::Const.UI.Color.PositiveValue + "]x%[/color] навыки ближнего и дальнего боя, защиты в ближнем и дальнем бою и решимость."
		+ "\n• [color=" + ::Const.UI.Color.PositiveValue + "]x[/color] равно [color=" + ::Const.UI.Color.NegativeValue + "](3 + уровень простака)[/color]."

::Const.Strings.PerkDescription.NggH_Simp_UndyingLove <- "'Любовь слепа, и в данном случае это не очень хорошо.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Изучив этот навык, персонаж сразу же получает [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] уровень простака."
		+ "\n• Уровень простака не может быть ниже [color=" + ::Const.UI.Color.NegativeValue + "]1[/color]."
		+ "\n• Персонаж всегда начинает бой с [color=" + ::Const.UI.Color.PositiveValue + "]уверенным[/color] боевым духом, находясь рядом с [color=" + ::Const.UI.Color.NegativeValue + "]верховной ведьмой[/color] или простой [color=" + ::Const.UI.Color.NegativeValue + "]ведьмой[/color].";

::Const.Strings.PerkDescription.NggH_Simp_LevelUp <- "'Простота бесконечна в своей недалёкости. Лишь самый глупый... то есть самый лучший простак может выжить.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• Изучив этот навык, персонаж немедленно получает [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] уровень простака."
		+ "\n• Даёт [color=" + ::Const.UI.Color.PositiveValue + "]1[/color] уровень простака за каждые [color=" + ::Const.UI.Color.NegativeValue + "]2[/color] уровня, полученные персонажем в будущем после изучения этого навыка.";

// basilisk
::Const.Strings.PerkDescription.NggH_Basilisk_AimTheHead <- "'Бей по голове, бей на поражение.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
		+ "\n• За каждое успешное попадание в голову персонаж получает уровень 'Целься в голову'."
		+ "\n• Каждый уровень 'Целься в голову' даёт [color=" + ::Const.UI.Color.PositiveValue + "]+12.5%[/color] к урону при попадании в голову. Бонус удваивается, если у персонажа есть навык [color=" + ::Const.UI.Color.NegativeValue + "]Охотник за головами[/color]."
		+ "\n• При достижении шестого уровня или более, уровень будет сброшен до [color=" + ::Const.UI.Color.NegativeValue + "]1[/color]. [color=" + ::Const.UI.Color.NegativeValue + "]Попадание в тело[/color] сбросит уровень до [color=" + ::Const.UI.Color.NegativeValue + "]0[/color]";

// add more 
::Const.Strings.PerkDescription.LegendLithe = "'Средняя броня обеспечивает оптимальное сочетание подвижности и защиты.'"
	+ "\n\n[color=" + ::Const.UI.Color.Passive + "][u]Пассивные эффекты:[/u][/color]"
	+ "\n\n[color=" + ::Const.UI.Color.NegativeValue + "][u]Люди и гуманоиды:[/u][/color]"
		+ "\n• Требуется, чтобы у этого персонажа было снаряжение с общим весом брони головы и тела между [color=" + ::Const.UI.Color.NegativeValue + "]25[/color] и [color=" + ::Const.UI.Color.NegativeValue + "]35[/color]."
		+ "\n• Весь входящий урон по броне и ОЗ уменьшается на [color=" + ::Const.UI.Color.PositiveValue + "]30%[/color]."
		+ "\n• За пределами указанного выше диапазона веса бонус снижается экспоненциально. По мере того, как броня получает урон, бонус медленно снижается до половины своего максимального значения."
	+ "\n\n[color=" + ::Const.UI.Color.NegativeValue + "][u]Другие персонажи:[/u][/color]"
		+ "\n• Получают на [color=" + ::Const.UI.Color.PositiveValue + "]25%[/color] меньше урона от большинства источников.";
