this.jin_warning_on_road_event <- this.inherit("scripts/events/event", {
	m = {
		IsDone = false
    },
	function create()
	{
		this.m.ID = "event.jin_warning_on_road";
		this.m.Title = "По дороге...";
		this.m.Cooldown = 9999.0 * this.World.getTime().SecondsPerDay;
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_41.png[/img]{Вы встречаете караван на привале. Четыре телеги с тканями и пряностями, полдюжины охранников, возницы - но никто не пьёт и не смеётся: сидят у костра, перешёптываются, то и дело оглядываются на дорогу. Дородный купец в запылённом камзоле замечает вас и машет рукой, приглашая подойти.%SPEECH_ON%Слава богам, живые люди. Мы уже думали, что в этих краях остались одни призраки да эти... железные люди.%SPEECH_OFF%Он кивает в сторону дороги, смахивает пот со лба.%SPEECH_ON%Шли через Западный тракт. Три дня назад, на рассвете, увидели их на холме - человек двадцать, все вооружены, в латах из мелких пластин, как рыбья чешуя, блестят на солнце, как серебро. Шлемы с козырьками, лиц не разглядеть. Молча стояли, смотрели на нас. Думал, сейчас нападут. А они постояли, один из них поднял руку - и все ушли. Мы ещё час боялись дышать. Поехали дальше своей дорогой - она вела к Кривому Ручью.%SPEECH_OFF%Купец морщится.%SPEECH_ON%На околице снова увидели их. Стоят на площади, вокруг - трупы, все бандиты, до последнего вырезаны. А дома целы, скот не тронут, даже амбар заперт - будто вошли не грабить, а защищать деревеньку от бандитов. Но мы увидели и другое. На краю деревни лежал старик в луже собственной крови. Один из железных людей стоял рядом, что-то говорил своим на непонятном языке - а после просто перешагнул через тело, будто через камень на дороге, и пошёл дальше.%SPEECH_OFF%Купец качает головой.%SPEECH_ON%Одна из сельчан потом нам рассказала, что старик вышел на них с вилами, кричал, чтобы убирались с его земли. Затем он ударил вилами в грудь ближайшему - зубья скользнули по пластинам, не оставив и царапины. В ответ его убили одним выстрелом, но не из лука или арбалета, а огненной трубки.%SPEECH_OFF%Он пожимает плечами.%SPEECH_ON%Вот тогда я и понял: клинком их не взять, а стрелки у них изрыгают огонь из длинных трубок - эту диковину я даже видеть больше не хочу. Пленных не берут, не грабят, но убивают любого на пути - без криков, без угроз, просто делают то, зачем пришли. Какой-то странный этот народ.%SPEECH_OFF%Караван собирается в путь. Купец улыбается на прощание, улыбка выходит напряжённой.%SPEECH_ON%Совет тебе, наёмник: держись от них подальше. Они не звери, что вырезают деревни поголовно, - но и не люди, с которыми можно сговориться. Не свернут, не остановятся - просто снесут тебя, если окажешься у них на пути. Встретишь их - поклонись издалека и иди своей дорогой, не смотри им в глаза. Я смотрел и до сих пор чудится, что они следят за мной. Удачи тебе.%SPEECH_OFF%Он отворачивается к дороге. Как вдруг где-то вдали гудит колокол - медный, низкий, долгий. Караванщики вздрагивают, торопливо запрягают повозки и уезжают.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Интересная информация.",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			    _event.m.IsDone = true;
			}

		});
	}

	function isValid()
	{
		if (this.m.IsDone)
		{
			return false;
		}

		if (this.World.getTime().Days < 70) return false;
		local currentTile = this.World.State.getPlayer().getTile();

		if (!currentTile.HasRoad)
		{
			return false;
		}

		return true;

	}

	function onPrepare()
	{
	}

	function onPrepareVariables( _vars )
	{
	}

	function onDetermineStartScreen()
	{
        return "A";
	}

	function onClear()
	{
	}

	function onSerialize( _out )
	{
		this.event.onSerialize(_out);
		_out.writeBool(this.m.IsDone);
	}

	function onDeserialize( _in )
	{
		this.event.onDeserialize(_in);

		if (_in.getMetaData().getVersion() >= 54)
		{
			this.m.IsDone = _in.readBool();
		}
	}

});

