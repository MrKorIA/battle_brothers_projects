this.locksmith_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_locksmith";
		this.m.Name = "Взломщик";
		this.m.Icon = "ui/backgrounds/background_locksmith.png";
		this.m.BackgroundDescription = "Взломщики - незаменимые мастера в тех случаях, когда одной лишь грубой силы не хватает, чтобы отпереть заклинившие ворота, вековые усыпальницы или сундуки с сокровищами.";
        this.m.GoodEnding = "В отряде \'%companyname%\' %name% оказался на удивление полезен - и не столько в бою, сколько после него. Пока товарищи считали трофеи и делили добычу, он вскрывал всё, что было заперто: сундуки, ларцы, подвалы, а однажды, по слухам, и герцогскую усыпальницу. За неё отряд едва не лишился головы - зато разжился на пару лет вперёд. Говорят, в конце концов он осел где-то на юге, купил дом и открыл слесарную мастерскую - но к старости всё равно не мог пройти мимо чужого замка, чтобы не прикинуть, сколько времени уйдёт на его вскрытие.";
        this.m.BadEnding = "Взломщик %name% покинул отряд \'%companyname%\' после одной особенно удачной вылазки - решил, что наконец накопил на безбедную жизнь и не желает больше рисковать головой. Где именно он осел и как жил, неизвестно, но поговаривают, что кончил он на виселице. Всё вышло по его же ремеслу: он забрался в чужой дом и принялся вскрывать сундук, не заметив, что крышка соединена с колокольчиком. Хозяева проснулись, стража подоспела, а сундук так и остался запертым - последним замком, который %name% не сумел открыть.";
		this.m.HiringCost = 80;
		this.m.DailyCost = 7;
		this.m.Excluded = [
			"trait.bloodthirsty",
			"trait.brute",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.dumb",
			"trait.fat",
			"trait.hate_beasts",
			"trait.hate_greenskins",
			"trait.hate_undead",
			"trait.hesitant",
			"trait.huge",
			"trait.insecure",
			"trait.loyal",
			"trait.night_blind",
			"trait.paranoid",
			"trait.short_sighted",
			"trait.strong",
			"trait.teamplayer"
		];
		this.m.Titles = [
			"Хранитель ключей",
			"Взломщик",
			"Изготовитель ключей",
			"Ловкий",
			"Взломщик замков",
			"Проворный"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.TidyMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.Tidy;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsLowborn = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{Потомственный слесарь, %name% с детства обладал особым чутьём на тугие замки, неподатливые сундуки и хитроумные засовы, скрывающие чужие сокровища. | %name% выучился слесарному делу у старого мастера, который, по слухам, за всю жизнь так и не встретил замка, которого не смог бы открыть - пока смерть не заперла его самого на засов, что оказался ему не по силам. | Начав с починки амбарных замков за гроши, %name% быстро понял, что вскрывать замки на чужих сундуках куда прибыльнее, чем их чинить на дверях. | Ходят слухи, что %name% однажды по случайности заперся в собственной мастерской - и именно тогда обнаружил в себе истинный дар к отпиранию замков. | %name% зарабатывал на жизнь мирным ремеслом слесаря, пока однажды не понял, что вскрывать замки куда увлекательнее, чем их изготавливать.} {Но тяжёлые времена, обрушившиеся на его родной город, оставили взломщика почти без работы: у обедневших горожан попросту не осталось ничего, что стоило бы запирать. | Но, когда в город пришёл более расторопный конкурент, готовый работать за медяки, клиентура быстро иссякла, а вместе с ней и заработок. | Скучающий среди амбарных замков и хлипких засовов провинциальных должников, он давно мечтал о находке, достойной его истинного таланта. | После череды удачных заказов местный лорд заподозрил в нём не слесаря, а грабителя, и посоветовал искать удачи где-нибудь подальше от его земель.} {Теперь он ищет удачи в отряде наёмников, надеясь, что дикие земли скрывают сундуки и хранилища, ещё не тронутые ничьей отмычкой. | Он щурится на любой висячий замок, случайно попавшийся на пути, будто оценивая, сколько времени уйдёт на его вскрытие. | Связка отмычек на его поясе выглядит куда более потрёпанной от использования, чем меч, которым он якобы владеет. | Он признаётся, что понятия не имеет, как сражаться с людьми - но уверяет, что с любым сундуком, который встретится отряду, разберётся в считанные минуты. | Он не силён в бою, зато нет такой двери, монастырской раки или окованного сундука, перед которым он спасовал бы.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [0, 0]
			Bravery = [0, 0]
			Stamina = [0, 0]
			MeleeSkill = [0, 2]
			RangedSkill = [0, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [4, 4]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		items.equip(this.new("scripts/items/armor/linen_tunic"));
	}

});

