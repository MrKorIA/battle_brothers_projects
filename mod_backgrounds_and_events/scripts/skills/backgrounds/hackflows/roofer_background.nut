this.roofer_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_roofer";
		this.m.Name = "Кровельщик";
		this.m.Icon = "ui/backgrounds/background_roofer.png";
		this.m.BackgroundDescription = "Проводя долгие часы на шатких лестницах и крутых крышах, кровельщики привыкают виртуозно держать равновесие и начисто лишены страха высоты.";
		this.m.GoodEnding = "Всякий раз, когда вам случается ночевать под протекающей крышей, вы вспоминаете кровельщика %name% - и невольно улыбаетесь. После войны он вернулся в родной город, где половина домов стояла без кровли, и за пару лет собрал вокруг себя артель подмастерьев; ныне его черепицу ставят даже на дома знати, и берут за неё втридорога. Сам он лишь посмеивается: дескать, зима своё возьмёт с любого, у кого крыша хуже, чем у соседа.";
        this.m.BadEnding = "Поговаривают, что кровельщик %name% встретил свой конец на крыше, - и в этом, если вдуматься, есть своя насмешка. Ночью он полез чинить кровлю постоялого двора, а утром его нашли у стен того самого двора с пробитой головой. То ли черепица оказалась гнилой, то ли балка - скользкой от росы; как бы там ни было, человек, всю жизнь чинивший чужие крыши, не уберёг в итоге собственную голову.";
		this.m.HiringCost = 330;
		this.m.DailyCost = 6;
		this.m.Excluded = [
			"trait.ailing",
			"trait.asthmatic",
			"trait.bleeder",
			"trait.bright",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.craven",
			"trait.fainthearted",
			"trait.fat",
			"trait.fragile",
			"trait.hate_undead",
			"trait.night_blind",
			"trait.tiny",
			"trait.weasel"
		];
		this.m.Titles = [
			"Кровельщик",
			"Верхолаз",
			"Черепичник",
			"Кровельщик"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.CommonMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.All;
		this.m.Bodies = this.Const.Bodies.Muscular;
		this.m.IsLowborn = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{%name% всю жизнь занимался тем же ремеслом, что и его отец: осматривал, укладывал и менял кровлю, чтобы дома стояли крепко, а холод оставался снаружи. | %name% выучился кровельному делу у соседа-мастера, который брал его в подмастерья не из щедрости, а за неимением своих сыновей. | Не имея учителя, %name% годами перенимал ремесло по кусочкам - подглядывая за работой других кровельщиков и набивая шишки на собственной крыше. | %name% с детства лазил по крышам родного города не по надобности, а из чистого любопытства, пока это баловство однажды не превратилось в настоящее ремесло. | %name% - потомственный кровельщик в третьем поколении: дед чинил соломенные крыши, отец перешёл на черепицу, а сам он не видел смысла останавливаться на достигнутом.} {Но в последнее время люди куда больше озабочены тем, чтобы прокормить себя, нежели содержанием крыши над головой. | Но голод, охвативший округу после неурожайного года, оставил людям заботы посерьёзнее протекающей кровли. | Но война, докатившаяся до его родного города, сделала свежую черепицу последней вещью, на которую у горожан находились деньги. | Но со временем даже самые состоятельные из его прежних заказчиков вдруг начали считать каждую монету, и кровельные работы одна за другой откладывались на неопределённый срок.} {Кровельщик ворчит, что зима, так или иначе, придёт снова, и однажды люди пожалеют, что оставили его без работы. | Он бормочет себе под нос, что промокшие насквозь дома скоро научат горожан ценить хорошую крышу заново - жаль только, что его самого рядом уже не будет. | Он до сих пор носит с собой старый молоток и горсть гвоздей - на всякий случай, вдруг кому-то в отряде понадобится залатать крышу над головой. | Он говорит, что починка дома и людей не так уж сильно отличается - в обоих случаях главное вовремя заметить течь, пока не стало слишком поздно.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [2, 2]
			Bravery = [0, 0]
			Stamina = [5, 10]
			MeleeSkill = [0, 0]
			RangedSkill = [0, 0]
			MeleeDefense = [4, 6]
			RangedDefense = [0, 0]
			Initiative = [-3, -3]
		};
		return c;
	}

	function onSetAppearance()
	{
		local actor = this.getContainer().getActor();
		local dirt = actor.getSprite("dirt");
		dirt.Visible = true;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		items.equip(this.new("scripts/items/armor/linen_tunic"));
	}

});

