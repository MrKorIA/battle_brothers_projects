this.surgeon_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_surgeon";
		this.m.Name = "Хирург";
		this.m.Icon = "ui/backgrounds/background_surgeon.png";
		this.m.BackgroundDescription = "Искусные лекари - редкая находка, ведь у них всегда по горло работы с латанием раненых солдат и покалеченных крестьян. Эти мастера привыкли к виду хлещущей крови и не теряют самообладания в самом жутком хаосе, однако их собственные боевые навыки оставляют желать лучшего.";
        this.m.GoodEnding = "Из всех людей, с которыми вы познакомились в отряде \'%companyname%\', именно хирург %name% оставил самый глубокий след - и не только на теле, но и на душе. Ходили слухи, что он открыл в столице небольшую лечебницу, где принимал равно и знатных, и нищих, и что очередь к нему стоит длиннее, чем к иным придворным докторам. Впрочем, поговаривали также, что по ночам он всё ещё пишет трактат о ранах, несовместимых с жизнью, - и что рукопись эта растёт куда быстрее, чем ему хотелось бы.";
        this.m.BadEnding = "Покинув отряд \'%companyname%\', хирург %name% вскоре нашёл место при дворе одного барона - и, казалось бы, судьба наконец улыбнулась ему. Но однажды ночью ему пришлось выбирать между жизнью юного наследника и жизнью простого конюха, и он выбрал наследника. Конюх умер, а через месяц умер и наследник - от той же хвори, что хирург не сумел распознать вовремя. Барон, потеряв сына, велел повесить лекаря на воротах замка - {к северу | к югу | к западу | к востоку} отсюда, в назидание всем, кто мнит себя умнее знати.";
		this.m.HiringCost = 100;
		this.m.DailyCost = 8;
		this.m.Excluded = [
			"trait.iron_jaw",
			"trait.tough",
			"trait.strong",
			"trait.cocky",
			"trait.brute",
			"trait.clumsy",
			"trait.fat",
			"trait.deathwish",
			"trait.athletic"
		];
		this.m.Titles = [
			"Резака",
			"Доктор",
			"Док",
			"Медик"
		];
		this.m.Faces = this.Const.Faces.SmartMale;
		this.m.Hairs = this.Const.Hair.TidyMale;
		this.m.HairColors = this.Const.HairColors.Young;
		this.m.Beards = this.Const.Beards.All;
		this.m.Bodies = this.Const.Bodies.Skinny;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{Учёные лекари - редкая ценность в наши смутные времена, и %name% - один из немногих, кто действительно заслуживает этого звания: годами он служил полковым медиком в армиях знати, спасая жизни бессчётного числа солдат. | %name% обучался медицине в одном из лучших городских училищ, прежде чем получить место лекаря при войске знатного дома. | Сын деревенского костоправа, %name% превзошёл отцовское ремесло настолько, что был замечен и приглашён служить лекарем в армию одного из знатных домов. | %name% годами постигал искусство врачевания по старым трактатам и собственным экспериментам, пока военная нужда в опытных лекарях не открыла ему путь на службу к знати. | Прежде чем стать военным медиком, %name% немало практиковался на простых горожанах - за меньшую плату, но с не меньшим тщанием.} {Но однажды ему не удалось спасти аристократа одного знатного дома, и, несмотря на годы безупречной службы, он был с позором изгнан. | Но придворные интриги оказались опаснее любого поля боя: завистливые коллеги обвинили его в некомпетентности, и он лишился места, толком не успев оправдаться. | Но ложное обвинение в краже дорогих снадобий из полкового лазарета стоило ему не только должности, но и доброго имени. | Но, отказавшись пожертвовать раненым простолюдином ради спасения знатного офицера с меньшими шансами выжить, он навлёк на себя гнев командования и был отстранён от службы.} {Лишившись прежних ресурсов и помощников для совершения прежних чудес, %name% теперь ищет куда более скромной доли - лекаря при отряде наёмников. | По его словам, он давно созрел для настоящих приключений - хотя, глядя на его аккуратно разложенные инструменты, вы сомневаетесь, что он до конца понимает, во что ввязывается. | Несмотря на скромность нынешнего положения, руки его остаются такими же твёрдыми, а взгляд - таким же цепким, как и во времена службы в армии.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [0, 0]
			Bravery = [4, 4]
			Stamina = [0, 0]
			MeleeSkill = [4, 4]
			RangedSkill = [0, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [0, 0]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		items.equip(this.new("scripts/items/armor/butcher_apron"));
	}

});

