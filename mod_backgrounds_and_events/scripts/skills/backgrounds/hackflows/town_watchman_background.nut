this.town_watchman_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_town_watchman";
		this.m.Name = "Стражник";
		this.m.Icon = "ui/backgrounds/background_town_watchman.png";
		this.m.BackgroundDescription = "Магистраты и городские старосты нанимают стражников, дабы те поддерживали порядок внутри стен и вовремя замечали грозящие поселению опасности.";
		this.m.GoodEnding = "Прошли годы, и вы уже не надеялись услышать вестей о старом стражнике, как вдруг получили письмо, написанное корявым, но твёрдым почерком. %name% писал, что осел в маленьком городке на границе, где его наняли обучать ополчение дозорному делу. \'Эти остолопы спят на посту так же, как когда-то я\', - жаловался он, но между строк сквозила гордость: за зиму его ученики дважды замечали разбойничьи ватаги ещё на подходе. \'Может, из меня и вышёл никудышный стражник, - заканчивал он, - но учитель из меня выйдет хороший, пока глаза видят и совесть не до конца уснула\'. Кажется, он наконец смотрит не вдаль, а в будущее.";
        this.m.BadEnding = "Всю жизнь %name% высматривал угрозу издалека, но так и не научился замечать ту, что растёт в нём самом. В отряде \'%companyname%\' он прослыл человеком, который никогда не спит и всегда бьёт тревогу первым - вот только тревога эта всё чаще звучала в его собственной голове. Однажды на ночном дежурстве, приняв тени деревьев за подкрадывающийся отряд, он выстрелил по своим же дозорным. Когда всё стихло, он долго смотрел на дело рук своих, а потом снял с пояса рог и выкинул его куда подальше. {Его нашли повесившимся на собственной перевязи неподалёку от лагеря, лицом в ту сторону, откуда он ждал врага. | Он ушёл в лес и сгинул без следа: то ли разбойники, то ли собственные призраки довершили начатое. | Он до конца стоял на стене уже разрушенного городка, куда его никто не звал, и умер, так и не поняв, что защищать больше нечего.}";
		this.m.HiringCost = 75;
		this.m.DailyCost = 8;
		this.m.Excluded = [
			"trait.asthmatic",
			"trait.clubfooted",
			"trait.craven",
			"trait.dastard",
			"trait.fat",
			"trait.hate_undead",
			"trait.insecure",
			"trait.night_blind",
			"trait.short_sighted"
		];
		this.m.Titles = [
			"Надзиратель",
			"Наблюдатель",
			"Городской стражник",
			"Сова",
			"Патрульный",
			"Часовой"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.CommonMale;
		this.m.HairColors = this.Const.HairColors.Young;
		this.m.Beards = this.Const.Beards.All;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsLowborn = true;
	}

	function onBuildDescription()
	{
        return "{Чтобы дать врагу отпор, нужно сперва заметить его приближение - именно этим и занимался %name%, городской страж, чьей обязанностью было высматривать угрозы издалека и поднимать ополчение по тревоге. | %name% стал стражем не по призванию, а по случайности - когда прежний дозорный состарился и оглох, выбор пал на молодого парня с острым зрением. | Немолодой уже %name% всю жизнь провёл на городской стене, сменив не одно поколение начальников, но так и не утратив бдительности, за которую его ценили горожане. | %name% гордился своей должностью городского стража больше, чем иной дворянин своим титулом - ведь от его внимательности зависела жизнь всего города.} {Но однажды ночью, после городского праздника, %name% был слишком пьян, чтобы заметить подкравшихся разбойников, и последовавшие потери легли на его совесть непосильным грузом, вынудив оставить пост. | Но сморённый усталостью после долгой бессонной недели, он однажды задремал на посту - и город заплатил за эту дрёму сгоревшими амбарами и разграбленными лавками. Городской совет недолго думал, прежде чем выгнать его со службы. | Но, приняв стаю перелётных птиц за условный сигнал тревоги, он поднял ложную тревогу настолько убедительно, что в следующий раз горожане уже не поверили его настоящему предупреждению - и поплатились за это. \'Не поверили - сами и виноваты\', - ворчит он, ничуть не раскаиваясь: \'Каждый сам за себя, мне с этими дураками больше не по пути.\' | Но несколько лет спокойной службы притупили его бдительность настолько, что он попросту перестал верить в реальность угрозы - пока разбойничий отряд беспрепятственно не проскользнул мимо его поста. Когда с башни наконец заметили пожар в нижнем городе, он в панике бросил свой пост и бежал, даже не подняв тревогу.} {Теперь он ищет место в отряде наёмников, прекрасно понимая, что такие отряды регулярно охотятся на разбойников у самого их логова. | Он говорит, что с него хватит высматривать врага издалека - пришло время встретить его лицом к лицу, с оружием в руках. | Раз уж стены больше не под его присмотром, он решил, что разумнее самому охотиться на разбойников - тем более что это куда прибыльнее, чем стоять на страже.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [0, 3]
			Bravery = [-3, 5]
			Stamina = [5, 5]
			MeleeSkill = [5, 5]
			RangedSkill = [6, 7]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [0, 5]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		local weapons = [
			"weapons/bludgeon",
			"weapons/wooden_stick",
			"weapons/militia_spear"
		];
		items.equip(this.new("scripts/items/" + weapons[this.Math.rand(0, weapons.len() - 1)]));

		if (this.Math.rand(1, 100) <= 50)
		{
			items.equip(this.new("scripts/items/shields/buckler_shield"));
		}

		r = this.Math.rand(0, 2);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/armor/leather_tunic"));
		}
		else if (r == 1)
		{
			items.equip(this.new("scripts/items/armor/thick_tunic"));
		}
		else if (r == 2)
		{
			items.equip(this.new("scripts/items/armor/padded_surcoat"));
		}

		r = this.Math.rand(0, 2);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/helmets/hood"));
		}
		else if (r == 1)
		{
			items.equip(this.new("scripts/items/helmets/straw_hat"));
		}
		else if (r == 2)
		{
			items.equip(this.new("scripts/items/helmets/open_leather_cap"));
		}
	}

});

