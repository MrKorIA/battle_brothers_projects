this.cartographer_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_cartographer";
		this.m.Name = "Картограф";
		this.m.Icon = "ui/backgrounds/background_cartographer.png";
		this.m.BackgroundDescription = "Картографы специализируются на создании точных карт. В отличие от историков, они не понаслышке знакомы с тяготами походной жизни, которые разделили во время долгих странствий с купеческими караванами ради составления карт неизведанных земель.";
        this.m.GoodEnding = "Покинув отряд \'%companyname%\', %name% добрался до земель, которых не было ни на одной известной карте. Он месяцами отмечал реки, дороги и горные перевалы, пока не составил карту, за которую богатый купец предложил ему целое состояние. Деньги он взял, но почти сразу потратил на новую экспедицию: слишком много ещё оставалось неизведанного. Говорят, он вновь ушёл в путь с чистым листом пергамента и парой наёмников для охраны, и каждая новая карта лишь добавляет ему белых пятен.";
        this.m.BadEnding = "Покинув отряд \'%companyname%\', %name% отправился исследовать земли, о которых ходили лишь смутные слухи. Несколько месяцев спустя один купец привёз вам карту, снятую с тела безымянного путника у горного перевала. Дороги, реки и перевалы были нанесены на ней с редкой точностью, а в самом центре стояла короткая надпись: \'Здесь кончается путь\'. Тело так и не опознали, но картографа с тех пор никто не видел, а место его гибели теперь обходят стороной даже караванщики.";
		this.m.HiringCost = 30;
		this.m.DailyCost = 8;
		this.m.Excluded = [
			"trait.athletic",
			"trait.bloodthirsty",
			"trait.brute",
			"trait.cocky",
			"trait.dexterous",
			"trait.dumb",
			"trait.hate_beasts",
			"trait.impatient",
			"trait.iron_jaw",
			"trait.iron_lungs",
			"trait.irrational",
			"trait.spartan",
			"trait.strong",
			"trait.superstitious",
			"trait.tough"
		];
		this.m.Titles = [
			"Прилежный",
			"Картограф",
			"Первооткрыватель",
			"Чертежник",
			"Наблюдательный"
		];
		this.m.Faces = this.Const.Faces.SmartMale;
		this.m.Hairs = this.Const.Hair.TidyMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.Tidy;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsOffendedByViolence = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{С рождения одолеваемый хронической хворью, %name% так и не смог вырасти крепким и здоровым, как большинство сверстников. Не сумев вступить в ополчение и защищать родной город наравне с другими, он сносил презрение соседей молча. | %name% с детства был слишком тщедушен для меча или копья, и односельчане открыто считали его обузой, а не защитником. | %name% рос слабым и болезненным ребёнком в семье потомственных воинов, и разочарование отца в его немощи было заметно всем и каждому. | Тщедушное телосложение %name% вызывало у соседей лишь насмешки - какой из него защитник, если он едва способен унести собственный вес без снаряжения.} {Измученный стыдом, который, как ему казалось, он навлекал на своих близких, он однажды рискнул жизнью, чтобы составить карту окрестностей - и обнаружил на ней логово разбойников. Эти сведения оказались решающими при отражении следующего набега, и насмешки быстро сменились похвалой в его адрес. | Устав от косых взглядов, он тайком прокрался за отступающими разбойниками до самого их лагеря и вычертил точную карту подступов - благодаря ей ополчение застало бандитов врасплох и разгромило их без потерь. | Желая доказать свою полезность хоть в чём-то, он взялся рисовать карты окрестных болот, отмечая безопасные тропы там, где прежде терялись целые отряды - карта спасла не одну жизнь. | Стремясь загладить позор, который он якобы навлекал на своих близких, %name% в одиночку обошёл окрестные пещеры и составил подробные схемы туннелей, которыми позже воспользовались при облаве на логово контрабандистов. | Не в силах держать оружие, он решил доказать свою пользу иначе - составленная им карта бродов через реку помогла отряду перехватить разбойников там, где те меньше всего этого ожидали.} {Теперь он хочет наносить на карты земли, ещё не открытые человеком. Скорее ему бы самому стоило нанять отряд наёмников, чем наниматься в него - но всё же, размышляете вы, неплохо иметь в отряде ещё одну светлую голову. | Насмешки остались в прошлом - теперь он мечтает составить карту земель, где ещё не ступала нога картографа. Вам %name% скорее нужен как наниматель, чем как боец, но лишний умник в отряде всяко не помешает. | Военное дело по-прежнему не для него, зато его умение читать местность способно уберечь отряд от засад и лишних потерь. | Он честно признаётся, что толку от него в ближнем бою немного - зато карта, начерченная его рукой, порой стоит дороже дюжины мечей.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [-10, -5]
			Bravery = [-2, -2]
			Stamina = [-3, -3]
			MeleeSkill = [0, 0]
			RangedSkill = [0, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [0, 0]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		items.equip(this.new("scripts/items/armor/linen_tunic"));
		r = this.Math.rand(0, 3);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/helmets/feathered_hat"));
		}
	}

});

