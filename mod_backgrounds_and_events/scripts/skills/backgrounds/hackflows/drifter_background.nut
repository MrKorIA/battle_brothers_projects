this.drifter_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_drifter";
		this.m.Name = "Бездомный";
		this.m.Icon = "ui/backgrounds/background_drifter.png";
		this.m.BackgroundDescription = "Бездомные лишились крыши над головой по самым разным причинам. Скитаясь от поселения к поселению, они вынуждены браться за любую случайную работу, лишь бы раздобыть корку хлеба и не умереть с голоду.";
        this.m.GoodEnding = "Из отряда \'%companyname%\' %name% не ушёл ни через год, ни через пять - и, к удивлению многих, оказался именно тем, кем его никто не считал: человеком, который в конце концов нашёл своё дело. Начал он с простых обязанностей, потом научился держать строй, читать следы и ставить караулы, а к старости сделался чем-то вроде квартирмейстера: не герой, не командир, но тот, без кого отряд уже не выходит в поход. Поговаривают, впрочем, что и сам он до конца не был уверен, что нашёл своё место, - но после стольких лет ему уже не хотелось искать другое.";
        this.m.BadEnding = "%name% продержался в отряде \'%companyname%\' недолго - и погиб так же незаметно, как и жил до этого. В одной из первых стычек {к северу | к югу | к западу | к востоку} отсюда он упал во время отступления, а остальные были слишком заняты собственной жизнью, чтобы вернуться за ним. Тело его так и не нашли: после боя таких, как он, обычно некому хоронить. В родном городке о его смерти, скорее всего, даже не узнали - а если и узнали, то через столько времени, что новость уже никого не удивила.";
		this.m.HiringCost = 90;
		this.m.DailyCost = 6;
		this.m.Excluded = [
			"trait.asthmatic",
			"trait.bloodthirsty",
			"trait.brave",
			"trait.brute",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.fat",
			"trait.gluttonous",
			"trait.hesitant",
			"trait.iron_jaw",
			"trait.short_sighted",
		];
		this.m.Titles = [
			"Бродяга",
			"Грязнуля",
			"Изгой",
			"Быстроногий",
			"Странник",
			"Бездомный"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.CommonMale;
		this.m.HairColors = this.Const.HairColors.Young;
		this.m.Beards = this.Const.Beards.All;
		this.m.Bodies = this.Const.Bodies.Skinny;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{Третий ребёнок в семье небогатого купца, %name% провёл большую часть юности, бездумно растрачивая время на пустячные забавы. | %name% рос младшим из пятерых детей мельника, и до серьёзного дела руки у него, признаться, так и не дошли. | Сын зажиточного трактирщика, %name% с детства ни в чём не нуждался - и именно поэтому так и не научился хоть чему-то полезному. | %name% был средним ребёнком в большой крестьянской семье, и старшие братья привыкли всё делать за него, пока он предавался бесцельным мечтаниям. | Выросший при небольшой мануфактуре отца, %name% так и не проявил интереса ни к одному из ремёсел, которым его пытались обучить. | %name% с юности слыл в родном городке человеком приятным, но совершенно ни на что не годным - в отцовском деле от него было мало толку, да и родня давно махнула на него рукой.} {Когда отец умер, его старший брат принял на себя семейное дело, оставив ему лишь горстку монет на жизнь. С тех пор, не имея никакой цели в жизни, %name% скитается в её поисках. | Когда семейное дело унаследовал старший из братьев, для него попросту не нашлось места в общем деле - с небольшой суммой денег в кармане он отправился куда глаза глядят. | Семейное дело после смерти отца досталось младшей сестре, обладавшей куда более цепкой хваткой, чем он, а %name% получил в наследство лишь скромную сумму денег и открытую дорогу в никуда. | Когда отец умер, семейное хозяйство разделили между более расторопными братьями, а %name% получил свою долю деньгами - и с тех пор от неё уже почти ничего не осталось. | Семейное дело отца пришлось продать за долги, и вырученных денег хватило лишь на то, чтобы %name% мог какое-то время скитаться без определённой цели.} {В его взгляде читается лёгкая пустота. Впрочем, неважно - ваш отряд видел и менее способных бойцов в строю щитов. | Взгляд его выдаёт человека, толком не знающего, как он вообще здесь оказался - но, по правде говоря, отряду случалось нанимать бойцов и с куда более пустым взором. | Он выглядит слегка потерянным, но вы повидали достаточно новобранцев, чтобы это вас не смущало. | Определённой цели в его глазах не читается, но стоять и ходить он вроде умеет, а этого для начала вполне достаточно.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [-4, 2]
			Bravery = [0, 0]
			Stamina = [6, 8]
			MeleeSkill = [0, 0]
			RangedSkill = [0, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 3]
			Initiative = [5, 5]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		r = this.Math.rand(0, 4);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/armor/noble_tunic"));
		}
		else
		{
			items.equip(this.new("scripts/items/armor/linen_tunic"));
		}

		r = this.Math.rand(0, 3);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/helmets/feathered_hat"));
		}
	}

});

