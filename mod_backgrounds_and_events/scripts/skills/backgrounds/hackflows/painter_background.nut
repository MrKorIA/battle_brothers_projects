this.painter_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_painter";
		this.m.Name = "Художник";
        this.m.Icon = "ui/backgrounds/background_painter.png";
        this.m.BackgroundDescription = "Совершенно не приспособленные к тяготам боя и суровой лагерной реальности, художники всё же умеют создавать прекрасные полотна, способные хоть ненадолго рассеять беспросветную серость этих тёмных времён.";
        this.m.GoodEnding = "После нескольких лет, проведённых в отряде \'%companyname%\', %name% снова взялся за кисть. Только теперь он писал не закаты и зелёные холмы, а то, что действительно знал: лагеря наёмников, разбитые деревни и людей, возвращавшихся с войны. Одна из его картин попала в руки старого дворянина, потерявшего на войне сына, и тот заплатил за неё больше, чем %name% когда-либо получал. Вскоре другие ветераны начали заказывать у него картины, чтобы сохранить память о тех, кто не вернулся, и %name% наконец нашёл своё место в мире искусства.";
        this.m.BadEnding = "Когда %name% покинул отряд \'%companyname%\', он решил, что война наконец дала ему то, чего не смогла дать мирная жизнь: достойный сюжет. Он начал рисовать сцены сражений, тела павших и лица тех, кто пережил бой, надеясь продать эти картины богатым любителям мрачных зрелищ. Говорят, одна из его картин настолько понравилась влиятельному заказчику, что тот велел художнику написать ещё одну, уже с его собственной головой среди мёртвых. Больше о художнике никто ничего не слышал, зато его последняя картина вскоре стала пользоваться большим спросом.";
		this.m.HiringCost = 140;
		this.m.DailyCost = 9;
		this.m.Excluded = [
			"trait.athletic",
			"trait.bloodthirsty",
			"trait.brute",
			"trait.cocky",
			"trait.dexterous",
			"trait.dumb",
			"trait.hate_beasts",
			"trait.huge",
			"trait.impatient",
			"trait.iron_jaw",
			"trait.iron_lungs",
			"trait.irrational",
			"trait.paranoid",
			"trait.spartan",
			"trait.strong",
			"trait.superstitious",
			"trait.sure_footing",
			"trait.tough"
		];
		this.m.Titles = [
			"Художник",
			"Художник",
			"Творец",
			"Ремесленник"
		];
		this.m.Faces = this.Const.Faces.SmartMale;
		this.m.Hairs = this.Const.Hair.TidyMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.Tidy;
		this.m.Bodies = this.Const.Bodies.Thick;
		this.m.IsOffendedByViolence = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{В лучшие времена %name% писал прекрасные пейзажи и продавал их богатым ценителям искусства. | %name% учился живописи у придворного мастера, надеясь однажды писать портреты знати, а не продавать пейзажи на площади. | Не имея учителя, %name% годами разбирал секреты смешивания красок сам, пока не научился писать закаты, от которых, по слухам, у зрителей наворачивались слёзы. | Ещё мальчишкой %name% зарабатывал на хлеб, малюя вывески для лавок, пока однажды один пейзаж, написанный от скуки, не купил заезжий коллекционер за неожиданно щедрую сумму.} {Но в эти тяжёлые времена спрос на подобное искусство иссяк без следа. | Но война, докатившаяся до его родного города, оставила богатых покровителей либо разорёнными, либо мёртвыми, либо слишком напуганными, чтобы думать о живописи. | Но мода на пейзажи прошла так же быстро, как пришла, и коллекционеры внезапно принялись скупать исключительно портреты - ремесло, которым он так и не овладел. | Но наплыв более модных художников с юга вытеснил его с рынка, и заказы иссякли один за другим. | Но один влиятельный покровитель, недовольный тем, как вышел его портрет, публично ославил его бездарью - и с тех пор ни один уважающий себя коллекционер не желал иметь с ним дела.} Не имея других мирских умений, незадачливый художник был вынужден податься в наёмники. {Выглядит он, признаться, довольно хрупко, но, похоже, обращаться с мечом умеет не хуже любого другого. | Он утверждает, что немало повидал в жизни, прежде чем взяться за кисть, и то, как он держит оружие, пожалуй, не даёт повода сомневаться в этом. | Хрупкое телосложение обманчиво: стойка, в которую он встаёт с мечом в руке, выдаёт нечто большее, чем случайное баловство с оружием. | Он смущённо признаётся, что рисовать людей ему всегда удавалось лучше после того, как своими глазами видел, что способно сотворить оружие с человеческим телом.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [-8, -4]
			Bravery = [-5, 5]
			Stamina = [-2, 0]
			MeleeSkill = [0, 0]
			RangedSkill = [0, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [0, 5]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		items.equip(this.new("scripts/items/armor/linen_tunic"));
	}

});

