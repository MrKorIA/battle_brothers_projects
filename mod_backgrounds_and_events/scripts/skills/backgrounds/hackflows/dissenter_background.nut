this.dissenter_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_dissenter";
		this.m.Name = "Смутьян";
		this.m.Icon = "ui/backgrounds/background_dissenter.png";
		this.m.BackgroundDescription = "Смутьяны органически не способны держать язык за зубами. Они часто ищут убежища в наёмных отрядах, силясь спасти свои шкуры от наёмных убийц, подосланных оскорблёнными лордами или городскими властями.";
        this.m.GoodEnding = "%name% провёл в отряде \'%companyname%\' не один год - и меч в его руках наконец сделал то, чего не сделали годы речей. Поговаривают, что он объявился в родных краях во главе небольшой шайки, состоящей сплошь из таких же обездоленных, и что местный лорд, некогда не замечавший его, теперь вынужден держать при себе вдвое больше стражи. Никакой революции у него, разумеется, не вышло, но односельчане до сих пор повторяют его слова - вполголоса, озираются, но повторяют.";
        this.m.BadEnding = "%name% покинул отряд \'%companyname%\', едва накопив достаточно крон, чтобы собрать вокруг себя людей и наконец поднять настоящий бунт. По слухам, за ним пошло не то двадцать человек, не то тридцать, и вместе они двинулись к усадьбе ненавистного им лорда. Бунт закончился за один вечер: часть людей перебили стражники, остальных схватили и повесили на следующий день. Сам %name% был казнён на площади при большой толпе народа - и те самые люди, ради которых он всё это затевал, молча смотрели на его смерть.";
		this.m.HiringCost = 80;
		this.m.DailyCost = 5;
		this.m.Excluded = [
			"trait.ailing",
			"trait.asthmatic",
			"trait.athletic",
			"trait.bloodthirsty",
			"trait.brute",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.craven",
			"trait.dastard",
			"trait.dexterous",
			"trait.disloyal",
			"trait.drunkard",
			"trait.fainthearted",
			"trait.fat",
			"trait.fear_beasts",
			"trait.fear_greenskins",
			"trait.fear_undead",
			"trait.gluttonous",
			"trait.greedy",
			"trait.hate_beasts",
			"trait.hate_greenskins",
			"trait.hate_undead",
			"trait.hesitant",
			"trait.huge",
			"trait.insecure",
			"trait.iron_jaw",
			"trait.optimist",
			"trait.pessimist",
			"trait.strong",
			"trait.survivor",
			"trait.teamplayer",
			"trait.weasel"
		];
		this.m.Titles = [
			"Раскольник",
			"Горлопан",
			"Несносный",
			"Острослов",
			"Правдоруб"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.UntidyMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.Untidy;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsOffendedByViolence = true;
		this.m.IsLowborn = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{После того как его отца казнили без суда за преступление, которого тот не совершал, а мать сожгли на костре по ложному обвинению, %name% преисполнился абсолютной ненавистью к знати. | %name% с детства наблюдал, как лорд год за годом обирал его деревню налогами, пока голод не унёс половину соседей - с тех пор он не может смотреть на дворянский герб без отвращения. | %name% поклялся однажды посчитаться со всей знатью разом, когда лорд забрал его единственного брата в свою армию и отправил его умирать в войне, которая была нужна лишь самому лорду. | Несправедливый суд лорда отобрал землю и дом у %name%, обвинив его в долге, которого никогда не существовало - с тех пор он поклялся, что однажды знать заплатит за всё. | %name% рос при дворе слугой, наблюдая вблизи, с какой лёгкостью знать распоряжается чужими жизнями за закрытыми дверями - и с годами это наблюдение превратилось в жгучую ненависть.} {Не обладая ни силой, ни умением, чтобы самому убивать королей, он проводит время, призывая простой люд восстать и свергнуть существующий порядок. Однако его речи в основном пропадают впустую. Вы полагаете, что %name% до сих пор жив лишь потому, что никто из власть имущих не воспринимает его всерьёз как угрозу. | Он выкрикивает свои лозунги на каждом рынке и у каждой таверны, но крестьяне давно научились просто обходить его стороной. Вы подозреваете, что именно поэтому лорды до сих пор не утруждают себя тем, чтобы заткнуть его навсегда. | Односельчане слушают его вполуха, а стражники и вовсе не утруждают себя арестом - выглядит он слишком безобидно, чтобы принимать его всерьёз. | Годы агитации так и не собрали вокруг него сколько-нибудь заметной толпы последователей - вы подозреваете, что именно поэтому ни один лорд до сих пор не счёл нужным избавиться от него.} {Словно прочитав ваши мысли, смутьян говорит, что именно по этой причине он и ищет отряд наёмников. | Будто угадав, о чём вы думаете, он с горькой усмешкой добавляет, что именно поэтому решил присоединиться к наёмникам - с мечом в руках его наконец начнут воспринимать как настоящую угрозу. | Он словно читает ваше сомнение по лицу и тут же поясняет: раз слова не пугают знать, придётся попробовать что-то более убедительное. | Он ухмыляется, будто заранее знал, о чём вы подумали, и говорит, что меч в его руках заставит хотя бы кого-то отнестись к его словам всерьёз.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [0, 0]
			Bravery = [15, 23]
			Stamina = [0, 0]
			MeleeSkill = [0, 0]
			RangedSkill = [0, 0]
			MeleeDefense = [-3, -3]
			RangedDefense = [-1, 1]
			Initiative = [0, 0]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		r = this.Math.rand(0, 1);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/armor/tattered_sackcloth"));
		}

		if (r == 1)
		{
			items.equip(this.new("scripts/items/armor/leather_wraps"));
		}
	}

});

