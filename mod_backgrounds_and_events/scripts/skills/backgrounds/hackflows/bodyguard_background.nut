this.bodyguard_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_bodyguard";
		this.m.Name = "Телохранитель";
		this.m.Icon = "ui/backgrounds/background_bodyguard.png";
		this.m.BackgroundDescription = "Телохранители - это крепкие мужчины, чей единственный долг: защищать важных персон и любой ценой спасать их от смерти.";
        this.m.GoodEnding = "Покинув отряд \'%companyname%\', %name% всё-таки нашёл человека, достойного его защиты. Вы слышали, что теперь он стоит за плечом молодого купеческого сына, который в одиночку не пережил бы и недели на здешних дорогах. Говорят, подопечный уже трижды должен был умереть, но каждый раз между ним и клинком оказывалась широкая спина верного телохранителя. Платят телохранителю немного, зато он снова чувствует, что прикрывает кого-то не зря, и не променял бы это ни на какие кроны.";
        this.m.BadEnding = "Покинув отряд \'%companyname%\', %name% нанялся охранять богатого вельможу и служил ему верно, как привык. Из письма, дошедшего до вас через третьи руки, следовало, что на вельможу напали в узком проулке, и телохранитель закрыл его собой от трёх арбалетных болтов. Вельможа остался цел и невредим и, как водится, даже не стал выяснять, кто именно лежит у него под ногами. %name% был похоронен за счёт города, в общей яме, без имени и без надгробного камня: он умер, заслонив собой другого, как и хотел, но в то же время и безродным псом тоже, как боялся.";
		this.m.HiringCost = 30;
		this.m.DailyCost = 18;
		this.m.Excluded = [
			"trait.ailing",
			"trait.asthmatic",
			"trait.bleeder",
			"trait.bloodthirsty",
			"trait.brute",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.cocky",
			"trait.craven",
			"trait.dastard",
			"trait.disloyal",
			"trait.drunkard",
			"trait.dumb",
			"trait.eagle_eyes",
			"trait.fainthearted",
			"trait.fat",
			"trait.fear_beasts",
			"trait.fear_greenskins",
			"trait.fear_undead",
			"trait.fragile",
			"trait.gluttonous",
			"trait.greedy",
			"trait.hate_beasts",
			"trait.hate_greenskins",
			"trait.hate_undead",
			"trait.hesitant",
			"trait.impatient",
			"trait.insecure",
			"trait.irrational",
			"trait.lucky",
			"trait.optimist",
			"trait.pessimist",
			"trait.quick",
			"trait.swift",
			"trait.tiny"
		];
		this.m.ExcludedTalents = [
			this.Const.Attributes.Initiative
		];
		this.m.Titles = [
			"Телохранитель",
			"Щит",
			"Мясной щит",
			"Великан",
			"Силовик",
			"Стражник",
			"Сторожевой пес",
			"Часовой",
			"Непобедимый",
			"Непробиваемый",
			"Стойкий",
			"Непоколебимый",
			"Неприступный"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.CommonMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.All;
		this.m.Bodies = this.Const.Bodies.Muscular;
		this.m.IsCombatBackground = true;
		this.m.Level = this.Math.rand(2, 5);
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{Незаконный сын захудалого рыцаря, %name% был отвергнут отцом в раннем детстве за то, что не унаследовал его \'нрав убийцы\' - зато унаследовал его исполинское телосложение. Слух о том, что этот здоровяк в одиночку отбил разбойничье нападение, дошёл до местного лорда, и тот предложил ему место личного телохранителя. | %name% с юных лет работал в кузнице, и годы у наковальни сделали его шире дверного проёма. Когда шайка разбойников напала на обоз лорда, %name% голыми руками разбросал троих нападавших - лорд, наблюдавший за этим лично, тут же взял его к себе телохранителем. | Сын простого пастуха, %name% с детства таскал на плечах телят и валил быков одним ударом кулака, если те слишком уж упрямились. Когда лорд, заплутавший на охоте, наткнулся на разбойников, именно %name% оказался неподалёку и в одиночку разогнал их вилами - в награду лорд забрал его в замок телохранителем. | %name% зарабатывал на жизнь, борясь на деревенских ярмарках - ни один смельчак ни разу не продержался против него дольше минуты. Слава о непобедимом силаче дошла до местного лорда, искавшего человека понадёжнее для своей охраны, и тот предложил ему солидное жалование за службу. | %name% был обычным пехотинцем, пока сослуживцы не начали шутить, что он один стоит целого отделения - настолько он был крупнее и крепче любого из них. Когда его полк распустили после войны, слух о силаче достиг ушей местного лорда, искавшего охрану понадёжнее, и тот предложил ему службу. | %name% в одиночку выходил на медведя с рогатиной, промышляя охотой в глухих лесах, и однажды сумел завалить зверя, не отступив ни на шаг. История дошла до местного лорда через одного из его егерей, и тот, впечатлённый, предложил такому смельчаку личную охрану своей особы. | %name% был сыном захудалого рыцаря, который так и не разбогател на своём мече - но именно от него %name% унаследовал исполинский рост и косую сажень в плечах, хоть вовсе не унаследовал его жестокости. Когда %name% в одиночку отбился от разбойников, напавших на купеческий обоз, слух об этом быстро долетел до местного лорда, решившего, что такому человеку самое место рядом с ним.} {Прослужив ему верой и правдой много лет, он лишился хозяина, когда тот тихо скончался от старости в собственной постели - а поскольку лорд не оставил наследника, борьба за его земли обернулась настоящей грызнёй. | Он верно охранял лорда добрый десяток лет, пока того не сразила лихорадка, за один сезон унёсшая половину замка вместе с хозяином. | Он оберегал лорда от всех видимых опасностей, но не сумел уберечь его от яда, поднесённого на пиру рукой, которую никто не заподозрил. | Годы службы оборвались в одночасье, когда лорд погиб на охоте - несчастный случай, в который он так и не поверил до конца. | Верная служба закончилась, когда лорд, обвинённый в измене короне, отправился на плаху, а вместе с ним - и должность его личного телохранителя. | Замок его господина пал под натиском врагов, и хотя сам лорд сумел спастись бегством, его земли и титул перешли к победителю - служить стало попросту некому. | Лорд, которого он оберегал столько лет, однажды решил, что телохранитель ему больше не по карману, и без долгих объяснений отправил его восвояси.} {Теперь %name% ищет нового хозяина среди наёмников - человека, достаточно великого, чтобы заслуживать такой же верной защиты. | Он не гонится за золотом - ему важнее вновь почувствовать, что кого-то стоит прикрывать собой. | %name% не любит рассказывать о прежнем господине, но по тому, как крепко он сжимает щит, ясно: службу свою он принимает всерьёз. | Он говорит, что готов встать за спину любому, кто заслужит его уважение делом, а не одним лишь золотом. | Ему уже доводилось охранять великого человека - теперь он присматривается, найдётся ли среди наёмников хоть один, достойный того же. | Он немногословен, но стоит прикинуть на глаз ширину его плеч - и сомнений в его пригодности не остаётся. | Если ему суждено умереть в бою, пусть он умрёт, заслонив собой кого-то, а не как безродный пёс на пустой дороге.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [8, 8]
			Bravery = [5, 5]
			Stamina = [5, 5]
			MeleeSkill = [2, 2]
			RangedSkill = [-4, -4]
			MeleeDefense = [13, 15]
			RangedDefense = [6, 9]
			Initiative = [-15, -15]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		r = this.Math.rand(1, 100);

		if (r > 95)
		{
			items.equip(this.new("scripts/items/shields/named/named_full_metal_heater_shield"));
		}
		else if (r > 90)
		{
			items.equip(this.new("scripts/items/shields/named/named_golden_round_shield"));
		}
		else if (r > 45)
		{
			items.equip(this.new("scripts/items/shields/heater_shield"));
		}
		else
		{
			items.equip(this.new("scripts/items/shields/kite_shield"));
		}

		items.addToBag(this.new("scripts/items/accessory/bandage_item"));
		r = this.Math.rand(0, 1);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/armor/heraldic_mail"));
		}
		else if (r == 1)
		{
			items.equip(this.new("scripts/items/armor/reinforced_mail_hauberk"));
		}

		r = this.Math.rand(0, 2);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/helmets/flat_top_with_mail"));
		}
		else if (r == 1)
		{
			items.equip(this.new("scripts/items/helmets/kettle_hat_with_mail"));
		}
		else if (r == 2)
		{
			items.equip(this.new("scripts/items/helmets/kettle_hat"));
		}

		items.equip(this.new("scripts/items/weapons/winged_mace"));
	}

});

