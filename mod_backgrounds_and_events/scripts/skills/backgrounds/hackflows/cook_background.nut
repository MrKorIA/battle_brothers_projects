this.cook_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_cook";
		this.m.Name = "Повар";
		this.m.Icon = "ui/backgrounds/background_cook.png";
		this.m.BackgroundDescription = "Повара редко имеют боевой или походный опыт, ведь всю свою жизнь они провели у тёплого очага, готовя изысканные яства для изнеженных господ.";
        this.m.GoodEnding = "Покинув отряд \'%companyname%\', %name% нашёл место, где его ремесло ценят не меньше меча. Проезжий купец, у которого вы попросили огня на привале, обмолвился, что на юге при богатом трактире есть повар, чья похлёбка заставляет забыть про всё на свете. Описание в точности совпало с вашим бывшим братом. Вы вспомнили, что от его готовки наёмники дрались вдвое злее, и невольно позавидовали купцам, которым теперь достаётся его стряпня.";
        this.m.BadEnding = "Покинув отряд \'%companyname%\', %name% вступил в армию благородного дома, где кормили хуже, чем у вас, и нередко совсем не кормили. Вам рассказал об этом наёмник, ушедший вместе с ним: зимой припасы таяли быстрее, чем их успевали добывать. {К северу | К югу | К западу | К востоку} отсюда повара застали ночью у чужого котла с ложкой в руке, и часовой, не разобравшись, убил его на месте. Утром выяснилось, что он просто собирался сварить похлёбку на всех из того, что было.";
		this.m.HiringCost = 150;
		this.m.DailyCost = 8;
		this.m.Excluded = [
			"trait.ailing",
			"trait.athletic",
			"trait.bleeder",
			"trait.bloodthirsty",
			"trait.brave",
			"trait.brute",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.cocky",
			"trait.deathwish",
			"trait.disloyal",
			"trait.eagle_eyes",
			"trait.greedy",
			"trait.hate_beasts",
			"trait.impatient",
			"trait.quick",
			"trait.spartan",
			"trait.strong",
			"trait.survivor",
			"trait.swift",
			"trait.tiny"
		];
		this.m.ExcludedTalents = [
			this.Const.Attributes.Fatigue
		];
		this.m.Titles = [
			"Повар",
			"Шеф-повар",
			"Толстяк",
			"Весельчак"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.CommonMale;
		this.m.HairColors = this.Const.HairColors.Young;
		this.m.Beards = this.Const.Beards.All;
		this.m.Bodies = this.Const.Bodies.Thick;
		this.m.IsOffendedByViolence = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{%name% всегда любил еду больше, чем большинство людей вообще способны любить хоть что-то. Однажды, в лучшие времена, местный лорд угостил крестьян на празднике несколькими деликатесами со своего стола - и %name%, отведав выпечку, был так тронут до глубины души, что упросил повара лорда взять его в подмастерья, чтобы и он мог когда-нибудь дарить простому люду такую же радость. Великодушный дворянин согласился, и %name% провёл несколько счастливых лет, оттачивая своё мастерство. | %name% с детства крутился на кухне трактира, где работала его мать, и годам к десяти уже знал о специях больше, чем иной трактирщик за всю жизнь. | Отведав однажды похлёбку странствующего повара, готовившего для проезжего каравана, %name% был настолько впечатлён, что бросил всё и упросил взять его в ученики - лишь бы научиться готовить так же. | %name% начинал поварёнком на кухне зажиточного купца, драя котлы и таская воду, пока старший повар не заметил в нём настоящий талант. | Оставшись сиротой, %name% нанялся мальчиком на побегушках при монастырской кухне - и вскоре обнаружил, что готовка получается у него куда лучше, чем молитвы. | %name% годами торговал пирожками на рыночной площади, пока местный трактирщик не оценил их по достоинству и не взял его к себе в свою кухню.} {К сожалению, будучи однажды пойманным за поеданием продуктов из кладовой во времена голода, %name% был вышвырнут прочь без лишних разговоров. | К несчастью, недостача съестных припасов быстро навела на след истинного виновника, и с работой пришлось распрощаться. | Но однажды его застали с набитым ртом прямо посреди голодной зимы, когда каждый кусок был на счету - оправдания уже никого не интересовали. | Но в один не самый удачный день его поймали за поеданием чужого ужина прямо из чужой тарелки - и терпению на кухне пришёл конец. | Излишняя тяга к дегустации собственных блюд прямо во время готовки в конце концов не осталась незамеченной, и его без разговоров выставили за порог. | Но однажды на кухне пересчитали припасы и с точностью до последней крошки вычислили недостачу - и %name% не смог придумать сколько-нибудь убедительного объяснения.} {Как ни странно, самого повара это ничуть не расстроило. Теперь он ищет работы наёмника, чтобы \'не быть вечно голодным, чёрт возьми\'. | Он воспринял это на удивление спокойно и теперь хочет наняться в отряд наёмников - хотя бы там, по его словам, кормят регулярно. | Расстроенным он не выглядит вовсе - куда больше его занимает мысль о том, где раздобыть следующий обед, а наёмники, по слухам, питаются неплохо. | Он пожимает плечами и признаётся, что жалеет лишь об одном - что попался, а не о том, что ел. Теперь ищет отряд, где, по крайней мере, будут кормить вовремя. | По его собственным словам, готовить он готов кому угодно, лишь бы самому не оставаться голодным - а в отряде наёмников, кажется, шансы на это выше.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [8, 14]
			Bravery = [-5, -5]
			Stamina = [2, -5]
			MeleeSkill = [0, 0]
			RangedSkill = [-4, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [-4, -4]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		items.equip(this.new("scripts/items/armor/apron"));
	}

});

