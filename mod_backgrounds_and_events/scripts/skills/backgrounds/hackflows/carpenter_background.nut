this.carpenter_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_carpenter";
		this.m.Name = "Плотник";
		this.m.Icon = "ui/backgrounds/background_carpenter.png";
		this.m.BackgroundDescription = "Плотники - привычные обитатели лесных поселений, проводящие дни за тяжёлым трудом по распилу брёвен и заготовке строевой древесины.";
        this.m.GoodEnding = "После нескольких лет в отряде \'%companyname%\' %name% оказался в деревне, где требовалось восстановить сгоревший дом. Он взялся за работу и вскоре обнаружил, что плотницкое ремесло всё ещё приносит ему неплохие деньги, а главное намного больше удовольствия чем ремесло наймника. Хозяин дома остался доволен работой и предложил плотнику остаться и открыть собственную мастерскую. Вскоре у него появились ученики, но в лес он по-прежнему ходил сам - вдруг однажды там найдётся тот, кого он так и не перестал искать.";
        this.m.BadEnding = "После ухода из отряда \'%companyname%\' %name% всё-таки решил вернуться к своему ремеслу и устроился работать в чужую мастерскую. Однажды хозяин попросил его сходить в лес за древесиной, и %name% отправился туда один, как когда-то его пропавший товарищ. К вечеру он не вернулся. На следующий день нашли только его топор, глубоко застрявший в стволе старого дерева. Больше ничего - ни тела, ни следов, ни ответа на вопрос, что же на самом деле случилось с его предшественником и им самим в том лесу.";
		this.m.HiringCost = 70;
		this.m.DailyCost = 7;
		this.m.Excluded = [
			"trait.ailing",
			"trait.asthmatic",
			"trait.bleeder",
			"trait.bright",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.craven",
			"trait.fainthearted",
			"trait.fat",
			"trait.fragile",
			"trait.hate_undead",
			"trait.night_blind",
			"trait.tiny",
			"trait.weasel"
		];
		this.m.Titles = [
			"Ремесленник",
			"Плотник",
			"Древодел"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.CommonMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.Untidy;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsLowborn = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{%name% рос плотником, продолжая скромное ремесло своего отца и деда до него. Его старший брат, куда крепче телом, рубил лес, а он превращал брёвна в добротные балки и доски - вместе они составляли отличную команду. | %name% с юных лет работал в мастерской вместе со своим отцом-плотником, привыкнув к запаху свежей стружки задолго до того, как научился держать топор как следует. | %name% с малых лет помогал старому плотнику деревни в обмен на кров и еду - тот заменил ему отца и обучил всему, что знал сам. | %name% и его младший ученик много лет работали в одной мастерской: %name% размечал и вытёсывал детали, а ученик подносил инструмент и учился на лету. | Ремеслу плотника %name% выучился у собственного дяди, взявшего осиротевшего племянника под крыло после того, как чума унесла всю его семью.} {Но однажды тот, с кем он бок о бок трудился много лет, ушёл в лес за древесиной - и не вернулся к вечеру. | Но однажды его товарищ по ремеслу отправился в лес за древесиной и как в воду канул - ни следа, ни весточки. | Но однажды его товарищ по ремеслу вышел за материалом для очередного заказа и просто не вернулся, будто его никогда и не было. | Но однажды человек, с которым он делил мастерскую столько лет, отправился в чащу и пропал без вести - ни тела, ни объяснений его пропажи так и не нашлось.} {Теперь %name%, невысокий ростом, но не духом, вознамерился раз и навсегда разгадать тайну его исчезновения. | Небольшого роста, но упрямый, %name% решил во что бы то ни стало выяснить, что произошло в тот злополучный день в лесу. | %name% сменил рубанок на оружие, поклявшись узнать правду о пропаже своего товарища, чего бы это ни стоило. | Без товарища мастерская быстро захирела, а вместе с ней и заработок - оставшись без дела и без денег, %name% подался в наёмники. | %name% попытался в одиночку тянуть работу, что прежде делали на двоих, но быстро понял: один он не справится - и оставил ремесло плотника, подавшись в наёмники.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [4, 4]
			Bravery = [0, 0]
			Stamina = [-2, -2]
			MeleeSkill = [3, 3]
			RangedSkill = [0, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [0, 0]
		};
		return c;
	}

	function onSetAppearance()
	{
		local actor = this.getContainer().getActor();
		local dirt = actor.getSprite("dirt");
		dirt.Visible = true;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		items.equip(this.new("scripts/items/armor/linen_tunic"));
	}

});

