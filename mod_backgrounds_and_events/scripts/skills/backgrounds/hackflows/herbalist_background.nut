this.herbalist_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_herbalist";
		this.m.Name = "Травник";
		this.m.Icon = "ui/backgrounds/background_herbalist.png";
		this.m.BackgroundDescription = "Травники досконально знают скрытые свойства целебных кореньев и трав. Из своих находок они варят лечебные мази и припарки, способные унять боль и облегчить страдания раненых.";
        this.m.GoodEnding = "Травник %name% оставался при отряде \'%companyname%\' дольше, чем любой другой лекарь, каких вы знали: он не пил с бойцами, не спорил о добыче и всегда первым бросался к раненым. Говорят, за годы службы он вытащил с того света столько народу, что иные командиры стали заказывать его снадобья заранее - не для себя, так для своих людей. Чем кончил сам %name%, доподлинно неизвестно: одни говорят, что он осел при большом госпитале и умер в почёте, другие - что ушёл в лес собирать травы и не вернулся.";
        this.m.BadEnding = "Травник %name% остался в отряде \'%companyname%\' и в одну из зим - сказал, что пойдёт собирать редкий корень, который растёт только под снегом, и что без него толку от него как от лекаря немного. Больше его не видели. По слухам, его нашли {к северу | к югу | к западу | к востоку} от лагеря, в лесу, и тело его лежало спокойно, без следов борьбы. В его мешке нашли склянку с настоем, который, судя по записям самого травника, должен был спасать от обморожения. Настой оказался негоден - и, говорят, это была последняя ошибка, которую он уже не смог исправить.";
		this.m.HiringCost = 90;
		this.m.DailyCost = 7;
		this.m.Excluded = [
			"trait.fear_undead",
			"trait.hate_undead",
			"trait.dumb",
			"trait.clumsy",
			"trait.asthmatic",
			"trait.athletic",
			"trait.brute",
			"trait.bloodthirsty",
			"trait.ailing"
		];
		this.m.Titles = [
			"Травник",
			"Аптекарь",
			"Натуралист",
			"Знахарь",
			"Целитель"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.YoungMale;
		this.m.HairColors = this.Const.HairColors.Young;
		this.m.Beards = this.Const.Beards.All;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsOffendedByViolence = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			},
			{
				id = 13,
				type = "text",
				icon = "ui/icons/xp_received.png",
				text = "[color=" + this.Const.UI.Color.PositiveValue + "]+10%[/color] Experience Gain"
			}
		];
	}

	function onBuildDescription()
	{
        return "{Мир природы скрывает удивительные дары для тех, кто умеет их найти. %name% принадлежит к их числу: отец его, солдат, по слухам, пережил раны от сотни битв, а весь секрет этой живучести крылся вовсе не в удаче, а в действенных целебных мазях и обеззараживающих снадобьях его матери. | С малых лет %name% ходил по пятам за деревенской знахаркой, запоминая, какая трава сбивает жар, какая затягивает рану, а какая годится разве что на растопку. | Не имея учителя, %name% годами испытывал травы и коренья на себе самом, отмечая, что облегчает боль, а что лучше оставить свиньям, а после принялся пользовать и соседей, благо желающих сэкономить на лекаре в округе хватало. | Ремесло травника %name% унаследовал от долгой череды предков, для которых лес был не опасностью, а живой аптекой под открытым небом. | %name% начинал не с трав, а с книг: потрёпанный травник, доставшийся ему от деда, он выучил почти наизусть задолго до того, как впервые сам вышел в лес за корнями.} {Когда родители один за другим отошли в мир иной от старости, а не от меча или хвори, он счёл это добрым знаком для своего ремесла - и решил испытать его в настоящем деле. | Небольшая деревня давно исчерпала запас хворей, которые стоило лечить, а сам он давно перерос скромные нужды соседей. | Когда местный лорд забрал в поход всех молодых мужчин округи, лечить стало попросту некого - и он отправился следом, чтобы его снадобья не пропадали впустую. | Слухи о его снадобьях разошлись дальше, чем ему бы хотелось: местный цирюльник, углядевший в травнике опасного конкурента, сделал его жизнь в родных краях невыносимой. | Однажды исцелённый им человек умер совсем от другой хвори, и вся округа, забыв о прежних успехах, разом записала его в шарлатаны. | Годы мирной практики наскучили ему: сломанная в поле рука или порез от косы - не то испытание, ради которого он оттачивал своё искусство. | Война, докатившаяся до его земель, забирала больше жизней, чем он успевал спасать, и он понял: против такой хвори одному не выстоять.} {Он немногословен, но взгляд его тут же отыскивает на вас все старые шрамы и свежие ссадины - привычка, от которой не так-то просто избавиться. | От его заплечного мешка веет смесью полыни, дёгтя и ещё чего-то, что вы предпочли бы не нюхать слишком долго. | Он с гордостью показывает потёртый деревянный ларец, набитый склянками и пучками сушёных трав - по его словам, этого хватит на целый отряд, если, конечно, тот переживёт первую же стычку. | Он тихо бормочет себе под нос названия трав, будто перебирая чётки, и вы невольно задаётесь вопросом, не разговаривает ли он так со всеми своими пациентами - включая тех, кто уже не может ответить. | Он втайне надеется, что его снадобья однажды станут частью легенды о непобедимом отряде наёмников. | Он с готовностью объясняет разницу между травой, что останавливает кровь, и той, что останавливает сердце - и почему-то эта готовность вас не слишком успокаивает. | Немногие наёмники доживают до седин, но травник, кажется, всерьёз рассчитывает, что причиной тому однажды станут именно его снадобья, а не чужая удача.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [0, 0]
			Bravery = [-2, 0]
			Stamina = [-2, 0]
			MeleeSkill = [-2, -2]
			RangedSkill = [0, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [0, 0]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		r = this.Math.rand(0, 2);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/armor/leather_tunic"));
		}
		else if (r == 1)
		{
			items.equip(this.new("scripts/items/armor/linen_tunic"));
		}
		else if (r == 2)
		{
			items.equip(this.new("scripts/items/armor/apron"));
		}
	}

});

