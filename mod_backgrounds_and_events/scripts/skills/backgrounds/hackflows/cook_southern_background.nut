this.cook_southern_background <- this.inherit("scripts/skills/backgrounds/hackflows/cook_background", {
	m = {},
	function create()
	{
		this.cook_background.create();
		this.m.BadEnding = "Покинув отряд \'%companyname%\', %name% нанялся поваром к войску одного из визирей, где кормили хуже, чем у вас, и нередко совсем не кормили. Вам рассказал об этом наёмник, ушедший вместе с ним: в походе припасы таяли быстрее, чем их успевали добывать. {К северу | К югу | К западу | К востоку} отсюда повара застали ночью у чужого котла с ложкой в руке, и часовой, не разобравшись, убил его на месте. Утром выяснилось, что он просто собирался сварить похлёбку на всех из того, что было.";
		this.m.Bodies = this.Const.Bodies.SouthernMale;
		this.m.Faces = this.Const.Faces.SouthernMale;
		this.m.Hairs = this.Const.Hair.SouthernMale;
		this.m.HairColors = this.Const.HairColors.Southern;
		this.m.Beards = this.Const.Beards.Southern;
		this.m.BeardChance = 90;
		this.m.Ethnicity = 1;
		this.m.Excluded = [
			"trait.ailing",
			"trait.athletic",
			"trait.bleeder",
			"trait.bloodthirsty",
			"trait.brave",
			"trait.brute",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.cocky",
			"trait.deathwish",
			"trait.disloyal",
			"trait.eagle_eyes",
			"trait.greedy",
			"trait.hate_beasts",
			"trait.impatient",
			"trait.quick",
			"trait.spartan",
			"trait.strong",
			"trait.survivor",
			"trait.swift",
			"trait.tiny"
		];
		this.m.Names = this.Const.Strings.SouthernNames;
		this.m.LastNames = this.Const.Strings.SouthernNamesLast;
	}

	function onBuildDescription()
    {
        return "{%name% с детства крутился на кухне постоялого двора при большом караван-сарае, где работала его мать, и годам к десяти уже разбирался в заморских специях лучше многих торговцев. Со временем мальчишка на побегушках превратился в правую руку старшего повара, без которого на кухне, казалось, никто уже не мог обойтись. | Отведав однажды похлёбку караванного повара, готовившего для проезжих торговцев, %name% был настолько впечатлён, что бросил всё и упросил взять его в ученики - лишь бы научиться готовить так же. | %name% начинал поварёнком на кухне зажиточного купца, драя котлы и таская воду, пока старший повар не заметил в нём настоящий талант. | %name% родился рабом на кухне богатого дома и с детства помогал стряпать для хозяйского стола - готовка оказалась единственным делом, в котором он находил хоть какую-то отдушину. Спустя годы верной службы хозяин, растроганный особенно удавшимся блюдом, даровал ему вольную - и с тех пор %name% зарабатывал стряпнёй уже как свободный человек.} {К сожалению, будучи однажды пойманным за поеданием продуктов из кладовой во времена голода, %name% был вышвырнут прочь без лишних разговоров. | К несчастью, недостача съестных припасов быстро навела на след истинного виновника, и с работой пришлось распрощаться. | Но однажды его застали с набитым ртом прямо во время священного поста в честь Златоликого, когда даже пробовать пищу раньше положенного часа было немыслимо - оправдания уже никого не интересовали. | Но в один не самый удачный день его поймали за поеданием чужого ужина прямо из чужой тарелки - и терпению на кухне пришёл конец. | Излишняя тяга к дегустации собственных блюд прямо во время готовки в конце концов не осталась незамеченной, и его без разговоров выставили за порог. | Когда пришла пора воинской повинности, а платить откуп было нечем, кухню пришлось оставить - назад его после службы уже не позвали.} {Как ни странно, самого повара это ничуть не расстроило. Теперь он ищет работы алчущего крон, чтобы \'не быть вечно голодным, чёрт возьми\'. | Он воспринял это на удивление спокойно и теперь хочет наняться в отряд алчущих крон - хотя бы там, по его словам, кормят регулярно. | Расстроенным он не выглядит вовсе - куда больше его занимает мысль о том, где раздобыть следующий обед, а наёмники, по слухам, питаются неплохо. | Он пожимает плечами: о потерянном месте жалеет он, по его словам, куда меньше, чем о вечно пустом желудке. Теперь ищет отряд, где хотя бы будут кормить вовремя. | По его собственным словам, готовить он готов кому угодно, лишь бы самому не оставаться голодным - а в отряде алчущих крон, кажется, шансы на это выше.}";
    }

	function onAddEquipment()
    {
        local items = this.getContainer().getActor().getItems();
        local r;
        r = this.Math.rand(0, 2);

        if (r == 0)
        {
            items.equip(this.new("scripts/items/armor/linen_tunic"));
        }
        else
        {
            items.equip(this.new("scripts/items/armor/oriental/cloth_sash"));
        }

        r = this.Math.rand(1, 4);

        if (r == 1)
        {
            items.equip(this.new("scripts/items/helmets/feathered_hat"));
        }
        else if (r == 2)
        {
            items.equip(this.new("scripts/items/helmets/oriental/southern_head_wrap"));
        }
    }

});
