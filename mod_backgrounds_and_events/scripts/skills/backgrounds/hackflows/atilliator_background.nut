this.atilliator_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_atilliator";
		this.m.Name = "Мастер осадного дела";
		this.m.Icon = "ui/backgrounds/background_atilliator.png";
		this.m.BackgroundDescription = "Осадных дел мастера досконально разбираются в баллистике и устройстве оружия дальнего боя. Своими руками собирая сложнейшие арбалеты, эти мастера и на практике прекрасно знают, как пустить тяжёлый болт точно в цель.";
		this.m.GoodEnding = "После нескольких лет в отряде \'%companyname%\' %name% однажды увидел старую крепость, которую собирались осаждать. Он предложил владельцу несколько советов по укреплениям, а заодно указал на пару мест, где стены могли не выдержать ещё одного удара. За эти советы ему заплатили больше, чем за многие годы наёмничества. С тех пор %name% снова работает инженером, но теперь предпочитает строить для тех, кто хочет пережить осаду, а не для тех, кто её начинает.";
        this.m.BadEnding = "После ухода из отряда \'%companyname%\' %name% нашёл нового нанимателя и взялся за укрепление его замка. Но когда хозяин отправился в поход, %name% допустил ошибку в расчётах, из-за которой одна из стен оказалась значительно слабее, чем должна была быть. Когда враг добрался до замка, именно через этот участок начался штурм, и обрушившаяся стена похоронила под собой нескольких защитников вместе с ними был и %name%. Похоже, расчёты всё же оказались верны - просто на этот раз не в его пользу.";
		this.m.HiringCost = 80;
		this.m.DailyCost = 8;
		this.m.Excluded = [
			"trait.fear_undead",
			"trait.hate_undead",
			"trait.iron_jaw",
			"trait.athletic",
			"trait.clumsy",
			"trait.short_sighted",
			"trait.fearless",
			"trait.brave",
			"trait.iron_lungs",
			"trait.strong",
			"trait.tough",
			"trait.cocky",
			"trait.dumb",
			"trait.brute",
			"trait.bloodthirsty"
		];
		this.m.ExcludedTalents = [
			this.Const.Attributes.MeleeSkill
		];
		this.m.Titles = [
			"Арбалетный мастер",
			"Самострельщик",
			"Ремесленник",
			"Терпеливый"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.TidyMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.Tidy;
		this.m.Bodies = this.Const.Bodies.Skinny;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{С ловкими пальцами и даром соединять механизмы в единое целое, %name% начинал карьеру как архитектор осадных машин при дворе местного лорда. | Ещё подростком %name% чинил мельничные механизмы в родной деревне, а позже поступил подмастерьем к мастеру осадных орудий. | %name% самостоятельно изучил устройство катапульт и требушетов по чертежам, украденным из библиотеки одного захудалого барона. | %name% привлёк внимание гильдии механиков ещё в юности, и его определили в ученики к главному инженеру осадного дела. | %name% происходил из семьи потомственных плотников, но быстро понял, что его истинное призвание - не дома, а машины, способные их разрушать. | Отслужив несколько лет обслугой осадных машин, %name% обратил внимание на то, как плохо спроектированы орудия, которыми ему приходилось пользоваться, и решил заняться этим сам. | %name% много лет собирал и разбирал модели осадных машин для собственного удовольствия, пока однажды местный лорд не обратил на это внимание и не предложил ему работу.} {Когда крепость его лорда осадили катапультами и требушетами его же собственной конструкции, он был вынужден спасаться бегством и срочно менять род занятий. | Один из его требушетов рухнул прямо во время демонстрации перед знатными гостями, покалечив нескольких зрителей - с тех пор он не самый желанный гость при любом дворе. | Заподозрив его в продаже чертежей вражеской стороне, лорд отправил стражу, чтобы разобраться с инженером раз и навсегда - он еле унёс ноги. | Когда война закончилась, надобность в его услугах отпала так же быстро, как и появилась - ему просто перестали платить. | Но со временем более молодой и амбициозный инженер занял его место при дворе, обвинив его в устаревших методах и вредительстве. | Обвалившаяся башня, построенная по его чертежам, унесла слишком много жизней, чтобы дело замяли - виновного назначили быстро, и им оказался именно он, в одночасье лишившись и работы, и доброго имени. | Лорд, однажды воспользовавшийся его услугами, счёл разумным не оставлять в живых свидетеля, знающего секреты его укреплений - он благоразумно ретировался, не дожидаясь визита.} {К счастью для него, дар обращения с механизмами одинаково хорошо применим что к требушетам, что к арбалетам. | Не имея никакого желания вновь пересекаться с прежними нанимателями, %name% теперь предпочитает занятие, не привязывающее его к одному месту. | Свои таланты %name% теперь предпочитает применять к оружию, которое можно унести на плече, а не оставить где-то под открытым небом. | Он признаётся, что скучает по масштабу больших осадных орудий, но арбалет, по крайней мере, не выдаёт его местонахождение с первого выстрела. | Он давно взял за правило не задерживаться надолго ни в одном городе - мало ли, кто там его ещё помнит. | Ремесло инженера приучило его к терпению и точным расчётам - качества, которые неплохо служат ему и с арбалетом в руках.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [0, 0]
			Bravery = [-5, 0]
			Stamina = [-5, 0]
			MeleeSkill = [0, 0]
			RangedSkill = [10, 13]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [0, 0]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		r = this.Math.rand(0, 100);

		if (r > 60)
		{
			items.equip(this.new("scripts/items/weapons/crossbow"));
		}
		else
		{
			items.equip(this.new("scripts/items/weapons/light_crossbow"));
		}

		items.equip(this.new("scripts/items/ammo/quiver_of_bolts"));
		items.equip(this.new("scripts/items/armor/apron"));
		r = this.Math.rand(0, 2);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/helmets/feathered_hat"));
		}
	}

});

