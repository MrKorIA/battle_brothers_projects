this.barkeep_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_barkeep";
		this.m.Name = "Трактирщик";
		this.m.Icon = "ui/backgrounds/background_barkeep.png";
		this.m.BackgroundDescription = "Трактирщикам не привыкать пускать в ход кулаки, ведь им из дня в день приходится разнимать пьяные потасовки и утихомиривать буйных посетителей в своих заведениях.";
        this.m.GoodEnding = "Годы в отряде \'%companyname%\' не сделали из трактирщика ни героя, ни богача - но всё же кое-чего %name% добился. На скопленные за контракты деньги он выкупил ту самую таверну на перекрёстке, где когда-то начинал, и снова встал за стойку, только теперь уже хозяином, а не мальчиком на побегушках. Завсегдатаи клянутся, что лучшего трактирщика в округе не сыскать: уж он-то знает, когда налить, когда промолчать, а когда и выставить буяна за порог - и всё это без единого лишнего слова.";
        this.m.BadEnding = "Трактирщик %name% покинул отряд \'%companyname%\' после одной особенно щедрой выплаты - решил, что наконец накопил на собственную таверну. Дорога привела его в придорожный кабак, где он сгоряча принялся разнимать двух подвыпивших наёмников, как делал это сотни раз до этого. Привычка стоила ему жизни: третий наёмник, которому он в суматохе наступил на ногу, решил, что трактирщик заодно с обидчиками, и ударил первым сзади, просто чтобы не стоять в стороне. От удара %name% упал, ударившись виском о край скамьи, и умер ещё до того, как драчуны успели опомниться. Собственная таверна, стало быть, так и осталась мечтой.";
		this.m.HiringCost = 130;
		this.m.DailyCost = 8;
		// TODO: allow drunkard, and make it higher chance???
		// NOTE: looks like these backgrounds are have too much stuff excluded
		// TODO: add a MoreLikely list :) How it will work though? Add on top?
		this.m.Excluded = [
			"trait.ailing",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.cocky",
			"trait.bloodthirsty",
			"trait.spartan",
			"trait.brute",
			"trait.optimist",
			"trait.deathwish",
			"trait.hesitant",
		];
		this.m.Titles = [
			"Бармен",
			"Трактирщик",
			"Пивовар",
			"Крепыш",
			"Мастер кранов",
			"Хмельной",
			"Пивовар"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.UntidyMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.Untidy;
		this.m.Bodies = this.Const.Bodies.Muscular;
		this.m.IsLowborn = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{%name% провёл годы за трактирной стойкой, и это превратило его в крепкого, коренастого мужика. | %name% с юных лет разносил кружки и оттирал полы в отцовской таверне, и годы такой работы не прошли для него даром. | Управляя трактиром с тех самых пор, как отец передал ему заведение, %name% стал шире в плечах, чем иной кузнец. | %name% держал таверну на перекрёстке торговых путей, и постоянный поток буйных постояльцев быстро закалил его характер и кулаки. | Управляя захудалым трактиром на окраине города, %name% быстро понял, что одной приветливой улыбкой порядка не будет - порой нужны и кулаки. | %name% всю жизнь простоял за стойкой родительской таверны, и это занятие оставило на его теле куда больше отметин, чем можно было бы ожидать.} {В неспокойные времена ему частенько приходилось \'улаживать разногласия\', \'провожать гостей до дверей\' и \'следить за честной оплатой\' своими силами. | Немало пьяных дебоширов узнали на собственной шкуре, что значит быть \'вежливо выпровоженным\' из его заведения. | Ему не раз доводилось \'разнимать особо горячие споры\' между завсегдатаями - обычно с помощью крепкого кулака и ещё более крепких выражений. | За долгие годы он в совершенстве освоил искусство \'убедительной беседы\' с теми, кто не желал оплачивать счёт. | Скандалисты и забияки быстро узнавали цену его терпения, стоило ему лишь раз \'проводить\' их до порога. | Он привык самолично \'разрешать недопонимания\' между клиентами, не дожидаясь, пока дело дойдёт до поножовщины. | Он не понаслышке знает, как \'аккуратно\' выставить из таверны буяна вдвое крупнее себя.} {Наслушавшись историй о подвигах, жестоких схватках и поисках сокровищ, он готов сам повидать большой мир. Телосложением он, по крайней мере, обделён не был - глядишь, и прославится! | Годами слушая байки захмелевших наёмников о подвигах и сокровищах, он наконец решил, что пора и самому попытать счастье. | Кому, как не ему, слушавшему тысячи хвастливых историй за стойкой, знать, что удача любит смелых? Крепкие кулаки у него уже есть - осталось раздобыть немного везения. | Устав разнимать чужие драки за медные гроши, он решил, что не хуже сможет зарабатывать, участвуя в собственных. | Много лет слушая байки о дальних землях и потерянных сокровищах, он решил, что пора наконец увидеть мир своими глазами, а не чужими. | Оставив привычное место за стойкой, он наконец решил проверить, годится ли его дар \'улаживать разногласия\' для чего-то более прибыльного, чем разнимание пьяных драк.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [5, 10]
			Bravery = [0, 0]
			Stamina = [4, 4]
			MeleeSkill = [4, 0]
			RangedSkill = [0, 0]
			MeleeDefense = [2, 2]
			RangedDefense = [0, 0]
			Initiative = [-5, -5]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		items.equip(this.new("scripts/items/armor/apron"));
		r = this.Math.rand(1, 100);

		if (r > 80)
		{
			items.addToBag(this.new("scripts/items/accessory/recovery_potion_item"));
		}
		else if (r > 60)
		{
			items.addToBag(this.new("scripts/items/accessory/iron_will_potion_item"));
		}
		else if (r > 40)
		{
			items.addToBag(this.new("scripts/items/accessory/lionheart_potion_item"));
		}
		else if (r > 20)
		{
			items.addToBag(this.new("scripts/items/accessory/night_vision_elixir_item"));
		}
	}

});

