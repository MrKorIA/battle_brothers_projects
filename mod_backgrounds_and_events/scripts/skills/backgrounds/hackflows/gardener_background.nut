this.gardener_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_gardener";
		this.m.Name = "Садовник";
		this.m.Icon = "ui/backgrounds/background_gardener.png";
		this.m.BackgroundDescription = "Садовники - это люди с врождённым талантом к уходу за растениями. Их часто нанимают благородные лорды, дабы те ухаживали за роскошными садами, призванными подчеркнуть спесь и богатство знатного рода.";
        this.m.GoodEnding = "Садовник %name% прижился в отряде \'%companyname%\' так тихо, что сперва его почти не замечали. Он не лез в драку первым, но и не бежал от неё, а в лагерях его быстро приставили к делу, к которому у него лежала душа: сушить травы и заготавливать припасы на зиму. Поговаривают, что после войны он осел при одном монастыре, где развёл такой сад, что братия простила ему и робость, и беглое прошлое. Говорят, теперь его оттуда и калачом не выманишь.";
        this.m.BadEnding = "Садовник %name% покинул отряд \'%companyname%\' после одной особенно тяжёлой зимы - сказал, что хочет попытать счастья в одиночку, подальше от людей. Куда он пошёл и что искал, так и осталось неизвестным: след его теряется где-то в {северных | южных | западных | восточных} землях. По слухам, спустя некоторое время он осел в одной деревушке, разбил небольшой сад при доме и зажил тихо, никому не мешая. А потом однажды ночью к нему пришли люди того самого лорда, от которого %name% когда-то бежал, и больше его никто не видел.";
		this.m.HiringCost = 80;
		this.m.DailyCost = 9;
		this.m.Excluded = [
			"trait.fear_undead",
			"trait.hate_undead",
			"trait.dumb",
			"trait.clumsy",
			"trait.asthmatic",
			"trait.athletic",
			"trait.brute",
			"trait.bloodthirsty",
			"trait.ailing"
		];
		this.m.ExcludedTalents = [
			this.Const.Attributes.Bravery
		];
		this.m.Titles = [
			"Садовник",
			"Зелёная рука",
			"Смотритель"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.UntidyMale;
		this.m.HairColors = this.Const.HairColors.Young;
		this.m.Beards = this.Const.Beards.Untidy;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsOffendedByViolence = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{По натуре человек довольно робкий, %name% провёл большую часть жизни, ухаживая за садами в роскошных замках высшей знати. | %name% с детства помогал отцу-садовнику в поместье одного из мелких лордов и постепенно перенял всё его ремесло. | Тихий и застенчивый по природе, %name% нашёл своё призвание среди грядок и клумб господского сада, вдали от шумного общества других слуг. | %name% начинал простым помощником садовника, таскающим вёдра с водой, но со временем дослужился до собственного участка в поместье. | Робкий и молчаливый %name% предпочитал общество цветов обществу людей, что и привело его в услужение садовником к одному из знатных домов.} {Когда жена лорда понесла, пока сам лорд был в военном походе, поместью срочно понадобился козёл отпущения. Короткий жребий указал именно на него, и, не найдя в себе смелости доказывать невиновность, %name% бежал из поместья. | Когда в кладовой обнаружилась крупная недостача серебра, слуги поместья быстро сошлись на том, что виноват тихий садовник - оправдываться он не стал и просто скрылся под покровом ночи. | Когда любимая охотничья собака лорда издохла от неведомой хвори, кто-то пустил слух, что её отравил садовник из зависти - опровергать это %name% не рискнул и бежал, поджав хвост. | Когда в господском саду обнаружили вытоптанные грядки редких южных роз, всю вину без долгих разбирательств возложили на садовника - объясняться с разгневанным лордом %name% не решился и предпочёл исчезнуть. | Когда в поместье случился пожар, слуги наперебой твердили, что виноват %name%, якобы неосторожно обращавшийся с масляными лампами в саду - опровергать эти слухи он не осмелился и бежал, пока его не успели повесить.} {Он и правда кажется вам несколько более робким, чем большинство встречных, но при этом держится и двигается, как человек, привыкший к вольному воздуху и тяжёлой работе на земле. | Робости в нём и впрямь через край, но руки у него мозолистые, а походка твёрдая - видно, что тяжёлый труд ему привычен. | Взгляд у него боязливый, будто он до сих пор ждёт погони, но телосложением он вышел крепче, чем можно было бы ожидать от простого садовника.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [0, 0]
			Bravery = [-3, -3]
			Stamina = [4, 4]
			MeleeSkill = [0, 2]
			RangedSkill = [0, 0]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [4, 4]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		items.equip(this.new("scripts/items/armor/linen_tunic"));
	}

});

