this.fletcher_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_fletcher";
		this.m.Name = "Мастер по изготовлению стрел";
		this.m.Icon = "ui/backgrounds/background_fletcher.png";
        this.m.BackgroundDescription = "Мастера по изготовлению стрел - это искусные ремесленники, посвятившие себя тонкому искусству изготовления и продажи стрел и болтов.";
        this.m.GoodEnding = "Мастер по изготовлению стрел %name% покинул отряд \'%companyname%\' вскоре после первой же крупной кампании - и, вопреки ожиданиям, не в поисках приключений, а в поисках заказчика побогаче. Поговаривают, он осел при одном из герцогских арсеналов, где получил и мастерскую, и подмастерьев, и заказы, о которых прежде не смел и мечтать. Его стрелы вскоре стали цениться так высоко, что купцы охотно переплачивали за работу мастера, а сам %name%, по слухам, давно перестал стрелять и снова взялся за древки, окончательно променяв лук на перо.";
        this.m.BadEnding = "Мастер по изготовлению стрел %name% не покинул отряд \'%companyname%\' - и, по иронии судьбы, на поле боя он и остался. В одной из стычек он получил тяжёлую рану в руку, после которой пальцы уже не слушались его так, как прежде. Он пробовал вернуться к ремеслу, но прежней точности больше не было, а без неё хороших стрел не сделать. Последние годы %name% провёл при каком-то обозе, где за медяки правил чужие стрелы, - а когда умер, его похоронили без почестей, как обычного доходягу.";
		this.m.HiringCost = 150;
		this.m.DailyCost = 8;
		this.m.Excluded = [
			"trait.fear_undead",
			"trait.hate_undead",
			"trait.iron_jaw",
			"trait.athletic",
			"trait.clumsy",
			"trait.short_sighted",
			"trait.fearless",
			"trait.brave",
			"trait.iron_lungs",
			"trait.strong",
			"trait.tough",
			"trait.cocky",
			"trait.dumb",
			"trait.brute",
			"trait.bloodthirsty"
		];
		this.m.ExcludedTalents = [
			this.Const.Attributes.Hitpoints,
			this.Const.Attributes.Bravery
		];
		this.m.Titles = [
			"Стрельник",
			"Продавец стрел",
			"Стрелодел"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.TidyMale;
		this.m.HairColors = this.Const.HairColors.All;
		this.m.Beards = this.Const.Beards.Tidy;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsLowborn = true;
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{Выходец из простой семьи, %name% с юных лет обнаружил в себе дар к изготовлению стрел и с тех пор не оставлял этого ремесла. | %name% рос в семье охотника и с детства учился насаживать наконечники на древки, пока другие дети ещё играли во дворе. | %name% начинал подмастерьем у деревенского лучника, чинившего оружие для местного ополчения, и быстро превзошёл учителя в мастерстве оперения стрел. | Ещё мальчишкой %name% подбирал оброненные стрелы на охотничьих тропах, изучая их устройство до тех пор, пока не научился делать не хуже. | %name% вырос в бедной семье на окраине города и рано понял, что ровная стрела кормит куда лучше, чем кривая мотыга. | Его отец был кузнецом, но %name% с юных лет предпочитал возиться с древками и перьями, а не с раскалённым металлом.} {К его счастью, войны и раздоры, которых в мире всегда хватало, обеспечивали его работой сполна. Тем не менее, он всегда чувствовал, что мир способен предложить нечто большее. | Пока армии воевали друг с другом, заказы на его стрелы не иссякали ни на день - и всё же его не покидало ощущение, что за пределами мастерской его ждёт нечто более интересное. | Спрос на его стрелы никогда не падал - было бы странно, если бы он падал в мире, где то и дело вспыхивает очередная война - но однообразие мастерской со временем начало его тяготить. | Работы всегда было в достатке благодаря бесконечным войнам между лордами, но %name% всё чаще ловил себя на мысли, что хочет увидеть, куда в итоге летят его стрелы. | Заказы сыпались один за другим, стоило начаться очередной войне - но %name% давно устал делать оружие для чужих рук и захотел однажды взять его в свои.} {Вы не уверены, сможет ли он вписать своё имя в историю, но уж с луком-то он точно управляться умеет. | Прославится ли он когда-нибудь - вопрос спорный, но обращаться с луком он умеет вполне себе сносно. | Героем баллад ему, пожалуй, не бывать, но стрелять из лука он умеет вполне себе сносно. | Сложно сказать, войдёт ли его имя в историю, но что он знает толк в стрельбе - в этом сомневаться не приходится.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [-4, 0]
			Bravery = [-4, 0]
			Stamina = [0, 0]
			MeleeSkill = [0, 0]
			RangedSkill = [10, 13]
			MeleeDefense = [0, 0]
			RangedDefense = [0, 0]
			Initiative = [5, 10]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		items.equip(this.new("scripts/items/armor/apron"));
		r = this.Math.rand(0, 2);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/helmets/feathered_hat"));
		}
	}

});

