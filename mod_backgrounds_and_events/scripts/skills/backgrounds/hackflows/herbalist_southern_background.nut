this.herbalist_southern_background <- this.inherit("scripts/skills/backgrounds/hackflows/herbalist_background", {
	m = {},
	function create()
	{
		this.herbalist_background.create();
		this.m.Bodies = this.Const.Bodies.SouthernMale;
		this.m.Faces = this.Const.Faces.SouthernMale;
		this.m.Hairs = this.Const.Hair.SouthernMale;
		this.m.HairColors = this.Const.HairColors.Southern;
		this.m.Beards = this.Const.Beards.Southern;
		this.m.BeardChance = 90;
		this.m.Ethnicity = 1;
		this.m.Excluded = [
			"trait.fear_undead",
			"trait.hate_undead",
			"trait.dumb",
			"trait.clumsy",
			"trait.asthmatic",
			"trait.athletic",
			"trait.brute",
			"trait.bloodthirsty",
			"trait.ailing"
		];
		this.m.Names = this.Const.Strings.SouthernNames;
		this.m.LastNames = this.Const.Strings.SouthernNamesLast;
	}

	function onBuildDescription()
    {
        return "{Мир природы скрывает удивительные дары для тех, кто умеет их найти. %name% принадлежит к их числу: отец его, солдат, по слухам, пережил раны от сотни битв, а весь секрет этой живучести крылся вовсе не в обереге Златоликого, а в действенных целебных мазях и обеззараживающих снадобьях его матери. | Не имея учителя, %name% годами испытывал травы и коренья на себе самом, отмечая, что облегчает боль, а что лучше оставить свиньям, а после принялся пользовать и соседей, благо желающих сэкономить на лекаре в округе хватало. | Ремесло травника %name% унаследовал от долгой череды предков, для которых пустыня была не опасностью, а живой аптекой под открытым небом. | %name% с малых лет вертелся под ногами у матери, повитухи и лекарки на всю округу, и, сам того не заметив, выучился не меньше иного цирюльника. | На юге лекарское дело в почёте не меньше, чем алхимия и астрология, и %name% с малых лет разбирал диковинные снадобья, что везли через пустыню караванщики - какие лечат, а какие лишь вкусно пахнут.} {Когда родители один за другим отошли в мир иной от старости, а не от меча или хвори, он счёл это добрым знаком для своего ремесла - и решил испытать его в настоящем деле. | Небольшое поселение давно исчерпало запас хворей, которые стоило лечить, а сам он давно перерос скромные нужды соседей. | Когда пришёл черёд его родичей отбывать воинскую повинность, а откупиться было нечем, лечить в родных краях стало попросту некого - он отправился следом за призванными, чтобы его снадобья не пропадали впустую. | Однажды исцелённый им человек умер совсем от другой хвори, и вся округа, забыв о прежних успехах, разом записала его в шарлатаны. | Священная война, докатившаяся до его земель, забирала больше жизней, чем он успевал спасать, и он понял: против такой хвори одному не выстоять.} {Он немногословен, но взгляд его тут же отыскивает на вас все старые шрамы и свежие ссадины - привычка, от которой не так-то просто избавиться. | От его заплечного мешка веет смесью полыни, дёгтя и ещё чего-то, что вы предпочли бы не нюхать слишком долго. | Он с гордостью показывает потёртый деревянный ларец, набитый склянками и пучками сушёных трав - по его словам, этого хватит на целый отряд, если, конечно, тот переживёт первую же стычку. | Он тихо бормочет себе под нос названия трав, будто перебирая чётки, и вы невольно задаётесь вопросом, не разговаривает ли он так со всеми своими пациентами - включая тех, кто уже не может ответить. | Он втайне надеется, что его снадобья однажды станут частью легенды о непобедимом отряде наёмников. | Он с готовностью объясняет разницу между травой, что останавливает кровь, и той, что останавливает сердце - и почему-то эта готовность вас не слишком успокаивает.}";
    }

	function onAddEquipment()
    {
        local items = this.getContainer().getActor().getItems();
        local r;
        r = this.Math.rand(0, 0);

        if (r == 0)
        {
            items.equip(this.new("scripts/items/armor/oriental/cloth_sash"));
        }

        r = this.Math.rand(0, 3);

        if (r == 0)
        {
            items.equip(this.new("scripts/items/helmets/oriental/southern_head_wrap"));
        }
    }

});
