this.lancer_background <- this.inherit("scripts/skills/backgrounds/character_background", {
	m = {},
	function create()
	{
		this.character_background.create();
		this.m.ID = "background.hackflows_lancer";
		this.m.Name = "Копейщик";
		this.m.Icon = "ui/backgrounds/background_lancer.png";
		this.m.BackgroundDescription = "Верные своему призванию, копейщики виртуозно владеют пиками и древковым оружием. Хотя им нет равных на рыцарских турнирах, в затяжном бою они заметно уступают в выносливости истинным рыцарям.";
        this.m.GoodEnding = "Копейщик %name% оставался в отряде \'%companyname%\' дольше, чем сам, вероятно, рассчитывал: привычки ристалища в настоящем бою пригодились не сразу, и первые месяцы он больше учился, чем учил. Зато потом, когда понял, что на войне нет ни зрителей, ни правил, ни заранее расписанных исходов, он стал настоящим бойцом, чья работа говорит сама за себя. Поговаривают, что после работы наёмником он вернулся на турнирное поле, но уже как распорядитель, а не как участник, - и что всякий раз, глядя, как молодые выбивают друг друга из седла, он морщится и уходит, не досмотрев до конца.";
        this.m.BadEnding = "Копейщик %name% покинул отряд \'%companyname%\' после первой же настоящей кампании - он-то думал, что война и есть то самое место, где его мастерство наконец заговорит в полную силу. Место оказалось другим: на войне древко имеет свойство ломаться в самый неподходящий момент, а против нескольких вооружённых людей мастерство одного человека значит куда меньше, чем на ристалище. В одной из стычек по дороге домой его сбили с ног - не соперник на ристалище, а обычный пехотинец с топором. Рассказывают, что перед смертью он успел удивиться: до последнего мгновения ждал, что противник сначала объявит свой выпад.";
		this.m.HiringCost = 30;
		this.m.DailyCost = 22;
		this.m.Excluded = [
			"trait.ailing",
			"trait.asthmatic",
			"trait.bleeder",
			"trait.brute",
			"trait.clubfooted",
			"trait.clumsy",
			"trait.craven",
			"trait.dastard",
			"trait.drunkard",
			"trait.dumb",
			"trait.fat",
			"trait.fear_beasts",
			"trait.fear_greenskins",
			"trait.fear_undead",
			"trait.fragile",
			"trait.gluttonous",
			"trait.hesitant",
			"trait.huge",
			"trait.impatient",
			"trait.insecure",
			"trait.irrational",
			"trait.night_blind",
			"trait.paranoid",
			"trait.pessimist",
			"trait.short_sighted",
			"trait.superstitious",
			"trait.tiny"
		];
		this.m.ExcludedTalents = [
			this.Const.Attributes.RangedSkill,
			this.Const.Attributes.RangedDefense
		];
		this.m.Titles = [
			"Копейщик",
			"Копье",
			"Турнирный боец",
			"Копейщик",
			"Дитя света",
			"Колун"
		];
		this.m.Faces = this.Const.Faces.AllMale;
		this.m.Hairs = this.Const.Hair.TidyMale;
		this.m.HairColors = this.Const.HairColors.Young;
		this.m.Beards = this.Const.Beards.All;
		this.m.Bodies = this.Const.Bodies.Skinny;
		this.m.IsCombatBackground = true;
		this.m.Level = this.Math.rand(2, 4);
	}

	function getTooltip()
	{
		return [
			{
				id = 1,
				type = "title",
				text = this.getName()
			},
			{
				id = 2,
				type = "description",
				text = this.getDescription()
			}
		];
	}

	function onBuildDescription()
	{
        return "{Получив особую воинскую выучку ещё в юности, %name% зарабатывал на жизнь копьём, объезжая турниры и раз за разом выбивая соперников из седла. | Оруженосец захудалого рыцаря, %name% годами оттачивал удар копьём на ристалище, пока однажды не превзошёл в мастерстве своего господина. | %name% с детства обучался владению копьём при дворе одного мелкого лорда, вечно мечтавшего о турнирной славе, которой ему самому было не суждено добиться, - и вскоре начал одерживать на турнирах победы, каких лорд не видел за всю свою жизнь. | Крестьянский сын, %name% каким-то чудом попался на глаза странствующему рыцарю и был взят в оруженосцы - редкая удача, которой он воспользовался сполна. | Не имея ни титула, ни родословной, %name% годами тренировался в одиночку, пока не набрался достаточно уверенности, чтобы выйти на ристалище наравне с настоящими рыцарями. | Младший сын в семье потомственных турнирных бойцов, %name% с пелёнок знал, с какого конца браться за копьё, и с юных лет собирал победы на малых деревенских ристалищах. | %name% служил в конной страже одного лорда, пока не обнаружил, что настоящие деньги приносит не караульная служба, а турнирное поле.} {Но со временем копейщик почувствовал, что слава турнирного ристалища пуста: тупые наконечники и расписанные заранее правила не оставляли места настоящей опасности. | Гибель соперника на, казалось бы, безобидном турнире заставила его задуматься: если смерть возможна и в игре по правилам, к чему тогда сами правила? | Победа за победой на ристалище перестала приносить радость - зрители аплодировали одинаково что мастерству, что счастливой случайности, и он устал притворяться, что видит разницу. | Обвинённый соперниками в нечестном преимуществе после слишком уверенной победы, он был отстранён от турниров - и решил, что честь его копья докажет себя там, где правила не имеют значения. | Раз за разом выбивая противников из седла, он так и не встретил на ристалище равного - и заскучал по-настоящему, желая наконец испытать себя всерьёз. | Тяжёлая рана, полученная не в честном поединке, а из-за подстроенной поломки турнирного копья соперника, отбила у него всякое доверие к рыцарским правилам чести. | Раненая гордость - вот что осталось после того, как некий заезжий чемпион с юга без труда выбил его из седла на глазах у всего города; с тех пор он ищет способ доказать себе, что тот бой был случайностью.} {Он держит копьё так, будто оно продолжение его собственной руки - расслабленно, но готовое сорваться с места в любой момент. | На пальцах его до сих пор заметны мозоли от многолетней турнирной выучки, хотя сама выучка эта, судя по всему, годится не только для показательных боёв. | Он с видимым сожалением поглядывает на своё копьё, будто оно заслуживает большего, чем очередной турнир с заранее известным исходом. | Он охотно рассказывает о своих турнирных победах, но каждый раз обрывает рассказ словами \'но это было ненастоящее\'. | В отличие от многих турнирных бойцов, он не боится крови - складывается ощущение, что он давно втайне мечтал увидеть её на своём копье. | Он двигается с уверенностью человека, который слишком долго побеждал понарошку и теперь горит желанием узнать, чего стоит его мастерство на самом деле.}";
	}

	function onChangeAttributes()
	{
		local c = {
			Hitpoints = [0, 0]
			Bravery = [10, 3]
			Stamina = [4, 8]
			MeleeSkill = [13, 10]
			RangedSkill = [0, 0]
			MeleeDefense = [2, 4]
			RangedDefense = [0, 4]
			Initiative = [5, 5]
		};
		return c;
	}

	function onAddEquipment()
	{
		local items = this.getContainer().getActor().getItems();
		local r;
		items.equip(this.new("scripts/items/weapons/fighting_spear"));
		items.addToBag(this.new("scripts/items/weapons/throwing_spear"));
		r = this.Math.rand(1, 100);

		if (r > 95)
		{
			items.equip(this.new("scripts/items/helmets/sallet_helmet"));
		}
		else if (r > 70)
		{
			items.equip(this.new("scripts/items/helmets/closed_mail_coif"));
		}
		else if (r > 30)
		{
			items.equip(this.new("scripts/items/helmets/rusty_mail_coif"));
		}

		r = this.Math.rand(0, 2);

		if (r == 0)
		{
			items.equip(this.new("scripts/items/armor/leather_lamellar"));
		}
		else if (r == 1)
		{
			items.equip(this.new("scripts/items/armor/leather_scale_armor"));
		}
		else if (r == 2)
		{
			items.equip(this.new("scripts/items/armor/gambeson"));
		}
	}

});

