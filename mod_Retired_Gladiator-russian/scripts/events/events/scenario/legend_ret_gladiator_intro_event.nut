this.legend_ret_gladiator_intro_event <- this.inherit("scripts/events/event", {
	m = {},
	function create()
	{
		this.m.ID = "event.legend_ret_gladiator_intro";
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_176.png[/img]Рог арены звучит снова, ликующие крики толпы возвещают о смерти одного дурака в обмен на скудное существование другого. Вы впиваетесь ногтями в кресло, а внутри вас зарождается ярость.\nНе так давно вашим предназначением было служить толпе и сражаться насмерть.\nСнова звучит горн, и хватка на вашем кресле становится все крепче. Прошло почти десять лет с тех пор, как вы позволили своей гордости перевесить инстинкты выживания. Визирь хотел, чтобы его сын выиграл тот бой, и заплатил вам, чтобы вы приняли удар поражения. Но вы зарезали юнца, как ягненка, пока его мать кричала, а толпа ликовала.\n\nРаздетый и избитый, вы были оставлены в удушливой камере, чтобы умереть по желанию визиря. Вот только визиря убили несколько лет спустя. Заплатив стражникам, вы совершили побег, выбравшись из лабиринтов туннелей в мир, который сильно изменился с тех пор, как вы его покинули. Некоторые бойцы до сих пор собираются вместе и рассказывают о великом гладиаторе, убившем сына визиря много лет назад.\n\nТеперь в этой разваливающейся комнате вы медленно умираете, смерть ещё не набралась смелости прийти за вами, и, пока ваше наследие не превратилось в прах, вы принимаете решение. Вы крадёте с арены всё, что можете, и тратите те немногие кроны, которые смогли собрать. Вдалеке снова звучит рог арены.\n\n Последний бой.\n\nЕщё один...",
			Image = "",
			Banner = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Нельзя терять время.",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
//				this.logInfo("Собирательство разблокировано");
//				this.World.Flags.set("HasLegendCampGathering", true);
//				this.logInfo("Тренировка разблокирована");
//				this.World.Flags.set("HasLegendCampTraining", true);
			}

		});
	}

	function onUpdateScore()
	{
		return;
	}

	function onPrepare()
	{
		this.m.Title = "Всё ближе к солнцу";
	}

	function onPrepareVariables( _vars )
	{
		_vars.push([
			"home",
			this.World.Flags.get("HomeVillage")
		]);
	}

	function onClear()
	{
	}

});

