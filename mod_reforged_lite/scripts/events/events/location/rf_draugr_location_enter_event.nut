this.rf_draugr_location_enter_event <- ::inherit("scripts/events/event", {
	m = {
		LocationID = null
	},
	function create()
	{
		this.m.ID = "event.location.rf_draugr_location_enter";
		this.m.Title = "По мере приближения...";
		this.m.Cooldown = 999999.0 * ::World.getTime().SecondsPerDay;
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			// Event text set during the `start` function
			Text = "[img]gfx/ui/events/rf_draugr_01.png[/img]",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Приготовиться к нападению.",
					function getResult( _event )
					{
						::World.Events.showCombatDialog(true, true, true);
						return 0;
					}
				},
				{
					Text = "Пока что отступим.",
					function getResult( _event )
					{
						return 0;
					}
				}
			],
			function start( _event )
			{
				local variant = ::Math.rand(1, 2);
				switch (_event.m.LocationID)
				{
					case "location.rf_draugr_barrows":
						switch (variant)
						{
							case 1:
								this.Text += "Среди замёрзшей равнины вздымаются невысокие округлые курганы из грубых каменных плит, сглаженные ветром и временем. Воздух здесь неестественно неподвижен, холод пронзительнее, чем должен быть, а ваши люди замолкают без приказа. То, что было похоронено в этих курганах, должно было остаться нетронутым.\n\nЗатем вы слышите пение. Медленное и размеренное, оно разносится над камнями, словно бесконечная погребальная песнь. В центре курганов застыла одинокая фигура, её голос звучит, словно он никогда не знал усталости. Пение продолжается, и сама земля начинает отвечать ему, один за другим входы курганов раскалываются, и бледная нежить выбирается наружу.\n\nОружие обнажено, мертвецы поднимаются, некоторые - всего лишь замёрзшие рабы, но другие закованы в древние кольчуги, всё ещё целые из-за тщательного погребения. Их голоса хрипят при движении - это не речь и не дыхание, но ваша кровь стынет в жилах. Пение всё продолжается, и пока никто не замечает вашего присутствия.\n\n%randombrother% бормочет, что в этих гробницах должны храниться богатые подношения. Золото, оружие, быть может реликвии, дабы почтить мертвых, - такие места редко бывают бедными. Вы знаете, что он прав, но пение давит на ваши мысли, а мертвецы всё прибывают в числе, потому любые богатства будут оплачены кровью.";
								break;

							case 2:
								this.Text += "Курганы предстают перед глазами, как старые шрамы на земле, их камни сложены с заботой, говорящей скорее о благоговении, чем о спешке. Иней цепляется за всё, и даже ветер, кажется, не решается веять над могилами. Ваши люди замедляют шаг, разглядывая то один курган, то другой, словно ожидая, что вот-вот что-то случится.\n\nРаздавшийся голос подтверждает их тревоги. Он доносится из-за камней, низкий и монотонный, повторяя слова, источённые веками использования. Одинокая фигура стоит на страже могил, застывшая и покрытая инеем, поющая непрестанно и монотонно. С каждым стихом земля дрожит, руки прорывают почву, за ними следуют шлемы, кольчуги и мёртвые глаза, устремленные на живых.\n\nПоднявшиеся курганники движутся на вас, притянутые пением, их присутствие подавляет храбрость. Ни один человек здесь не почувствует желания кричать или хвастаться. Есть лишь необходимость крепиться и выстоять. Голос певца связывает их, ровный и непреклонный, словно сами курганы отвечают вашему вторжению.\n\n%randombrother% шепчет, что эти курганы должны хранить нечто большее, чем кости, что никто не стал бы так долго охранять пустые могилы. Вы взвешиваете обещание погребённого богатства против уверенности в том, что, как только мечи будут обнажены, пение станет только громче, а мёртвых - больше.";
								break;
						}
						break;


					case "location.rf_draugr_crypt":
						switch (variant)
						{
							case 1:
								this.Text += "Курганы уступают место каменной кладке, когда вы приближаетесь к крипте. Её вход уходит глубоко в землю, он запечатан плитами с вырезанными, почти стёршимися символами. Это не простая могила. Воздух вокруг стал ещё холоднее и тяжелее от груза времени и памяти, и ваши люди замолкают, словно инстинкт требует этого.\n\nИзнутри доносится пение, ровное и не прерывающееся, эхом отражающееся от каменных коридоров, созданных, чтобы его разносить, поднимающееся и падающее в ритме, который кажется отточенным за пределами памяти. Голос посылает ужасный холод по вашему позвоночнику, подтачивая любую храбрость, которую, как вы думали, вы имели. На мгновение земля вокруг крипты шевелится, и мёртвые отвечают, поднимаясь из своего холодного сна.\n\nЗатем вы чувствуете нечто иное: присутствие кого-то ещё, кто погребён ещё глубже. Это место было построено для того, кто имел значение, забытого героя, чье имя когда-то имело достаточно веса, чтобы оправдать каменные стены и запертые двери. %randombrother% бормочет, что людей не кладут в такие крипты, если они не заслужили это кровью и битвами. Если истории хотя бы наполовину правдивы, внутри будет полно оружия и сокровищ, за которые стоит сражаться. Вопрос в том, стоят ли они того, чтобы умереть?";
								break;

							case 2:
								this.Text += "Крипта поднимается из замерзшей земли, словно сжатый каменный кулак, её вход отмечен титулами воинов, давно лишённых имени и смысла. Снег лежит нетронутым перед ней, но неподвижность кажется вынужденной, созданной чем-то, наблюдающим изнутри. Ваше дыхание сдавливает, когда холод усиливается, проникая сквозь кольчугу и меха.\n\nПение эхом разносится из темноты за дверным проёмом, его ритм размеренный и терпеливый, словно само время изгибается вокруг него. Голос проникает сквозь почву и камень, когда земля отвечает. Курганники поднимаются, одетые в доспехи, которые говорят о намеренной чести, а не о массовом захоронении.\n\nГде-то за этими стенами вы чувствуете более тяжёлую поступь, ожидающую своего часа. Эта крипта была воздвигнута, чтобы вместить героя, фигуру, почитаемую настолько, что её запечатали с оружием и реликвиями, которые должны были последовать за ними в иной мир. Мёртвые снаружи не просто бродят. Они держат позицию, словно охраняя момент, который ещё не наступил.\n\n%randombrother% говорит, что это место пропитано старой славой и старыми ошибками, и что такие крипты никогда не пустуют. Вы знаете, он думает о прославленной стали и погребальных дарах, не тронутых живыми руками, но сначала вам придется заставить замолчать пение, которое продолжает поднимать мёртвых.";
								break;
						}
						break;


					case "location.rf_draugr_fane":
						switch (variant)
						{
							case 1:
								this.Text += "Святилище вырезано прямо в горе, её каменный лик оформлен в виде столбов и притолок, когда-то обрамлявших зал собраний. Ветер завывает у входа, неся с собой холод, который кажется старше снега под вашими сапогами. Это место было построено не для того, чтобы скрывать мёртвых, а чтобы размещать их в состоянии боеготовности.\n\nИзнутри, сквозь каменные своды разносится пение, глубокое и звучное, словно гора вторит ему в ответ. Одинокий певец стоит на пороге, его голос поднимается и падает в ритме, который кажется церемониальным, а не караульным. По его зову появляются мёртвые, выступая из затененных залов и запечатанных камер.\n\nКурганники несут на себе следы ранга и происхождения. Их доспехи украшены, их оружие изготовлено умелой рукой, и они двигаются с уверенностью тех, за кем когда-то следовали в бой. Пение связывает их вместе, одновременно давя на ваших людей, как вес невидимой толпы, заглушая любую искру бравады, прежде чем она успеет возникнуть.\n\n%randombrother% говорит тихо, называя это место залом предков, тем, что воздвигали для королей, чемпионов и тех, кого хоронили с их родней и дружинами. Там будут несметные богатства, говорит он, но они никогда не предназначались для живых. Чтобы забрать их, вам придется нарушить обряд, который удерживает мёртвых на троне, и встретиться с теми чемпионами, что ждут в глубине."
								break;

							case 2:
								this.Text += "Лик горы был преобразован во нечто, напоминающее скорее зал, а не гробницу, его вход широк и продуман. Каменные колонны возвышаются, как замерзшие стражи, их резьба потускнела от веков ветра и льда. Это не обычный погребальный зал, это место, построенное, чтобы выдержать течение времени.\n\nПение наполняет святилище, эхом разносясь из глубины, слоистое и тяжёлое, словно повторяемое давно умолкшими голосами. Певец стоит неподвижно, его бдение не прерывается вашим приближением, и с каждым размеренным стихом появляется всё больше мёртвых. Они поднимаются не в беспорядке; они занимают места в строю.\n\nВы чувствуете взгляды из темноты за колоннами. Где-то в глубине лежат те, ради кого был воздвигнут этот зал. Короли, герои давно минувших эпох, похороненные со своими семьями, своими стражами и реликвиями своего правления. Мёртвые снаружи держат позицию, словно ожидая момента, когда их повелителей призовут подняться.\n\n%randombrother% бормочет, что о таких святилищах говорят в старых сказаниях, где кланы собирались, чтобы чтить своих правителей даже после смерти. Если истории хоть сколько-нибудь правдивы, то внутри находятся прославленное оружие и древние сокровища, но также и мёртвые, которым было доверено владеть ими вечно."
								break;
						}
						break;
				}
			}
		});
	}

	function onUpdateScore()
	{
	}

	function onPrepare()
	{
		if (::World.State.getLastLocation() != null)
		{
			this.m.LocationID = ::World.State.getLastLocation().getTypeID();
		}
	}

	function onPrepareVariables( _vars )
	{
	}

	function onClear()
	{
		this.m.LocationID = null;
	}
});

