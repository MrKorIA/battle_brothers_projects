// Имена/титулы кризисных юнитов Reforged (из mod_reforged/hooks/config/character_names.nut 0.9.3)
::Const.Strings.RF_BansheeNames <- [
	"Сибилла",
	"Эльсбет",
	"Рохелина",
	"Вельда",
	"Гертрун",
	"Брида",
	"Марга",
	"Эльсвин",
	"Хильда",
	"Фрейя",
	"Мехтхильда",
	"Брунхильда",
	"Кунигунда",
	"Урсула",
	"Маргарет",
	"Гудрун",
	"Изольда"
];
local more = [];
foreach (n in ::Const.Strings.RF_BansheeNames)
{
	more.push("Леди " + n);
	more.push("Мать " + n);
	more.push("Старуха " + n);
	more.push("Дама " + n)
};
::Const.Strings.RF_BansheeNames.extend(more);

