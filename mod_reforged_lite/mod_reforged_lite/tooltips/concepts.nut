// Словарь концепций вложенных тултипов mod_reforged_lite — только термины, используемые
// текстами контента мода. Типы Skill/Item/Perk/Entity и т.д. предоставляет мод
// mod_nested_tooltips (::MSU.Mod.Tooltips); ссылки в текстах — [текст|Concept.X] /
// [текст|Skill+имя_файла] через ::ReforgedLite.Mod.Tooltips.parseString.
::ReforgedLite.Mod.Tooltips.setTooltips({
	Concept = {
		Disabled = ::MSU.Class.BasicTooltip("Отключён", ::ReforgedLite.Mod.Tooltips.parseString("Отключенный персонаж не может действовать и пропускает свой [ход|Concept.Turn].\n\nК отключению персонажа могут привести следующие [эффекты|Concept.StatusEffect]: [оглушение|Skill+stunned_effect] и [сон|Skill+sleeping_effect].")),
		Rooted = ::MSU.Class.BasicTooltip("Обездвижен", ::ReforgedLite.Mod.Tooltips.parseString("Персонаж, который не может двигаться и которого нельзя сдвинуть.\n\nПример [эффектов|Concept.StatusEffect], которые могут обездвижить персонажа: [пойман в сеть|Skill+net_effect] и [опутан паутиной|Skill+web_effect]")),
		Wait = ::MSU.Class.BasicTooltip("Ожидание", ::ReforgedLite.Mod.Tooltips.parseString(format("Если персонаж не является последним в [очерёдности действий|Concept.Turn] в [ходе боя|Concept.Round], то он может использовать [ожидание|Concept.Wait]. Это перемещает персонажа в конец текущей [очерёдности действий|Concept.Turn], позволяя ему действовать ещё раз до конца [хода боя|Concept.Round].\n\n[Ожидание|Concept.Wait] можно использовать только один раз за [ход|Concept.Turn]%s", ::Const.CharacterProperties.InitiativeAfterWaitMult == 1.0 ? "" : "\n\nИспользование [ожидания|Concept.Wait] заставляет [очерёдность действий|Concept.Turn] персонажа в следующем [ходе боя|Concept.Round] рассчитываться с " + ::MSU.Text.colorizeMult(::Const.CharacterProperties.InitiativeAfterWaitMult) + " " + (::Const.CharacterProperties.InitiativeAfterWaitMult > 1.0 ? "большей" : "меньшей") + " [инициативой|Concept.Initiative]."))),
		Perk = ::MSU.Class.BasicTooltip("Навыки", ::ReforgedLite.Mod.Tooltips.parseString("С ростом уровня персонаж получает очки, которые можно потратить на изучение полезных навыков. Навыки дают персонажу постоянные бонусы или открывают для использования новые умения. Текущий [уровень навыка|Concept.PerkTier] персонажа увеличивается на 1 за каждое затраченное очко навыка.")),
		StatusEffect = ::MSU.Class.BasicTooltip("Эффект состояния", ::ReforgedLite.Mod.Tooltips.parseString("Персонаж может иметь положительные или отрицательные эффекты. Эффекты различаются по продолжительности и могут иметь различные последствия, начиная от увеличения/уменьшения [характеристик|Concept.CharacterAttribute] и заканчивая открытием новых способностей.")),
		Injury = ::MSU.Class.BasicTooltip("Травма", ::ReforgedLite.Mod.Tooltips.parseString("Персонаж может получить травму, если во время боя получит достаточный урон по [ОЗ|Concept.Hitpoints]. Травмы могут иметь различные [эффекты|Concept.StatusEffect], накладывающие штрафы на персонажа.\n\nТравмы, полученные во время боя, являются [временными|Concept.InjuryTemporary] и заживают либо за несколько ходов, либо за несколько дней. Если же во время боя персонажа сразили, у него есть шанс выжить, но с [постоянной травмой|Concept.InjuryPermanent]")),
		InjuryTemporary = ::MSU.Class.BasicTooltip("Временные травмы", ::ReforgedLite.Mod.Tooltips.parseString("Персонаж получает временные травмы, если урон по его [ОЗ|Concept.Hitpoints] превышает порог травмы. Эти травмы заживают со временем, но для скорейшего выздоровления их можно лечить в храме.")),
		InjuryPermanent = ::MSU.Class.BasicTooltip("Постоянные травмы", ::ReforgedLite.Mod.Tooltips.parseString("Постоянные травмы получают, если персонаж пал в бою, но остался жив. Эти ранения и связанные с ними штрафы остаются навсегда.")),
		InjuryThreshold = ::MSU.Class.BasicTooltip("Порог травмы", ::ReforgedLite.Mod.Tooltips.parseString("Если урон, полученный по [ОЗ|Concept.Hitpoints], составляет не менее " + ::MSU.Text.colorNegative(::Const.Combat.InjuryMinDamage) + " и превышает определенный процент от текущего [ОЗ|Concept.Hitpoints], персонаж получает [травму|Concept.InjuryTemporary]. Этот процент может быть изменен определёнными [навыками|Concept.Perk] или чертами как атакующего, так и цели.")),
		PerkTier = ::MSU.Class.BasicTooltip("Уровни навыков", ::ReforgedLite.Mod.Tooltips.parseString("[Навыки|Concept.Perk] распределены в дереве навыков персонажа по 7 рядам, которые называются уровнями. Для получения доступа к навыкам соответствующего уровня персонаж должен потратить на 1 очко меньше соответствующего номера ряда (считая сверху вниз).")),
		Turn = ::MSU.Class.BasicTooltip("Ход", ::ReforgedLite.Mod.Tooltips.parseString("Сражение в Battle Brothers пошаговое. Каждый бой состоит из серии [ходов боя|Concept.Round]. Во время хода боя персонажи действуют по очереди. Позиция персонажа в очерёдности действий определяется его [инициативой|Concept.Initiative] относительно других персонажей.\n\n[Эффекты|Concept.StatusEffect], длящиеся определённое количество [ходов|Concept.Turn], действуют до тех пор, пока персонаж не начнёт или не закончит свой [ход|Concept.Turn] столько же раз, в зависимости от того, истекает ли [эффект|Concept.StatusEffect] в начале или в конце [хода|Concept.Turn] соответственно.")),
		Round = ::MSU.Class.BasicTooltip("Ход боя", ::ReforgedLite.Mod.Tooltips.parseString("Сражения в игре Battle Brothers пошаговые. Каждый бой состоит из серии ходов. Во время хода боя персонажи действуют в порядке [ходов|Concept.Turn]. Ход боя заканчивается, когда все персонажи завершили свои личные [ходы|Concept.Turn]")),
		ZoneOfControl = ::MSU.Class.BasicTooltip("Зона контроля", ::ReforgedLite.Mod.Tooltips.parseString("Большинство персонажей с оружием ближнего боя устанавливают зону контроля на окружающие их клетки. Попытка выйти из зоны контроля противника вызовет его бесплатную атаку от каждого врага с зоной контроля — пока первая из них не попадёт в цель или каждая свободная атака не промахнётся. Попадание свободной атакой отменяет перемещение.")),
		FatigueRecovery = ::MSU.Class.BasicTooltip("Восстановление выносливости", ::ReforgedLite.Mod.Tooltips.parseString("В начале каждого хода [усталость|Concept.Fatigue] персонажа уменьшается на определенную величину. Это называется восстановлением выносливости.\n\nПо умолчанию восстановление выносливости персонажей игрока равно 15, в то время как враги, в зависимости от их вида, могут иметь гораздо большее восстановление.\n\nНа восстановление выносливости могут влиять [навыки|Concept.Perk], [черты|Concept.Trait], [эффекты состояния|Concept.StatusEffect] и [травмы|Concept.Injury].")),
		Trait = ::MSU.Class.BasicTooltip("Черты", ::ReforgedLite.Mod.Tooltips.parseString("Персонажи могут иметь несколько черт, отражающих различные стороны их личности. Они отличаются от [навыков|Concept.Perk] и не могут быть приобретены с помощью [опыта|Concept.Experience] или [повышения уровня|Concept.Level], однако, некоторые из них могут быть приобретены или утрачены в ходе некоторых событий. Черты могут давать различные бонусы или штрафы.")),
		CharacterAttribute = ::MSU.Class.BasicTooltip("Характеристики персонажа", ::ReforgedLite.Mod.Tooltips.parseString("Персонажи в игре Battle Brothers обладают различными характеристиками, отражающими их умения и способности в определённых областях. Характеристики включают: [ОЗ|Concept.Hitpoints], [выносливость|Concept.Fatigue], [решимость|Concept.Bravery], [инициативу|Concept.Initiative], [навык ближнего боя|Concept.MeleeSkill], [защиту в ближнем бою|Concept.MeleeDefense], [навык дальнего боя|Concept.RangeSkill] и [защиту в дальнем бою|Concept.RangeDefense].\n\nПо мере того, как персонажи получают [опыт|Concept.Experience] и [уровни|Concept.Level], они могут увеличивать свои характеристики и открывать [навыки|Concept.Perk].")),
		MoraleCheck = ::MSU.Class.BasicTooltip("Проверка боевого духа", ::ReforgedLite.Mod.Tooltips.parseString("Проверка [боевого духа|Concept.Morale] — это бросок против [решимости|Concept.Bravery] персонажа, результат которого определяет, сохранит ли он своё текущее состояние боевого духа или потеряет его. Проваленная проверка снижает боевой дух на одно состояние, успешная — сохраняет его.\n\nПроверки боевого духа вызываются различными событиями в бою, например: при получении значительного урона по [ОЗ|Concept.Hitpoints], при окружении несколькими противниками, при виде гибнущих или бегущих союзников. Различные навыки и эффекты могут давать бонусы или штрафы к [решимости|Concept.Bravery] на время такой проверки.")),
	}
});

// Автоконцепты: ссылки на ванильные тултипы характеристик (character-stats.*)
::MSU.QueueBucket.FirstWorldInit.push(function() {
	local autoConcepts = [
		"ActionPoints", "Hitpoints", "Morale", "Fatigue", "MaximumFatigue",
		"ArmorHead", "ArmorBody", "MeleeSkill", "RangeSkill", "MeleeDefense",
		"RangeDefense", "SightDistance", "RegularDamage", "CrushingDamage",
		"ChanceToHitHead", "Initiative", "Bravery", "Talent", "Experience", "Level"
	];

	// ВАЖНО: инжектованный nested_tooltips getTooltip возвращает обёртку {Tooltip, Data},
	// а не саму таблицу — нужен .Tooltip (как в generateNestedTextFromObjCallback фреймворка).
	local conceptTable = ::MSU.System.Tooltips.getTooltip(::ReforgedLite.ID, "Concept").Tooltip;
	foreach (concept in autoConcepts)
	{
		local c = concept;
		conceptTable[c] <- ::MSU.Class.CustomTooltip(@(_) ::TooltipEvents.general_queryUIElementTooltipData(::MSU.getDummyPlayer().getID(), "character-stats." + c, null));
	}
});
