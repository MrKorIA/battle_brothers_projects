// Умения, упоминаемые по имени в текстах ванили (аудит) — [имя|Skill+файл] в скоупе vanilla.
// Коллизии имён у ванили: «Отбрасывание» (knock_back/fling_back) и «Размах» (swing/ghost_swing) —
// цели выбраны по контексту упоминаний; «Оглушение»/«Выбит дух»/«Пойман в сеть» НЕ дублируем —
// они уже в базовом словаре с целями-эффектами.
::ReforgedLite.ModSkillTooltips.addTerms([
	{ Term = "Стена щитов", Link = "Skill+shieldwall" },
	{ Term = "Стена копий", Link = "Skill+spearwall" },
	{ Term = "Контратака", Link = "Skill+riposte" },
