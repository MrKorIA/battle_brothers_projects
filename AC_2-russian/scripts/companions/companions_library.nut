local gt = this.getroottable();
if (!("Companions" in gt.Const))
{
	gt.Const.Companions <- {};
}
// these are x10, I don't change it to proper percentage to not confuse Autopilot New tame behavior
gt.Const.Companions.TameChance <- {
	Default = 30.0
	Beastmaster = 45.0 // not used anymore
};
gt.Const.Companions.TypeList <- {
	Wardog = 0,
	WardogArmor = 1,
	WardogArmorHeavy = 2,
	Warhound = 3,
	WarhoundArmor = 4,
	WarhoundArmorHeavy = 5,
	Warwolf = 6,
	Direwolf = 7,
	DirewolfFrenzied = 8,
	Hyena = 9,
	HyenaFrenzied = 10,
	Spider = 11,
	Snake = 12,
	Nacho = 13,
	Alp = 14,
	Unhold = 15,
	UnholdArmor = 16,
	Schrat = 17,
	Noodle = 18,
	TomeReanimation = 19,
	XXMobLion = 20,
	XXMobLiger = 21,
	XXMobBear = 22,
	XXMobBoar = 23,
	XXMobWhiteWolf = 24,
	XXMobToad = 25,
	XXMobBloodsucker = 26
};
local tl = Const.Companions.TypeList;
gt.Const.Companions.ClassToType <- {
	wardog = tl.Wardog
	armored_wardog = tl.WardogArmor
	// ..." = // "mod_AC_WardogArmorHeavy",
	warhound = tl.Warhound //"Волкодав",
	// ..." = //"Волкодав в броне",
	// ..." = //"mod_AC_WarhoundArmorHeavy",
	warwolf = tl.Warwolf // "Волк",
	direwolf = tl.Direwolf // "Лютоволк",
	direwolf_high = tl.DirewolfFrenzied
	hyena = tl.Hyena // ""Гиена",
	hyena_high = tl.HyenaFrenzied // "Бешеная гиена",
	spider = tl.Spider //"Сетеплёт",
	serpent = tl.Snake //"Аспид",
	ghoul = tl.Nacho // "Нахцерер",
	alp = tl.Alp // "Альп",
	unhold = tl.Unhold // "Тролль",
	unhold_bog = tl.Unhold
	unhold_armored = tl.UnholdArmor //"Тролль в броне",
	unhold_frost = tl.Unhold
	unhold_frost_armored = tl.UnholdArmor
	schrat = tl.Schrat //"Леший",
	lindwurm = tl.Noodle // "Линдвурм",
	// mod_AC_TomeReanimation =
	xxmob_lion = tl.XXMobLion // "Лев",
	xxmob_liger = tl.XXMobLiger // "Тигр",
	xxmob_bear = tl.XXMobBear // "Медведь-Убийца",
	xxmob_boar = tl.XXMobBoar // "Шиповепрь",
	xxmob_whitewolf = tl.XXMobWhiteWolf // "Снежный Лютоволк",
	xxmob_toad = tl.XXMobToad // "Гигантская Жаба",
	xxmob_bloodsucker = tl.XXMobBloodsucker // "Кровосос",
}
gt.Const.Companions.getType <- function (_target) {
	if (!(_target.ClassName in gt.Const.Companions.ClassToType)) return null;
	return gt.Const.Companions.ClassToType[_target.ClassName];
}
