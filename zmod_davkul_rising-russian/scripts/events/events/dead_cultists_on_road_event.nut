this.dead_cultists_on_road_event <- this.inherit("scripts/events/event", {
	m = {},
	function create()
	{
		this.m.ID = "event.dead_cultists_on_road";
		this.m.Title = "По дороге...";
		this.m.Cooldown = 9999.0 * this.World.getTime().SecondsPerDay;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_70.png[/img]{Старик с повязкой, закрывающей один глаз, устало сидит на обгоревшей телеге, которая съехала с дороги и опрокинулась в канаву. Вокруг него развернулись свидетельства недавней кровавой битвы: мёртвые мулы и кони, убитые караванщики, охранники и культисты, облачённые в одежды из человеческой кожи. Трупы лежат на огромной протяженности, покрывая сотни метров каменной дороги. В стороне от места битвы вы наблюдаете несколько догорающих погребальных костров. Желая узнать, что же здесь случилось, вы обращаетесь к старику, который, похоже, нисколько не беспокоится о произошедшем вокруг.%SPEECH_ON%А сам-то как думаешь? Культисты напали на караван из засады, но сами в итоге попали в засаду варваров, которые и разбили наголову нечестивцев. Эти костры - последняя дань воинам, сражённым в этом бою. А культистов оставили на корм падальщикам.%SPEECH_OFF%Как будто желая подтвердить слова старика, сидящая неподалёку ворона каркнула и принялась выклёвывать глаз лежащему подле неё культисту. Наблюдая за птицей, старик усмехнулся и обратился к вам.%SPEECH_ON%Древнее зло пытается восстать, наёмник. С каждым днём оно набирает силу от жертвоприношений в его честь и молитв, которые возносят бесчисленные культисты. Фанатики словно пробудились: начали захватывать в плен людей, устраивать логова возле городов и сёл. Как паразиты, что нашли жертву и будут теперь пить её кровь до тех пор, пока не осушат досуха. Чем больше сил они вернут своему богу, тем дальше культисты запустят свои чёрные руки. Варвары же, похоже, желают помешать возрождению Давкула. И не удивительно: по легенде древние боги запечатали одного из них, сошедшего с ума и решившего уничтожить всё живое. Но печать постепенно слабеет и нам придётся приложить все усилия, чтобы остановить слуг тьмы.%SPEECH_OFF%Слова старца прерывает гром, спугнувший стаю ворон. Однако вас беспокоит не столько гром, сколько культист, который только что лежал совершенно мёртвый. Его тело, неестественно дрожа и выгибаясь, поднялось. Недоклёванный вороной глаз вывалился из глазницы и безвольно свисает. Мертвец захохотал неестественным смехом, от которого у вас, у бывалого воина, от ужаса поднялись дыбом волосы.%SPEECH_ON%Ваше время прошло. Моё - только начинается. Тьма грядёт, и от неё не укрыться щитом и мечом. Я вернусь, и вам этого не остановить.%SPEECH_OFF%Раскаты грома становятся громче, а труп, издавая то ли смех, то ли лай, начинает ползти к вам. Оцепенение охватило вас подобно магии, и даже сделать вздох кажется сложной задачей. Однако, всё закончил старик, раскроив череп трупа двуручным молотом. Сплюнув наземь, он посмотрел на упокоившийся труп.%SPEECH_ON%Болтать всякий горазд.%SPEECH_OFF%}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Похоже, у клана свои счёты с этими культистами.",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}

		});
	}

	function onUpdateScore()
	{
		if (this.World.getTime().Days < 5) return 
		local currentTile = this.World.State.getPlayer().getTile();

		if (!currentTile.HasRoad)
		{
			return;
		}


		this.m.Score = 20;
	}

	function onPrepare()
	{
	}

	function onPrepareVariables( _vars )
	{
	}

	function onClear()
	{
	}

});

