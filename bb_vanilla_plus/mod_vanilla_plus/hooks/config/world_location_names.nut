::Const.World.RF_LocationDescriptions <- {};
::Const.World.RF_LocationDescriptions.RF_DraugrBarrows <- [
	"Обычная каменная вершина среди холмов, источённая ветром и покрытая травой. Но вороны почему-то избегают её.",
	"Старый курган, расколотый морозом или глупцами. Пахнет хладным железом и старыми молитвами.",
	"Говорят, это просто семейный курган. Вот только слишком уж в нём оживлённо...",
	"Сперва этот холм кажется вполне обычным, - пока вы не замечаете каменную кладку под мхом.",
	"За этими могилами поколениями никто не ухаживал, но на надгробиях видны свежие царапины...",
	"Какой-то парень видел дымок, вьющийся из кургана на рассвете. Но под землей же нет печных труб, правда?",
	"Говорят, оттуда исходит холод. Холод... и что-то ещё...",
	"Варварский род когда-то хоронил там своих соплеменников. Теперь они опасаются даже взглянуть в эту сторону.",
	"Вы найдете старые монеты и, возможно, пару клинков в грязи. Но не забываёте о тех, кого вы разбудите, потянувшись за ними.",
	"Просто начинай копать. Но не удивляйся, если не ты один начнешь шевелиться, когда лопата ударит о камень."
];
::Const.World.RF_LocationDescriptions.RF_DraugrCrypt <- [
	"Местные говорят, что там спит герой с мечом на груди. Другие говорят, что он больше не спит.",
	"Место было запечатано руническим камнем, который никто не мог прочесть. Теперь дверь открыта, и что-то наблюдает изнутри.",
	"В той крипте не просто кости. Там имена, титулы, почести, давно ставшие горькими.",
	"Раньше люди приходили сюда издалека, дабы выразить своё почтение. Теперь даже вороны держатся подальше.",
	"Над входом вырезано имя, стёртое временем. Возможно, будет даже лучше, если оно останется непрочитанным.",
	"Эта крипта была не просто построена. Она была запечатана, словно кто-то хотел, чтобы то, что находится внутри, осталось там навсегда.",
	"Посмертные дары уже давно украдены. Во всяком случае, так говорила последняя шайка грабителей - перед тем, как бесследно исчезнуть.",
	"Воины, похороненные там, последовали за своим вождем даже в смерть. Беда в том, что они всё идут за ним.",
	"Вы всё ещё можете увидеть руны на стенах, если принесёте факел. Только не читайте их вслух.",
	"Внизу раздается эхо стали, словно кто-то всё ещё тренируется с мечом, который должен был положить столетия назад."
];
::Const.World.RF_LocationDescriptions.RF_DraugrFane <- [
	"Залы высечены прямо в горе, большие, словно замок благородного дома. Но внутри не горят огни. Лишь эхо.",
	"Это место должно было встретить конец света. Быть может, мертвецы внутри думают, что он уже наступил.",
	"Говорят, там лежат короли со своими племенами. И их глаза всё ещё открыты.",
	"Стены украшены каменными барельефами. Короли, битвы, пожары. Но последняя история ещё не закончена.",
	"Сейчас так никто не строит. Возможно, у этого есть веские причины.",
	"Мертвые были здесь похоронены не ради покоя. Они ждут...",
	"Иногда изнутри слышна музыка. Рога и барабаны, будто в начале пира. Но пир ещё не начался...",
	"Даже воздух внутри этой горы кажется тяжёлым, словно гора пытается сохранить свои секреты.",
	"Там спит вождь со всей своей дружиной. Но быть может, они лишь притворяются спящими...",
	"Кости одеты в золото и меха, как при жизни. И они охраняют их теми же руками."
];
{	// Cave Names
	::Const.World.LocationNames.Cave <- [];

    local cavePrefix = [
        "Бездонн",
        "Безымянн",
        "Глубок",
        "Гнил",
        "Грязн",
        "Забыт",
        "Заброшенн",
        "Занят",
        "Зловещ",
        "Каменн",
        "Кровав",
        "Мокр",
        "Мрачн",
        "Неисследованн",
        "Проклят",
        "Пуст",
        "Пыльн",
        "Скалист",
        "Скрыт",
        "Смердящ",
        "Темн",
        "Тенев",
        "Угрюм",
        "Холодн",
        "Черн"
    ]

	local caveSynonym = [
    	"ая Берлога",
    	"ая Впадина",
    	"ая Каверна",
    	"ая Нора",
    	"ая Пещера",
    	"ая Полость",
    	"ая Расселина",
    	"ая Яма",
    	"ое Гнездо",
    	"ое Логово",
    	"ое Убежище",
    	"ое Ущелье",
    	"ой Грот",
    	"ой Провал",
    	"ый Туннель",
    	"ый Ход"
    ]

	foreach (prefix in cavePrefix)
	{
		foreach (synonym in caveSynonym)
		{
			::Const.World.LocationNames.Cave.push(prefix + synonym);
		}
	}
}

{	// WitchHut Names
	::Const.World.LocationNames.WitchHut <- [];

	local witchPrefix = [
		"Заколдованный",
		"Старая карга",
		"Проклятый лес",
		"Проклятый",
		"Изогнутый",
		"Обманщица",
		"Ведьма",
		"Колдовской корень"
