this.fantasy_monster_encounter_13_event <- this.inherit("scripts/events/event", {
	m = {
		HedgeKnight1 = null
	},
	function create()
	{
		this.m.ID = "event.fantasy_monster_encounter_13_event";
		this.m.Title = "На привале...";
		this.m.Cooldown = 30.0 * this.World.getTime().SecondsPerDay;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_39.png[/img]{Компания %companyname% остановилась, чтобы сделать небольшой перерыв. Во время разжигания костра, разбивки лагеря и приготовления еды каждый член команды отдыхает и проводит время по своему усмотрению. Вы задаетесь вопросом, чем заняться во время перерыва.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Посмотрите, что делают другие участники.",
					function getResult( _event )
					{
						switch(this.Math.rand(1, 4))
						{
							case 1:	return "B";
							case 2:	return "B";
							case 3:	return "C";
							case 4:	return "D";
						}
					}
				},
				{
					Text = "Отдохни в одиночестве.",
					function getResult( _event )
					{
						return 0;
					}
				}
			],
			function start( _event )
			{
			}
		});
		this.m.Screens.push({
			ID = "B",
			Text = "[img]gfx/ui/events/event_26.png[/img]{%SPEECH_ON%{И я сказал: «Дружище, в моих штанах спрятан сияющий священный меч, он светится так ярко, что может заставить сдаться любую женщину. Даже дракониха задрожит в его присутствии. Одна девушка попросила показать ей мой священный меч, поэтому я забронировал номер и попросил ее принести выпивку для этого случая. | Нет, я действительно видел это собственными глазами. Два недержательных человека, спутавшиеся в объятиях, занимались интимными ласками. Честно говоря, я не знаю, кто из них женщина. Черт, насколько я знаю, они могут быть оба мужчинами. Их стоны были громче и грязнее, чем звук моего кала после недельного задерживания. | Если у него голова курицы и тело льва, то это грифон? Или кокатрис? Интересно, каким будет его мясо на вкус. Должно быть, оно стоит того, чтобы рисковать своей жизнью, не так ли? | Северные варвары плохо пьют. Выпив стакан эля «Василиск», он выблевал все, что было в желудке, и умолял меня спасти его. Блядь. Южные мудаки не разбираются ни в алкоголе, ни в женщинах, так что о них говорить не стоит. | Да, да, он был таким мудаком. Однажды он пытался сделать это с мертвой нежитью. Этот ублюдок — сумасшедший ублюдок, который трахается в любую дырку. Причина, по которой он недавно заболел, вероятно, в том, что он трахнул задницу мертвого Унхолда. | Волшебники – люди, которым нельзя доверять. Вы когда-нибудь видели, чтобы они спали с женщинами? Говорят, что волшебник никогда не должен вступать в половые отношения, чтобы сохранить свои мистические силы. Но я думаю иначе. Чтобы удовлетворить свои желания, они каждую ночь тайно похищают кобыл, чтобы удовлетворить свои грязные желания и высасывать из них жизненную силу. Прямо как некроманты. Я видел это собственными глазами? Вы верите в Бога и молитесь Ему, потому что видели Его собственными глазами? | В прошлый раз было действительно плохо. Я был так чертовски пьян, что переспал с чертовой старой ведьмой. Когда я проснулся в тот день, мне показалось, что я проснулся на кладбище рядом со скелетом. Это был худший день в моей жизни. К счастью, я не засунул свой член в лошадь или дыню. Если бы это было так, я бы покончил с собой. Что? Она даже не была женщиной? Блядь, наверное, я должен покончить с собой. | Ты ничего не знаешь. Если ты однажды трахнешь мужчину в задницу, ты больше никогда не сможешь трахать женщину. Что? Ты думаешь, я буду трахать своих братьев? Да пошел ты, у меня тоже есть глаза. Даже не мечтай об этом, потому что я не буду вставлять его в твою грязную задницу. | Мой первый опыт? Было весело играть руками, глядя на сексуальную женщину. {лошадь | корова | коза | собака | кошка}\'s {задница | киска}. Однажды, когда я хорошо проводил время, мой {мама | папа | брат | сестра} увидел меня. С тех пор моя жизнь превратилась в кошмар, и теперь я зарабатываю деньги, убивая людей, блядь. | Жизнь, состоящая из пьянства, секса с женщинами и зачатия детей, не приносит удовольствия. Я чувствую себя живым только на поле боя. Ничто не может сравниться с удовольствием, которое я испытываю, когда вижу, как мой враг умирает на перекрестке между жизнью и смертью, где на карту поставлена моя жизнь. Вот почему я не могу перестать этим заниматься. | Что для меня значит выход на пенсию, {Одинокий | Воинственный | Безжалостный | Непобедимый | Холод} {Adventurer | Gambler | Холостяк | Охотник | Волк | Убийца}? {Жениться на обычной женщине, завести детей на сэкономленные деньги, а потом умереть в постели, как простой смертный. | Встретить сильного противника на поле боя и погибнуть с честью после ожесточенной битвы. | Стоять там с ухмылкой на лице, пока босс, который нас контролирует, увольняет меня, вот что такое пенсия.} Но меня больше интересует, будут ли сегодня вечером снова подавать ту же отвратительную еду, что я ел вчера, чем жизнь после выхода на пенсию.}%SPEECH_OFF%Болтал взволнованно %randombrother% у костра. Члены группы смеялись или подшучивали. Вы решили послушать, пока не будет готова еда.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Ха, забавно",
					function getResult( _event )
					{
						return 0;
					}
				}
			],
			function start( _event )
			{
				local brothers = this.World.getPlayerRoster().getAll();
				foreach( bro in brothers )
				{
					if (this.Math.rand(1, 100) <= 25)
					{
						bro.worsenMood(0.5, "Чувствует себя хуже");
						this.List.push({
							id = 10,
							icon = this.Const.MoodStateIcon[bro.getMoodState()],
							text = bro.getName() + this.Const.MoodStateEvent[bro.getMoodState()]
						});
					}
					else
					{
						bro.improveMood(0.5, "Чувствует себя лучше");
						this.List.push({
							id = 10,
							icon = this.Const.MoodStateIcon[bro.getMoodState()],
							text = bro.getName() + this.Const.MoodStateEvent[bro.getMoodState()]
						});
					}
				}
			}
		});
		this.m.Screens.push({
			ID = "C",
			Text = "[img]gfx/ui/events/event_26.png[/img]{%hedgeknight1% кричит и ругается. Возможно, была проблема с лекарством, которое я купил у {торговца | алхимика} вчера. Лекарство, безусловно, кажется эффективным. Однако его действие выглядело совсем иначе %hedgeknight1% хвастался вчера. %hedgeknight1% потерял все волосы на теле и выглядел как уродливый альп. Члены группы разразились смехом, когда увидели его %hedgeknight1%\'s несчастье. Если один человек несчастлив, а все остальные счастливы, то это все. | Когда вы подошли к месту, где шумно собрались участники, вы заметили %hedgeknight1% снова ведет себя как придурок.%SPEECH_ON%Ну что ж, ребята, на этот раз я абсолютно уверен, что у меня все получится, так что обязательно сделайте ставку на мой успех. Все готовы? Начинаем.%SPEECH_OFF%%hedgeknight1% сразу же закричал, зажег несколько мечей и начал жонглировать ими. Но вскоре он потерял равновесие, уронил меч, и пламя обожгло шерсть на его теле. К счастью, он не погиб и доставил зрителям огромное удовольствие. Это было фантастическое представление. | Похоже, участники играют в алкогольную игру. Хвастливый %hedgeknight1%, полный бравады, крикнул.%SPEECH_ON%HЭй, ребята, я ни разу в жизни не был пьян!%SPEECH_OFF%Он выпил целую бочку крепкого алкоголя, а затем издал громоподобный рык и начал выплевывать все, что было в его желудке. Его громкий звук и внешний вид напоминали дракона. Члены группы разразились смехом, увидев это \'Vomit Dragon\'. Базилиск-эль, который он пил, был настолько крепким, что, если бы он не разбавлял его водой, температура его тела поднялась бы настолько, что все волосы на его теле выпали бы. С завтрашнего дня ему больше не нужно мыть голову.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Ха, забавно",
					function getResult( _event )
					{
						return 0;
					}
				}
			],
			function start( _event )
			{
				local actor = _event.m.HedgeKnight1;
				local hair = actor.getSprite("hair");
				hair.setBrush("");
				local beard = actor.getSprite("beard");
				beard.setBrush("");
				local beard_top = actor.getSprite("beard_top");
				beard_top.setBrush("");
				this.Characters.push(actor.getImagePath());
				local brothers = this.World.getPlayerRoster().getAll();
				foreach( bro in brothers )
				{
					if (bro == actor)
					{
						bro.worsenMood(1, "Чувствует себя хуже");
						this.List.push({
							id = 10,
							icon = this.Const.MoodStateIcon[bro.getMoodState()],
							text = bro.getName() + this.Const.MoodStateEvent[bro.getMoodState()]
						});
					}
					else
					{
						bro.improveMood(1, "Чувствует себя лучше");
						this.List.push({
							id = 10,
							icon = this.Const.MoodStateIcon[bro.getMoodState()],
							text = bro.getName() + this.Const.MoodStateEvent[bro.getMoodState()]
						});
					}
				}
				local injury = actor.addInjury(this.Const.Injury.Brawl);
				this.List.push({
					id = 10,
					icon = injury.getIcon(),
					text = actor.getName() + " страдает от " + injury.getNameOnly()
				});
				actor.addLightInjury();
			}
		});
		this.m.Screens.push({
			ID = "D",
			Text = "[img]gfx/ui/events/event_26.png[/img]{%hedgeknight1% подошел к вам с блюдом.%SPEECH_ON%Сегодня я приготовила особенное блюдо. Это специальный рецепт моей мамы. Мужчины в моем родном городе тоже очень любили это блюдо, поэтому каждый день поздно вечером приходили к моей маме.%SPEECH_OFF%Вы спросили, была ли у его матери паб или таверна.%SPEECH_ON%Нет. Мы с мамой жили в доме в отдаленном лесу, вдали от деревни. Мама была деревенской травницей. А отец? Я его никогда не видел. Наверное, он был негодяем, который бросил жену с ребенком и сбежал.%SPEECH_OFF%%hedgeknight1%\'s Специальное блюдо выглядело странно и даже пахло отвратительно. Вы задавались вопросом, можно ли это есть, но, увидев, что другие участники хорошо его едят, вы потихоньку попробовали. Сначала блюдо показалось отвратительным, но чем больше я его ел, тем больше оно мне нравилось. Вы спросили %hedgeknight1% если он когда-нибудь пытался найти своего отца.%SPEECH_ON%Нет. На самом деле, в моем родном городе было много мужчин, которые бросали своих детей и убегали. Поскольку все были в похожей ситуации, я не думал о том, чтобы их искать. Даже мужчины, которые приходили к моей матери посреди ночи и получали от них еду, вскоре бросали свои семьи и убегали куда-то. Большинство взрослых мужчин в моей деревне были ублюдками.%SPEECH_OFF%Тебе кажется странной история %hedgeknight1%\'s История. Женщина, живущая в отдаленной деревне, и мужчины из деревни, которые продолжают исчезать. Вам вспоминается история о Хексен, монстре, который принимает облик женщины и пожирает мужчин. Вы пытались думать дальше, но ваше сознание вскоре затуманилось от сильной усталости.....\n\n\n\n\nЧерез некоторое время вы и члены группы проснулись. %hedgeknight1% засмеялся и спросил, не устали ли все. Вы не совсем помните, что произошло, но, похоже, члены группы предлагали вам крепкие напитки. %hedgeknight1% сказал, что положил оставшиеся блюда в повозку. Какие блюда? Вы не помните. | %hedgeknight1% подошел к вам с блюдом.%SPEECH_ON%Босс, я приготовил сегодня особенное блюдо. Оно приготовлено по секретному рецепту из моего родного города. Попробуйте.%SPEECH_OFF%Блюдо выглядело отвратительно и даже пахло странно. Тем не менее, вы съели немного, думая о его искренности.%SPEECH_ON%В моем родном городе, когда я был обеспокоен или устал, я просто съедал тарелку этого блюда, и все проблемы решались. Как вам? Вкусно?%SPEECH_OFF%Сначала оно показалось отвратительным, но чем больше вы ели, тем больше оно вам нравилось. Во время еды вы внезапно погрузились в глубокий сон. В своем угасающем сознании вы видели, как другие члены команды тоже падали.%SPEECH_ON%Вы хорошо выспитесь и забудете все, когда проснетесь, босс.%SPEECH_OFF%\n\n\n\n\nЧерез некоторое время вы и члены группы проснулись. %hedgeknight1% засмеялся и спросил, не устали ли все. Вы не совсем помните, что произошло, но, похоже, члены группы предлагали вам крепкие напитки. %hedgeknight1% сказал, что положил оставшиеся блюда в повозку. Какие блюда? Вы не помните. | %hedgeknight1% подошел к вам с блюдом.%SPEECH_ON%Сегодня я был дежурным поваром, поэтому приготовил особенное блюдо. Оно будет очень вкусным.%SPEECH_OFF%Блюдо выглядело отвратительно и даже пахло странно. Тем не менее, вы съели немного, думая о его искренности.%SPEECH_ON%Как вам? Вкусно? Недавно я был в деревне, где старая бабушка продавала эту еду, и она мне понравилась, поэтому я узнал рецепт.%SPEECH_OFF%После того, как вы съели всю эту отвратительную еду, вам стало плохо и вы почувствовали усталость. Ваши глаза медленно закрываются.\n\n\n\n\nЧерез некоторое время вы и члены группы проснулись. %hedgeknight1% засмеялся и спросил, не устали ли все. Вы не совсем помните, что произошло, но, похоже, члены группы предлагали вам крепкие напитки. %hedgeknight1% сказал, что положил оставшиеся блюда в повозку. Какие блюда? Вы не помните.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Я устал...",
					function getResult( _event )
					{
						return 0;
					}
				}
			],
			function start( _event )
			{
				local actor = _event.m.HedgeKnight1;
				this.Characters.push(actor.getImagePath());
				local brothers = this.World.getPlayerRoster().getAll();
				foreach( bro in brothers )
				{
					if (bro == actor)
					{
						bro.improveMood(1, "Чувствует себя лучше");
						this.List.push({
							id = 10,
							icon = this.Const.MoodStateIcon[bro.getMoodState()],
							text = bro.getName() + this.Const.MoodStateEvent[bro.getMoodState()]
						});
					}
					else
					{
						bro.worsenMood(1, "Чувствует себя хуже");
						this.List.push({
							id = 10,
							icon = this.Const.MoodStateIcon[bro.getMoodState()],
							text = bro.getName() + this.Const.MoodStateEvent[bro.getMoodState()]
						});
					}
				}
				if (this.Math.rand(1, 100) <= 33)
				{
					this.World.Assets.getStash().add(this.new("scripts/items/supplies/strange_meat_item"));
				}
				else
				{
					this.World.Assets.getStash().add(this.new("scripts/items/supplies/black_marsh_stew_item"));
				}
			}
		});
	}

	function onUpdateScore()
	{
		if (this.World.getTime().Days < 10)
		{
			return;
		}

		local brothers = this.World.getPlayerRoster().getAll();
		local candidates = [];
		local rr = 2;
		foreach( bro in brothers )
		{
			if (bro.getSkills().hasSkill("trait.player"))
			{
				continue;
			}

			if (!bro.getSkills().hasSkill("effects.xxzzfantasy_skill"))
			{
				candidates.push(bro);
			}
		}
		if (candidates.len() < rr)
		{
			return;
		}
		rr = this.Math.rand(0, candidates.len() - 1);
		this.m.HedgeKnight1 = candidates[rr];
		candidates.remove(rr);
		this.m.Score = 3;
	}

	function onPrepare()
	{
	}

	function onPrepareVariables( _vars )
	{
		_vars.push([
			"hedgeknight1",
			this.m.HedgeKnight1.getName()
		]);
	}

	function onClear()
	{
		this.m.HedgeKnight1 = null;
	}

});

