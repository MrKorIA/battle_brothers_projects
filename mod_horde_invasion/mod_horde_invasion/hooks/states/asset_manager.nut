// Эпилог кампании для кризиса «Нашествие Железной Орды».
// Ванильный asset_manager.getGameFinishData (ветка GreaterEvilsDefeated >= 1)
// собирает текст концовки по GreaterEvil.LastType: ветки есть для CivilWar/
// Greenskins/Undead/HolyWar, а тип Horde ему неизвестен — музыка, ачивка,
// картинка и removeSuccessor отрабатывают, а data.Text и «братские» концовки
// остаются пустыми. Оборачиваем: после оригинала для LastType == Horde
// досоздаём ветку по образцу ванильной Greenskins-ветки.
::HordeInvasion.HooksMod.hook("scripts/states/world/asset_manager", function(q) {
	q.getGameFinishData = @(__original) { function getGameFinishData( _gameWon )
	{
		local data = __original(_gameWon);

		if (_gameWon
			&& this.World.Statistics.getFlags().get("GreaterEvilsDefeated") >= 1
			&& this.World.FactionManager.getGreaterEvil().LastType == ::Const.World.GreaterEvilType.Horde)
		{
			local brothers = this.World.getPlayerRoster().getAll();
			local excludedBackgrounds = [];

			// убрать преемника из пула «братских» концовок (оригинал уже отработал,
			// но со СВОИМ массивом — повторяем на нашем, idempotent)
			this.removeSuccessor(brothers);

			data.Text = "{Когда вы возглавили отряд \'%companyname%\', вы мечтали о славе и золоте, но не о войне, от которой содрогнулась бы вся земля. Чурчжэни и степняки, веками резавшие друг друга, внезапно пошли под одним знаменем великого хана, и благородные дома, забыв свои распри, встали стеной за свою независимость.\n\n Быть может, летописцы и не назовут \'%companyname%\' среди героев той войны, но вы-то знаете, как было на самом деле: именно ваши мечи сдерживали натиск орды, пока дворяне собирали ополчения, жгли склады пороха и резали обозы. А когда великий хан сгинул в походе, и две орды вновь раздробились, на ваших счетах оказалось золота больше, чем в сокровищницах некоторых лордов.\n\n Вы решили, что добыли достаточно, и отошли от дел, оставив отряд на самого достойного из братьев. | Приняв командование над отрядом \'%companyname%\', вы надеялись на богатство и честь — но не на то, что мир рухнет под ударами Железной Орды. Великий хан, объединив чурчжэней и степняков, потребовал от благородных домов дани и коленопреклонения. Дворяне ответили единым фронтом, и их война за независимость стала золотой жилой для всякого, кто умел держать меч и не задавать лишних вопросов.\n\n Отвага отряда \'%companyname%\' в тех битвах не нуждается в преувеличениях: склады пороха горели, обозы не доходили до стана, и однажды с востока пришла весть, что великий хан сгинул в походе, а союз чурчжэней и степняков рассыпался так же быстро, как и собрался. С тех пор у вас больше крон, чем забот.}";

			data.Text += this.addBrotherEnding(brothers, excludedBackgrounds, true);
			data.Text += this.addBrotherEnding(brothers, excludedBackgrounds, true);
			data.Text += "\n\n{Иногда пахнущий порохом ветер с востока всё ещё пробуждает в вас старые воспоминания, и вы засыпаете с мыслью о сотнике, так и не встреченном в чистом поле. | Теперь единственная осада, что вам грозит, — это осада соседских детей, желающих послушать истории о Железной Орде. Вы рассказываете. Слишком охотно рассказываете. | На днях к вам зашёл странствующий летописец, искавший сведений о \'той самой орде с востока\'. Вы выслушали его вопросы, налил ему вина и в итоге рассказали ровно столько, чтобы ваше имя в его книге оказалось крупнее, чем имена дворян.}";
			data.Text = this.buildGameFinishText(data.Text);
		}

		return data;
	}}.getGameFinishData;
});
