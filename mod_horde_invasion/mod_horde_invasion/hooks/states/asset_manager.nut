// Эпилог кампании для кризиса «Нашествие Великой Орды».
// Ванильный asset_manager.getGameFinishData (ветка GreaterEvilsDefeated >= 1)
// собирает текст концовки по GreaterEvil.LastType: ветки есть для CivilWar/
// Greenskins/Undead/HolyWar, а тип Horde ему неизвестен — музыка, ачивка,
// картинка и removeSuccessor отрабатывают, а data.Text и «братские» концовки
// остаются пустыми. Оборачиваем: после оригинала для LastType == Horde
// досоздаём ветку по образцу ванильной Greenskins-ветки.
::HordeInvasion.HooksMod.hook("scripts/states/world/asset_manager", function(q) {
	q.getGameFinishData = @(__original) { function getGameFinishData( _gameWon )
	{
		local data = __original(_gameWon);

		if (_gameWon
			&& this.World.Statistics.getFlags().get("GreaterEvilsDefeated") >= 1
			&& this.World.FactionManager.getGreaterEvil().LastType == ::Const.World.GreaterEvilType.Horde)
		{
			local brothers = this.World.getPlayerRoster().getAll();
			local excludedBackgrounds = [];

			// убрать преемника из пула «братских» концовок (оригинал уже отработал,
			// но со СВОИМ массивом — повторяем на нашем, idempotent)
			this.removeSuccessor(brothers);

			data.Text = "{Когда вы возглавили отряд \'%companyname%\', вы мечтали о славе и золоте, но не о войне, от которой содрогнулась бы вся земля. Чжурчжэни и степняки, веками резавшие друг друга, внезапно выступили под единым знаменем великого хана, и благородные дома, забыв старые распри, встали стеной на защиту своих земель.\n\nБыть может, придворные летописцы и не упомянут \'%companyname%\' среди героев той войны, но вы-то знаете, как всё было на самом деле. Именно ваши клинки сдерживали первый натиск Орды: пока лорды спешно собирали ополчение, вы жгли склады с чёрным порохом и пускали под нож вражеские обозы. А когда великий хан сгинул в походе, и обе орды вновь раскололись, в вашей казне оказалось золота больше, чем в сокровищницах иных правителей.\n\nВы решили, что добыли достаточно, и отошли от дел, передав знамя отряда самому достойному из братьев. | Приняв командование над отрядом \'%companyname%\', вы надеялись на звонкую монету и честь — но не на то, что привычный мир едва не рухнет под ударами Великой Орды. Великий хан, объединив чжурчжэней и степняков, потребовал от благородных домов дани и рабской покорности. Лорды ответили на это единым фронтом, и кровопролитная война за свободу щедро озолотила всякого, кто умел держать меч и не задавать лишних вопросов.\n\nОтвага бойцов \'%companyname%\' в тех сечах не нуждается в прикрасах: склады пороха горели, обозы не доходили до стана, и однажды с востока пришла весть, что великий хан сгинул в походе, а союз чжурчжэней и степняков рассыпался так же стремительно, как и сложился. С тех пор у вас гораздо больше крон, чем забот.}";

			data.Text += this.addBrotherEnding(brothers, excludedBackgrounds, true);
			data.Text += this.addBrotherEnding(brothers, excludedBackgrounds, true);
			data.Text += "\n\n{Иногда принесённый с востока ветер, едва уловимо пахнущий пороховой гарью, всё ещё будит в вас старые воспоминания, и вы засыпаете с мыслью о великом хане, так и не встреченным вами в чистом поле. | Теперь единственная осада, что вам грозит, — это шумная осада соседских ребятишек, наперебой просящих рассказать байки о Великой Орде. И вы рассказываете. Пожалуй, даже слишком охотно рассказываете. | На днях на ваш порог заглянул странствующий летописец, собиравший сведения о \'той самой орде с востока\'. Вы терпеливо выслушали его расспросы, щедро налили ему доброго вина и в итоге поведали ровно столько, чтобы ваше имя на страницах его хроники оказалось вписано куда крупнее, чем имена благородных лордов.}";
			data.Text = this.buildGameFinishText(data.Text);
		}

		return data;
	}}.getGameFinishData;
});
