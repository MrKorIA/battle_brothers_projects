// Прогревочное событие кризиса «Нашествие Великой Орды» (Warning-фаза).
// Образец — data_014/scripts/events/events/crisis/greenskins_warnings_event.nut.
// Смысл по TZ §2: великий хан захватил столицу чучженей и расширяет империю;
// подаётся через рассказы беженцев.
this.horde_warnings_event <- this.inherit("scripts/events/event", {
	m = {},
	function create()
	{
		this.m.ID = "event.crisis.horde_warnings";
		this.m.Title = "По пути...";
		this.m.Cooldown = 3.0 * this.World.getTime().SecondsPerDay;
		this.m.Screens.push({
			ID = "A",
			Text = "{[img]gfx/ui/events/event_59.png[/img]%randombrother% заглядывает в вашу палатку.%SPEECH_ON%Командир, у костра крестьяне с восточной границы. Говорят, у них срочные вести — и вид у них такой, будто за ними сама смерть гналась.%SPEECH_OFF%Вы выходите к огню. Прибывшие и впрямь выглядят так, словно бежали без оглядки через полцарства: лица обморожены стужей, одежда в лохмотьях, обуви на некоторых вовсе нет. Старший из них, однорукий мужик, сипло произносит:%SPEECH_ON%Вы, должно быть, тот самый капитан, о котором толкуют в городах? Тогда слушайте. Великий хан степняков захватил столицу чжурчжэней, и теперь обе их орды идут на запад под одним знаменем. Железная пехота,  лучники, обозы с чёрным порохом... Ни одна застава на границе не устояла. Мы все думали, что старые байки про вторжение — просто сказки, а они оказались нашим завтрашним днём.%SPEECH_OFF%Он делает жадный глоток из фляги и глухо продолжает:%SPEECH_ON%Мой вам совет, командир: держитесь подальше от востока, пока кто-нибудь из лордов не соберётся с духом дать им отпор.%SPEECH_OFF% | [img]gfx/ui/events/event_59.png[/img]На тракте вы натыкаетесь на бесконечную вереницу беженцев — гружёные тряпьём телеги скрипят колёсами, уползая на запад. Один из возчиков, завидев ваше знамя, придерживает коня.%SPEECH_ON%Не ходите на восток, воины. Сперва налетели степные всадники и выжгли деревни дотла, следом двинулась тяжёлая пехота чжурчжэней в железных латах, а за ней потянулись обозы с пороховыми бочками. Столица чжурчжэней пала — степной хан воссел на их троне и подчинил себе весь их народ. Люди кричали из-за стен, что заплатят любую дань, сколько потребуют, — да только слушать их никто не стал.%SPEECH_OFF%Возчик взмахивает поводьями и догоняет свою колонну. Вы смотрите ему вслед и понимаете: скоро эти дороги наводнит беженцами. | [img]gfx/ui/events/event_64.png[/img]У придорожного костра вы делите стоянку со старым бродячим наёмником — потрёпанным жизнью ветераном в кольчуге, изъеденной ржавчиной. Он угощает бойцов \'%companyname%\' вином и делится вестями.%SPEECH_ON%Я видел, как рушится мир, парни. Сперва по дорогам тянутся беженцы, затем над лесом встаёт чёрный дым, а потом на гребне холма появляется их строй... Степняки спелись с чжурчжэнями, слыхали? Веками резали друг друга, а теперь у них один хан, одно знамя и пороховые обозы до самого горизонта. Благородные дома пока грызутся между собой, решая, чья очередь умирать на стенах. Когда закончат спорить — будет уже поздно.%SPEECH_OFF%Он допивает вино и щурится, глядя на восток.%SPEECH_ON%Ну да ладно. Мой вам совет: пока местные господа не разобрались, кому из них быть трупом, а кому героем — на этой войне можно сорвать немалый куш.%SPEECH_OFF% | [img]gfx/ui/events/event_41.png[/img]К привалу вашего отряда подбирается купец с караваном из трёх телег — две из них пустуют. Он предлагает вам вина и, когда вы садитесь, долго крутит в пальцах обгоревший обрывок пергамента.%SPEECH_ON%Расписка за товар. Тридцать мер муки, доставить в приграничный острог. Видите дату? Позавчера. А вчера на месте острога я нашёл лишь дымящиеся головёшки. Степняки объединились с чжурчжэнями под единым знаменем, и у них с собой целый арсенал чёрного пороха. Одного взгляда на их орду хватает, чтобы понять: сдаваться бессмысленно. Они не берут пленных ради выкупа — они забирают всё, оставляя за собой голую землю.%SPEECH_OFF%Купец сжимает обрывок в кулаке и молча уходит к своим телегам. К вину вы так и не притронулись. | [img]gfx/ui/events/event_58.png[/img]Мимо походной колонны на взмыленном коне проносится королевский гонец — весь в пыли, с оборванным ремнём на седельной сумке. Он даже не придерживает скакуна, но успевает прохрипеть вам через плечо:%SPEECH_ON%Восточные земли молят о помощи! Столица чжурчжэней пала, великий хан степей воссел на троне завоевателя, и теперь обе орды идут на запад! Города горят, благородные дома спешно созывают ополчение! Передайте всем, кого встретите!%SPEECH_OFF%Всадник скрывается в густом облаке дорожной пыли. Наёмники мрачно переглядываются, а %randombrother% с досадой сплёвывает на землю.%SPEECH_ON%Скоро начнётся.%SPEECH_OFF%}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Это настораживает...",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}

		});
	}

	function onUpdateScore()
	{
		if (this.World.FactionManager.getGreaterEvilType() == this.Const.World.GreaterEvilType.Horde && this.World.FactionManager.getGreaterEvilPhase() == this.Const.World.GreaterEvilPhase.Warning)
		{
			local playerTile = this.World.State.getPlayer().getTile();

			if (!playerTile.HasRoad)
			{
				return;
			}

			local towns = this.World.EntityManager.getSettlements();

			foreach( t in towns )
			{
				if (t.getTile().getDistanceTo(playerTile) <= 4)
				{
					return;
				}
			}

			this.m.Score = 80;
		}
	}

	function onPrepare()
	{
	}

	function onPrepareVariables( _vars )
	{
	}

	function onClear()
	{
	}

});
