// Прогревочное событие кризиса «Нашествие Великой Орды» (Warning-фаза).
// Образец — data_014/scripts/events/events/crisis/greenskins_warnings_event.nut.
// Смысл по TZ §2: великий хан захватил столицу чучженей и расширяет империю;
// подаётся через рассказы беженцев.
this.horde_warnings_event <- this.inherit("scripts/events/event", {
	m = {},
	function create()
	{
		this.m.ID = "event.crisis.horde_warnings";
		this.m.Title = "По пути...";
		this.m.Cooldown = 3.0 * this.World.getTime().SecondsPerDay;
		this.m.Screens.push({
			ID = "A",
			Text = "{[img]gfx/ui/events/event_59.png[/img]%randombrother% заходит в вашу палатку.%SPEECH_ON%Командир, у костра крестьяне с восточной границы. Говорят, у них для вас вести — и они в отчаянии.%SPEECH_OFF%Вы выходите к костру. Прибывшие и вправду выглядят так, словно гнали их через полцарства: лица изуродованы стужей, обуви на некоторых нет. Старший, однорукий мужчина, говорит хрипло.%SPEECH_ON%Вы, должно быть, тот самый командир, о котором толкуют в городах? Тогда слушайте. Великий хан захватил столицу чурчжэней, и теперь обе их орды идут под одним знаменем: железная пехота, лучники, обозы с чёрным порохом. Ни одно поселение на границе не устояло. Мы все думали, что это сказки — а это был просто завтрашний день.%SPEECH_OFF%Он делает глоток из фляги и продолжает.%SPEECH_ON%Мой вам совет, командир: держитесь подальше от востока, пока кто-нибудь не соберётся с духом противостоять им. Или станьте таким сами — за работу против орды теперь платят золотом, а не обещаниями.%SPEECH_OFF% | [img]gfx/ui/events/event_94.png[/img]На дороге вы натыкаетесь на цепочку беженцев — повозки, навьюченные тряпьём, тащатся на запад. Один из возчиков, увидев ваше знамя, останавливается.%SPEECH_ON%Не ходите на восток, воины. Сначала пошли их всадники выжигать деревни, потом тяжёлая пехота в железных латах, а за ней обозы с бочками. Столица чурчжэней уже пала — их собственный хан сел в ней на троне. Люди кричали, что заплатят дань, сколько скажут, — а им и отвечать-то некому было.%SPEECH_OFF%Возчик взмахивает поводьями и догоняет свою колонну. Вы смотрите вслед и понимаете: запад теперь забит такими повозками. | [img]gfx/ui/events/event_76.png[/img]У придорожного костра вы встречаете старого наёмника — сбитого с ног миром человека с кольчугой, съеденной ржавчиной. Он делится с отрядом \'%companyname%\' вином и историей.%SPEECH_ON%Я видел, как гибнет мир, парни. Сначала по дороге идут беженцы, потом над лесом встаёт дым, потом их строй появляется на холме — и уже не уходит. Степняки с чурчжэнями вместе, слыхали? Раньше они резали друг друга веками, а теперь у них один хан, одно знамя и пороховые обозы до горизонта. Благородные дома пока спорят, чья очередь гнить в окопах. Когда кончат спорить — будет поздно.%SPEECH_OFF%Он допивает вино и смотрит на восток.%SPEECH_ON%Ну да ладно. Мой вам совет: пока они там не решили, кто из них марионетка, а кто герой — заработать можно на всём.%SPEECH_OFF% | [img]gfx/ui/events/event_97.png[/img]К вашему привалу подбирается купец с караваном из трёх телег — две из них пустые. Он предлагает вам вина и, когда вы садитесь, долго крутит в пальцах обгоревший обрывок свитка.%SPEECH_ON%Расписка за товар. Тридцать мер муки, доставить за границу. Видите дату? Позавчера. А вчера я нашёл только дымящиеся развалины. Степняки с чурчжэнями под одним знаменем, с пороховыми бочками. Один взгляд на их строй — и понимаешь: сдаваться бессмысленно. Они не берут пленных за деньги, они берут всё.%SPEECH_OFF%Он сжимает обрывок в кулаке и уходит к своим телегам. Вина вы так и не попробовали. | [img]gfx/ui/events/event_59.png[/img]Мимо отряда обгоняет королевский гонец — потный, с подрезанной подпругой. Он не останавливается, но успевает крикнуть вам через плечо.%SPEECH_ON%Восточные марки просят помощи! Столица чурчжэней пала, их хан сел на троне завоевателя, и теперь обе орды идут на запад! Города горят, благородные дома поднимают ополчения! Передай всем, кого встретишь!%SPEECH_OFF%Он скрывается в пылевом облаке. Люди переглядываются. %randombrother% сплёвывает.%SPEECH_ON%Значит, всё-таки началось.%SPEECH_OFF%}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Это настораживает...",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}

		});
	}

	function onUpdateScore()
	{
		if (this.World.FactionManager.getGreaterEvilType() == this.Const.World.GreaterEvilType.Horde && this.World.FactionManager.getGreaterEvilPhase() == this.Const.World.GreaterEvilPhase.Warning)
		{
			local playerTile = this.World.State.getPlayer().getTile();

			if (!playerTile.HasRoad)
			{
				return;
			}

			local towns = this.World.EntityManager.getSettlements();

			foreach( t in towns )
			{
				if (t.getTile().getDistanceTo(playerTile) <= 4)
				{
					return;
				}
			}

			this.m.Score = 80;
		}
	}

	function onPrepare()
	{
	}

	function onPrepareVariables( _vars )
	{
	}

	function onClear()
	{
	}

});
