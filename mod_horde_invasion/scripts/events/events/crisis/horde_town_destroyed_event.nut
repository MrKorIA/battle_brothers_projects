// Оповещение об уничтоженном ордой города (кризис «Нашествие Великой Орды»).
// Образец — data_014/scripts/events/events/crisis/greenskins_town_destroyed_event.nut.
// Новость "crisis_horde_town_destroyed" пушится хуком statistics_manager
// (перенаправление ванильного ключа destroy_order на время кризиса Орды).
this.horde_town_destroyed_event <- this.inherit("scripts/events/event", {
	m = {
		News = null
	},
	function create()
	{
		this.m.ID = "event.crisis.horde_town_destroyed";
		this.m.Title = "По дороге...";
		this.m.Cooldown = 7.0 * this.World.getTime().SecondsPerDay;
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			Text = "{[img]gfx/ui/events/event_59.png[/img]На тракте вы встречаете беженцев — повозки, доверху нагружённые скудными пожитками, медленно тащатся на запад. Один из возчиков, завидев ваше знамя, придерживает вожжи и хрипло окликает вас.%SPEECH_ON%Не ходите на восток, воины. Поселения %city% больше нет. Сперва налетели степняки — дома у стен заполыхали ещё до полудня, следом пошла тяжёлая пехота в железных латах, а за ней обоз с пороховыми бочками. К утру от города остались одни дымящиеся угли. Тех, кто кричал со стен, что заплатит любую дань, сколько ни потребуют... Их слушал только пожар.%SPEECH_OFF%Возчик взмахивает поводьями и догоняет свою колонну. Вы смотрите ему вслед и понимаете: тракты теперь будут надолго забиты такими повозками. | [img]gfx/ui/events/event_65.png[/img]У придорожного трактира вы натыкаетесь на королевского гонца. Он сидит прямо на мокром камне, дорожная сумка брошена в грязь, а сам он остекленевшим взглядом смотрит в одну точку. Услышав ваши шаги, гонец поднимает голову и произносит ровным, заученным голосом, словно читает приказ по бумаге.%SPEECH_ON%Да будет известно всем верным подданным: %city% пал. Великая Орда подступила к стенам на рассвете, а к закату в городе уже пылали все кварталы. Гарнизон перебит до последнего человека, пока благородные дома всё ещё спорят, чья была очередь присылать подмогу. Мне велено оповестить всех, кого встречу на пути.%SPEECH_OFF%Он устало кивает, подхватывает сумку и исчезает за поворотом тракта, не проронив больше ни слова. | [img]gfx/ui/events/event_59.png[/img]На перекрёстке дорог замерло несколько телег, доверху набитых тряпьём и скарбом — измождённые беженцы, у которых не осталось сил идти дальше, разбили здесь привал. Седой старик у костра разводит руками перед притихшей толпой.%SPEECH_ON%Я там был, когда всё началось. Не было ни сигнального рога, ни набатного колокола — просто земля под ногами загудела, и с востока выкатилась сплошная стена людей в железе. %city% выгорел дотла за одну ночь, а поутру их сотники объехали окрестные деревни и поставили перед выбором: платите Орде дань или сгорите следом. Половина селений уже собирает откуп. А вы сидите тут и ждёте, пока до вас дойдёт очередь.%SPEECH_OFF%Никто из слушателей не решается возразить. Вы тоже молчите — просто отходите в сторону и смотрите на восток, где небо над горизонтом давно не бывает чистым.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Орда не остановится сама.",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}

		});
	}

	function onUpdateScore()
	{
		if (!this.World.FactionManager.isHordeInvasion())
		{
			return;
		}

		if (!this.World.State.getPlayer().getTile().HasRoad)
		{
			return;
		}

		if (this.World.Statistics.hasNews("crisis_horde_town_destroyed"))
		{
			this.m.Score = 2000;
		}
	}

	function onPrepare()
	{
		this.m.News = this.World.Statistics.popNews("crisis_horde_town_destroyed");
	}

	function onPrepareVariables( _vars )
	{
		_vars.push([
			"city",
			this.m.News.get("City")
		]);
	}

	function onClear()
	{
		this.m.News = null;
	}

});
