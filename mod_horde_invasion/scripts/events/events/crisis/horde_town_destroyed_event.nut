// Оповещение об уничтоженном ордой города (кризис «Нашествие Железной Орды»).
// Образец — data_014/scripts/events/events/crisis/greenskins_town_destroyed_event.nut.
// Новость "crisis_horde_town_destroyed" пушится хуком statistics_manager
// (перенаправление ванильного ключа destroy_order на время кризиса Орды).
this.horde_town_destroyed_event <- this.inherit("scripts/events/event", {
	m = {
		News = null
	},
	function create()
	{
		this.m.ID = "event.crisis.horde_town_destroyed";
		this.m.Title = "По дороге...";
		this.m.Cooldown = 7.0 * this.World.getTime().SecondsPerDay;
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_94.png[/img]{В дороге встречаете цепочку беженцев — повозки, нагружённые пожитками, тащатся на запад. Один из возчиков, увидев ваше знамя, останавливается и говорит, не разводя руками:%SPEECH_ON%Не ходите на восток, воины. %city% больше нет. Сначала пошли их всадники — выжечь приписные деревни, потом тяжёлая пехота в железных латах, а за ней обоз с бочками. К утру от города остались одни угли. Люди кричали, что заплатят дань, сколько скажут, — а им и отвечать-то некому было.%SPEECH_OFF%Возчик взмахивает поводьями и догоняет свою колонну. Вы смотрите вслед и понимаете: запад теперь забит такими повозками. | [img]gfx/ui/events/event_59.png[/img]У придорожного трактира вы находите королевского гонца. Он сидит на мокром камне, дорожная сбруя брошена рядом, а сам он смотрит в одну точку. Услышав ваши шаги, гонец поднимает голову и произносит ровным, выученным голосом, словно зачитывает приказ:%SPEECH_ON%Да будет известно: %city% пал. Железная Орда подошла к стенам на рассвете, а к полуночи в городе уже горели кварталы. Гарнизон сложился целиком, владыки западных марок до сих пор спорят, чья это была очередь защищать. Мне велено оповестить всех, кого встречу.%SPEECH_OFF%Он кланяется, забирает сбрую и исчезает за поворотом, так и не спросив, куда вы идёте. | [img]gfx/ui/events/event_97.png[/img]К вашему привалу подсаживается купец с караваном из трёх телег — две из них пустые. Он предлагает вам вина и, когда вы садитесь, долго крутит в пальцах обгоревший обрывок свитка.%SPEECH_ON%Это расписка за товар. Тридцать мер муки, доставить в %city%. Видите дату? Позавчера. А вчера я нашёл только дымящиеся развалины. Степняки с чурчжэнями под одним знаменем, с пороховыми бочками. Один взгляд на их строй — и понимаешь, что сдаваться бессмысленно: они не берут пленных за деньги, они берут всё.%SPEECH_OFF%Он сжимает обрывок в кулаке и уходит к своим телегам. Вина вы так и не попробовали. | [img]gfx/ui/events/event_76.png[/img]На перекрёстке дорог стоит телега, доверху набитая тряпьём, — обоз беженцев, уставший идти дальше. Старик у костра разводит руками перед собравшимися:%SPEECH_ON%Я там был, когда началось. Не было ни рога, ни колокола — просто земля загудела, и с востока вышла стена людей в железе. %city% сгорел за одну ночь, а поутру их сотники объехали окрестные деревни и выставили счёт: девать некуда — платите Орде или горите следом. Половина селений уже собирает дань. А вы сидите тут и ждёте, пока до вас дойдёт очередь.%SPEECH_OFF%Никто из слушателей не спорит. Вы тоже не спорите — просто отходите в сторону и смотрите на восток, где горизонт давно не чист.}",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Орда не остановится сама.",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}

		});
	}

	function onUpdateScore()
	{
		if (!this.World.FactionManager.isHordeInvasion())
		{
			return;
		}

		if (!this.World.State.getPlayer().getTile().HasRoad)
		{
			return;
		}

		if (this.World.Statistics.hasNews("crisis_horde_town_destroyed"))
		{
			this.m.Score = 2000;
		}
	}

	function onPrepare()
	{
		this.m.News = this.World.Statistics.popNews("crisis_horde_town_destroyed");
	}

	function onPrepareVariables( _vars )
	{
		_vars.push([
			"city",
			this.m.News.get("City")
		]);
	}

	function onClear()
	{
		this.m.News = null;
	}

});
