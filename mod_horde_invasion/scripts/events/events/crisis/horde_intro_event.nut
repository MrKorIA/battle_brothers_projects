// Интро кризиса «Нашествие Великой Орды»: всплывает при старте Live-фазы
// (новость 'crisis_horde_start' добавляет хук faction_manager).
// Смысл: вторжение началось; благородные дома, проглотив междоусобицы, воюют
// за свою независимость, чтобы не пасть под натиском орды. Кто победит —
// непонятно, но крон на этой войне заработать можно много.
this.horde_intro_event <- this.inherit("scripts/events/event", {
	m = {},
	function create()
	{
		this.m.ID = "event.crisis.horde_intro";
		this.m.Title = "На привале...";
		this.m.Cooldown = 1.0 * this.World.getTime().SecondsPerDay;
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_59.png[/img]%randombrother% трясёт вас за плечо, пока вы раскладываете карту у костра.%SPEECH_ON%Командир, с востока люди идут — целой рекой. И у них вести, судя по всему, такие, что мир на них рухнул.%SPEECH_OFF%К лагерю действительно подбирается обоз беженцев — третий за неделю. Старший из них, бывший мастер по поясному делу, греет у вашего огня руки и говорит, глядя на восток, где горизонт уже не бывает чистым.%SPEECH_ON%Всё, наёмник. Пока благородные дома спорили, чья очередь гнить в окопах, хан собрал под одно знамя степь и чурчжэней, сел на трон в их столице и перешёл границу. Теперь дворяне проглотили свои обиды и воюют за независимость — ни один из них не хочет платить дань и становиться марионеткой на верёвочке великого хана. Кто победит — не знает никто, даже их собственные карты не понимают, что творится.%SPEECH_OFF%Он потирает обрубок руки и усмехается хитрецом уставших глаз.%SPEECH_ON%Но одно я понял точно: на этой войне деньги капают рекой — защита, эскорт, головы сотников, рейды по обозам. Так что выбирайте, наёмники: либо прячьтесь на западе, пока граница не пришла к вам сама, либо зарабатывайте, пока порох не взлетел на воздух вместе с крепостью.%SPEECH_OFF%",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Война к хану, а кроны — к нам.",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}

		});
	}

	function onUpdateScore()
	{
		if (this.World.Statistics.hasNews("crisis_horde_start"))
		{
			this.m.Score = 6000;
		}
	}

	function onPrepare()
	{
		this.World.Statistics.popNews("crisis_horde_start");
	}

	function onPrepareVariables( _vars )
	{
	}

	function onClear()
	{
	}

});
