// Интро кризиса «Нашествие Великой Орды»: всплывает при старте Live-фазы
// (новость 'crisis_horde_start' добавляет хук faction_manager).
// Смысл: вторжение началось; благородные дома, проглотив междоусобицы, воюют
// за свою независимость, чтобы не пасть под натиском орды. Кто победит —
// непонятно, но крон на этой войне заработать можно много.
this.horde_intro_event <- this.inherit("scripts/events/event", {
	m = {},
	function create()
	{
		this.m.ID = "event.crisis.horde_intro";
		this.m.Title = "На привале...";
		this.m.Cooldown = 1.0 * this.World.getTime().SecondsPerDay;
		this.m.IsSpecial = true;
		this.m.Screens.push({
			ID = "A",
			Text = "[img]gfx/ui/events/event_59.png[/img]%randombrother% трясёт вас за плечо, пока вы раскладываете походную карту у костра.%SPEECH_ON%Командир, с востока люди идут — целой рекой. И вести у них, судя по лицам, такие, будто сам мир рухнул.%SPEECH_OFF%К вашему лагерю и впрямь тянется обоз беженцев — уже третий за эту неделю. Старший из них, пожилой шорник с пустым, подвязанным рукавом, подошёл к вашему костру и поднял уцелевшую руку в приветствии. Затем хмуро говорит, не отрывая взгляда от востока:%SPEECH_ON%Всё, наёмник, началось. Пока благородные дома грызлись между собой да строили козни друг другу, степной хан собрал под одно знамя Железную Орду и чжурчжэней, сел на трон в чужой столице и перешёл границу. Говорят, у него такая сила, что даже королевские лазутчики со счёту сбились. Теперь-то лорды живо проглотили старые обиды и трясутся за собственные замки — ни один не хочет платить дань и кланяться великому хану. Кто в этой бойне устоит — одному небу известно.%SPEECH_OFF%Старик потирает культю и устало хмыкает.%SPEECH_ON%Я в ратном деле не смыслю, но по дороге мимо гарнизонов такого нагляделся... Городские глашатаи глотки рвут: лорды скупают каждый свободный клинок, платят за охрану обозов, за головы степных сотников, за любую вылазку. Так что вам, вольным людям, нынче приволье — было бы кому за это серебро умирать, пока их чёрный порох не разнёс последнюю крепость.%SPEECH_OFF%",
			Image = "",
			List = [],
			Characters = [],
			Options = [
				{
					Text = "Война хану, а кроны — нам.",
					function getResult( _event )
					{
						return 0;
					}

				}
			],
			function start( _event )
			{
			}

		});
	}

	function onUpdateScore()
	{
		if (this.World.Statistics.hasNews("crisis_horde_start"))
		{
			this.m.Score = 6000;
		}
	}

	function onPrepare()
	{
		this.World.Statistics.popNews("crisis_horde_start");
	}

	function onPrepareVariables( _vars )
	{
	}

	function onClear()
	{
	}

});
